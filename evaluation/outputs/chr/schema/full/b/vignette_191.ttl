@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix chr: <http://example.org/chr#> .
@prefix loinc: <http://loinc.org/rdf#> .
@prefix sct: <http://snomed.info/id/> .

<http://example.org/patient/123> rdf:type chr:Patient .

<http://example.org/encounter/456>
  rdf:type chr:Encounter ;
  chr:patient <http://example.org/patient/123> .

<http://example.org/observation/789>
  rdf:type chr:Observation ;
  chr:encounter <http://example.org/encounter/456> ;
  chr:code sct:27113001 ;
  chr:value "72"^^xsd:integer ;
  chr:unit "kg" .

<http://example.org/observation/790>
  rdf:type chr:Observation ;
  chr:encounter <http://example.org/encounter/456> ;
  chr:code sct:27113001 ;
  chr:value "180"^^xsd:integer ;
  chr:unit "cm" .