@prefix chr:  <https://w3id.org/shexmap/resource/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/patient/123>
    a chr:Patient ;
    chr:age "67"^^xsd:integer ;
    chr:gender chr:Male ;
    chr:hasCondition <http://example.org/condition/456> .

<http://example.org/condition/456>
    a chr:Condition ;
    chr:name "Hypertension" .

chr:Male
    a chr:Gender .