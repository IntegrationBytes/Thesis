@prefix chr: <http://example.org/chr/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

chr:patient1 a chr:Patient ;
    chr:age "65"^^xsd:integer ;
    chr:gender chr:Male ;
    chr:hasFinding chr:finding1 .

chr:finding1 a chr:Finding ;
    chr:bodySite chr:Lung ;
    chr:findingType chr:Mass .