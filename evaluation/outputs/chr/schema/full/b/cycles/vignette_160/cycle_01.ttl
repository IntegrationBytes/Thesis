@prefix chr:  <https://w3id.org/shexmap/resource/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<ex:patient1>
  rdf:type chr:Patient ;
  chr:age "67"^^xsd:integer ;
  chr:gender chr:Male ;
  chr:hasCondition <ex:condition1> .

<ex:condition1>
  rdf:type chr:Disease ;
  chr:name "Hypertension" .