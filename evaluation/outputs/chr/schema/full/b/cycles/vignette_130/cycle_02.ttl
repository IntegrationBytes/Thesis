@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<ex:patient>
  rdf:type chr:Patient ;
  chr:age "67"^^xsd:integer ;
  chr:gender "female" ;
  chr:hasCondition <ex:condition> .

<ex:condition>
  rdf:type chr:Condition ;
  chr:bodySite "chest" ;
  chr:signSymptom "cough" .