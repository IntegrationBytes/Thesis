@prefix chr:  <http://example.org/chr/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

chr:Patient1
    a chr:Patient ;
    chr:age "65"^^xsd:integer ;
    chr:gender chr:Male ;
    chr:hasCondition chr:Condition1 .

chr:Condition1
    a chr:Condition ;
    chr:name "Hypertension" ;
    chr:bodySite "Cardiovascular System" .

chr:Male
    a chr:Gender ;
    rdfs:label "Male" .