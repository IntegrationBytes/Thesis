@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:patient1
  rdf:type chr:Patient .

ex:encounter1
  rdf:type chr:Encounter ;
  chr:patientRole ex:patientRole1 .

ex:patientRole1
  rdf:type chr:PatientRole ;
  chr:rolePlayedBy ex:patient1 ;
  chr:involves ex:encounter1 .