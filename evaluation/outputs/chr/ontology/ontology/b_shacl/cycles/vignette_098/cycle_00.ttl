@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:visit_2019_07_08
  a chr:ClinicalVisit ;
  sulo:atTime ex:time_visit_2019_07_08 ;
  sulo:isIn ex:care_unit_acushnet .

ex:time_visit_2019_07_08
  a sulo:TimeInstant ;
  sulo:hasValue "2019-07-08T15:30:00"^^xsd:dateTime .

ex:care_unit_acushnet
  a chr:CareUnit .

ex:role_VisitProvider_Chavez
  a chr:CareProviderRole ;
  sulo:isFeatureOf ex:doctor_Chavez .

ex:doctor_Chavez
  a chr:Person .

ex:patient_Homenick
  a chr:Person .

ex:role_VisitSubject_Homenick
  a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Homenick .

ex:temp_measurement_process
  a chr:MeasurementProcess ;
  sulo:hasParticipant ex:role_TempSubject_Homenick ;
  sulo:hasOutput ex:temp_measurement ;
  sulo:atTime ex:time_temp_measurement .

ex:role_TempSubject_Homenick
  a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Homenick .

ex:temp_measurement
  a chr:Measurement ;
  sulo:hasValue "37.063"^^xsd:float ;
  sulo:hasPart ex:unit_cel ;
  sulo:atTime ex:time_temp_measurement .

ex:unit_cel
  a sulo:Unit .

ex:time_temp_measurement
  a sulo:TimeInstant ;
  sulo:hasValue "2019-07-08T15:30:00"^^xsd:dateTime .

ex:process_status_completed
  a chr:ProcessStatus .

ex:temp_measurement_process
  sulo:hasFeature ex:process_status_completed .

ex:evaluation_process
  a chr:EvaluationProcess ;
  sulo:hasParticipant ex:role_EvalProvider_Chavez ;
  sulo:hasParticipant ex:role_EvalSubject_Homenick ;
  sulo:hasOutput ex:diagnostic_statement ;
  sulo:atTime ex:time_evaluation .

ex:role_EvalProvider_Chavez
  a chr:PerformerRole ;
  sulo:isFeatureOf ex:doctor_Chavez .

ex:role_EvalSubject_Homenick
  a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Homenick .

ex:diagnostic_statement
  a chr:DiagnosticStatement ;
  sulo:atTime ex:time_evaluation .

ex:time_evaluation
  a sulo:TimeInstant ;
  sulo:hasValue "2019-07-08T15:30:00"^^xsd:dateTime .

ex:acute_viral_pharyngitis
  a chr:ClinicalCondition ;
  sulo:hasFeature ex:severity_moderate .

ex:diagnostic_statement
  sulo:isFeatureOf ex:acute_viral_pharyngitis .

ex:severity_moderate
  a chr:Severity .

ex:care_plan
  a chr:CarePlan ;
  sulo:refersTo ex:follow_up_monitoring ;
  sulo:refersTo ex:routine_review .

ex:follow_up_monitoring
  a chr:MedicalProcedure .

ex:routine_review
  a chr:MedicalProcedure .