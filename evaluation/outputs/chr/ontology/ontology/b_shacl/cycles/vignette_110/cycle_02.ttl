@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:patient1
  rdf:type chr:Patient ;
  chr:hasEncounter ex:encounter1 .

ex:encounter1
  rdf:type chr:Encounter ;
  chr:hasFinding ex:finding1 .

ex:finding1
  rdf:type chr:Finding ;
  chr:findingRole ex:findingRole1 .

ex:findingRole1
  rdf:type chr:FindingRole ;
  chr:roleValue "Hypothyroidism" ;
  chr:involves ex:patient1 .