@prefix chr:  <http://w3id.org/chr#> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <http://w3id.org/sulo#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:patient1 a chr:Patient ;
    chr:hasFinding ex:finding1 .

ex:finding1 a chr:Finding ;
    chr:findingValue "High Blood Pressure" .

ex:role1 a sulo:Role ;
    sulo:source ex:patient1 ;
    sulo:target ex:finding1 ;
    sulo:rolePredicate chr:hasFinding .