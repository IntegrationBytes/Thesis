@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix chr:   <https://w3id.org/shexmap/resource/ontology-schema/d285f599-3479-42f1-9623-3a69c7199c9c#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix :      <ex:> .

:patient1  a  chr:Patient .

:finding1  a  chr:Finding ;
    chr:findingValue  "high blood pressure" .

:role1 a chr:FindingRole ;
    chr:entity :patient1 ;
    chr:finding :finding1 .