@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix chr:   <https://w3id.org/shexmap/resource/ontology-schema/d285f599-1999-4999-9999-ca7c7c7c7c7c#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix :      <ex:> .

:patient1  a  chr:Patient .

:finding1  a  chr:Finding ;
    rdfs:label  "high blood pressure" .

:role1  a  chr:FindingRole ;
    chr:roleOf  :patient1 ;
    chr:hasFinding  :finding1 .