@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Aracely_Devon_Collins a chr:Person ;
    rdfs:label "Aracely711 Devon268 Collins926" .

ex:physician_Edmundo_Eichmann a chr:Person ;
    rdfs:label "Dr. Edmundo94 Eichmann909" .

# Care unit
ex:careunit_FATHER_BILL a chr:CareUnit ;
    rdfs:label "FATHER BILL'S PLACE" .

# Clinical visit
ex:visit_2016_06_03T15_04_38 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ,
                       ex:role_CareProvider_Visit ;
    sulo:isIn ex:careunit_FATHER_BILL ;
    sulo:atTime ex:time_visit_2016_06_03T15_04_38 .

ex:time_visit_2016_06_03T15_04_38 a sulo:TimeInstant ;
    sulo:hasValue "2016-06-03T15:04:38+02:00"^^xsd:dateTime .

# Roles for the visit (reused for all processes)
ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Edmundo_Eichmann .

# Process status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_percent      a chr:Unit ; rdfs:label "%" .
ex:unit_cm           a chr:Unit ; rdfs:label "cm" .
ex:unit_kg           a chr:Unit ; rdfs:label "kg" .
ex:unit_kg_per_m2    a chr:Unit ; rdfs:label "kg/m2" .
ex:unit_per_min      a chr:Unit ; rdfs:label "/min" .
ex:unit_mg_per_dL    a chr:Unit ; rdfs:label "mg/dL" .
ex:unit_mmol_per_L   a chr:Unit ; rdfs:label "mmol/L" .
ex:unit_score        a chr:Unit ; rdfs:label "score" .

# Helper time instants
ex:time_2016_06_03T15_04_38 a sulo:TimeInstant ;
    sulo:hasValue "2016-06-03T15:04:38+02:00"^^xsd:dateTime .

ex:time_2016_06_03T16_17_41 a sulo:TimeInstant ;
    sulo:hasValue "2016-06-03T16:17:41+02:00"^^xsd:dateTime .

ex:time_2016_06_03T16_59_04 a sulo:TimeInstant ;
    sulo:hasValue "2016-06-03T16:59:04+02:00"^^xsd:dateTime .

ex:time_2016_06_03T15_52_02 a sulo:TimeInstant ;
    sulo:hasValue "2016-06-03T15:52:02+02:00"^^xsd:dateTime .

