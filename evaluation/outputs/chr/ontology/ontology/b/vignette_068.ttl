@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Dolores_Nevarez a chr:Person ;
    rdfs:label "Dolores502 Marisol435 Nevárez403" .

ex:person_Cari_Kohler a chr:Person ;
    rdfs:label "Dr. Cari853 Kohler843" .

# Care unit
ex:careunit_DR_HES a chr:CareUnit ;
    rdfs:label "DR. HE'S PRIMARY CARE FOR ADULTS INC" .

# Clinical visit
ex:visit_2019_10_22 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_Visit .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Cari_Kohler .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:29+02:00"^^xsd:dateTime .

# Status (used for all processes)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Height measurement
ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Height ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:atTime ex:time_Height ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Height .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "125.8"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_Height .

ex:time_Height a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:29+02:00"^^xsd:dateTime .

ex:unit_cm a chr:Unit ;
    rdfs:label "cm" .

