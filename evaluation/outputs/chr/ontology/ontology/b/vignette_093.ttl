# Evaluation (diagnostic statement)
ex:diag_MedicationReview a chr:DiagnosticStatement .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie315_Tasha327_Grant908 .

ex:role_EvalPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Teresa94_Tapia475 .

ex:evaluation_2025_05_07 a chr:EvaluationProcess ;
