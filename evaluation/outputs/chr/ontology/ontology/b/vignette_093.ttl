    sulo:atTime ex:time_visit .

ex:measurement_WeightForLength a chr:Measurement ;
    sulo:hasValue "91.972"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit .

