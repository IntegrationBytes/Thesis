@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Hallie315_Tasha327_Grant908 a chr:Person .
ex:person_Teresa94_Tapia475 a chr:Person .

# Care unit
ex:careunit_CARING_HEALTH_CENTER_INC a chr:CareUnit .

# Clinical visit
ex:visit_2025_05_07_T16_30_02 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient ;
    sulo:hasParticipant ex:role_VisitProvider ;
    sulo:isIn ex:careunit_CARING_HEALTH_CENTER_INC ;
    sulo:atTime ex:time_visit .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie315_Tasha327_Grant908 .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Teresa94_Tapia475 .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2025-05-07T16:30:02+02:00"^^xsd:dateTime .

# Common status
ex:status_completed a chr:ProcessStatus .

# Common patient role for measurements
ex:role_MeasPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie315_Tasha327_Grant908 .

# Units
ex:unit_cm          a chr:Unit .
ex:unit_kg          a chr:Unit .
ex:unit_percent     a chr:Unit .
ex:unit_score       a chr:Unit .
ex:unit_kg_per_m2   a chr:Unit .
ex:unit_per_min     a chr:Unit .

# Height
ex:process_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPatient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "101.0"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit .

# Pain severity
ex:process_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPatient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

ex:severity_pain a chr:Severity .

ex:measurement_PainSeverity a chr:Measurement ;
    sulo:hasValue "1.0"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:hasFeature ex:severity_pain ;
    sulo:atTime ex:time_visit .

# Weight
ex:process_Weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPatient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

ex:measurement_Weight a chr:Measurement ;
    sulo:hasValue "16.9"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_visit .

