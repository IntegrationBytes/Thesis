    rdfs:label "completed" .

# Clinical visit
ex:visit_2002-03-11T20_35_54_01_00 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2002-03-11T20_35_54_01_00 ;
    sulo:isIn ex:careunit_ZION ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Estela ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Ivonne .

