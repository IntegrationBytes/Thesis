# Persons
ex:patient_Delma583_Adriane398_Huel628 a chr:Person .
ex:physician_Drew592_Simonis280 a chr:Person .

# Care unit
ex:careunit_HARBOR_HEALTH_SERVICES_INC a chr:CareUnit .

# Time instant (shared)
<http://example.org/clinical/time/2020-01-23T07:12:57+01:00> sulo:hasValue "2020-01-23T07:12:57+01:00"^^xsd:dateTime .

# Roles
ex:role_SubjectOfCare_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma583_Adriane398_Huel628 .

ex:role_CareProvider_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Drew592_Simonis280 .

ex:role_Performer_Physician a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Drew592_Simonis280 .

# Clinical visit
<http://example.org/clinical/visit_2020-01-23T07:12:57+01:00> a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Patient ,
                       ex:role_CareProvider_Physician ;
    sulo:isIn ex:careunit_HARBOR_HEALTH_SERVICES_INC ;
    sulo:atTime <http://example.org/clinical/time/2020-01-23T07:12:57+01:00> .

# Units
ex:unit_cm a chr:Unit .
ex:unit_kg a chr:Unit .
ex:unit_percent a chr:Unit .
ex:unit_per_min a chr:Unit .
ex:unit_score a chr:Unit .

# Process status
ex:status_completed a chr:ProcessStatus .

# Severity (pain)
ex:severity_1 a chr:Severity .

# Height measurement
ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "58.6"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime <http://example.org/clinical/time/2020-01-23T07:12:57+01:00> .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Height .

ex:process_Measurement_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Patient ,
                       ex:role_Performer_Physician ,
                       ex:role_Output_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime <http://example.org/clinical/time/2020-01-23T07:12:57+01:00> .

# Pain severity measurement
ex:measurement_PainSeverity a chr:Measurement ;
