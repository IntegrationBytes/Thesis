@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Dolores_Nevarez a chr:Person .
ex:person_Cari_Kohler   a chr:Person .

# Care unit
ex:careunit_DRHEsPrimaryCare a chr:CareUnit .

# Clinical visit
ex:visit_2018_10_16 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_visit_patient , ex:role_visit_provider ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_DRHEsPrimaryCare .

ex:role_visit_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_visit_provider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Cari_Kohler .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# Units
ex:unit_cm          a chr:Unit .
ex:unit_kg          a chr:Unit .
ex:unit_kg_per_m2   a chr:Unit .
ex:unit_percent     a chr:Unit .
ex:unit_per_min     a chr:Unit .

# Process status (completed)
ex:status_completed a chr:ProcessStatus .

# Height measurement
ex:proc_height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_height_patient , ex:role_height_output ;
    sulo:atTime ex:time_height ;
    sulo:hasFeature ex:status_completed .

ex:role_height_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_height_output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_height .

ex:measurement_height a chr:Measurement ;
    sulo:hasValue "118.7"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_height .

ex:time_height a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# Weight measurement
ex:proc_weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_weight_patient , ex:role_weight_output ;
    sulo:atTime ex:time_weight ;
    sulo:hasFeature ex:status_completed .

ex:role_weight_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_weight_output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_weight .

ex:measurement_weight a chr:Measurement ;
    sulo:hasValue "26.1"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_weight .

ex:time_weight a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# BMI ratio measurement
ex:proc_bmi_ratio a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_bmi_ratio_patient , ex:role_bmi_ratio_output ;
    sulo:atTime ex:time_bmi_ratio ;
    sulo:hasFeature ex:status_completed .

ex:role_bmi_ratio_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_bmi_ratio_output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bmi_ratio .

ex:measurement_bmi_ratio a chr:Measurement ;
    sulo:hasValue "18.51"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_bmi_ratio .

ex:time_bmi_ratio a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# BMI percentile measurement
ex:proc_bmi_percentile a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_bmi_percentile_patient , ex:role_bmi_percentile_output ;
    sulo:atTime ex:time_bmi_percentile ;
    sulo:hasFeature ex:status_completed .

ex:role_bmi_percentile_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_bmi_percentile_output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bmi_percentile .

ex:measurement_bmi_percentile a chr:Measurement ;
    sulo:hasValue "94.132"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_bmi_percentile .

ex:time_bmi_percentile a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# Heart rate measurement
ex:proc_heart_rate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_hr_patient , ex:role_hr_output ;
    sulo:atTime ex:time_heart_rate ;
    sulo:hasFeature ex:status_completed .

ex:role_hr_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_hr_output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_heart_rate .

ex:measurement_heart_rate a chr:Measurement ;
    sulo:hasValue "80"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_heart_rate .

ex:time_heart_rate a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# Respiratory rate measurement
ex:proc_respiratory_rate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_rr_patient , ex:role_rr_output ;
    sulo:atTime ex:time_respiratory_rate ;
    sulo:hasFeature ex:status_completed .

ex:role_rr_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_rr_output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_respiratory_rate .

ex:measurement_respiratory_rate a chr:Measurement ;
    sulo:hasValue "15"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_respiratory_rate .

ex:time_respiratory_rate a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# Pain severity measurement
ex:severity_pain a chr:Severity .

ex:proc_pain_severity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_pain_patient , ex:role_pain_output ;
    sulo:atTime ex:time_pain ;
    sulo:hasFeature ex:status_completed , ex:severity_pain .

ex:role_pain_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_pain_output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_pain .

ex:measurement_pain a chr:Measurement ;
    sulo:hasValue "2"^^xsd:float ;
    sulo:atTime ex:time_pain .

ex:time_pain a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# Evaluation process producing diagnostic statement
ex:evaluation_2018_10_16 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_eval_patient , ex:role_eval_provider , ex:role_eval_output ;
    sulo:atTime ex:time_evaluation .

ex:role_eval_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_eval_provider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Cari_Kohler .

ex:role_eval_output a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_med_review .

ex:diag_med_review a chr:DiagnosticStatement .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:29+02:00"^^xsd:dateTime .

# Care plan referencing a medical procedure
ex:procedure_followup a chr:MedicalProcedure .

ex:careplan_2018_10_16 a chr:Process ;
    sulo:hasParticipant ex:role_cp_patient , ex:role_cp_procedure .

ex:role_cp_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_cp_procedure a chr:ReferenceRole ;
    sulo:isFeatureOf ex:procedure_followup .