@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Harvey a chr:Person .
ex:physician_Victor a chr:Person .

# Care unit
ex:careunit_4499 a chr:CareUnit .

# Clinical visit
ex:visit_2019_04_25 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_4499 .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-04-25T21:11:55+02:00"^^xsd:dateTime .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Victor .

# Measurement 1 – Polyp size
ex:measurement1 a chr:Measurement ;
    sulo:hasValue "5.8247"^^xsd:float ;
    sulo:hasPart ex:unit_mm ;
    sulo:atTime ex:time_measure1 .

ex:unit_mm a sulo:Unit ;
    rdfs:label "mm" .

ex:time_measure1 a sulo:TimeInstant ;
    sulo:hasValue "2019-04-25T21:49:47+02:00"^^xsd:dateTime .

ex:measurementProcess1 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Meas1Patient , ex:role_Meas1Output ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure1 .

ex:role_Meas1Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_Meas1Output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement1 .

# Measurement 2 – Hemoglobin in stool
ex:measurement2 a chr:Measurement ;
    sulo:hasValue "20.354"^^xsd:float ;
    sulo:hasPart ex:unit_ng_per_ml ;
    sulo:atTime ex:time_measure2 .

ex:unit_ng_per_ml a sulo:Unit ;
    rdfs:label "ng/mL" .

ex:time_measure2 a sulo:TimeInstant ;
    sulo:hasValue "2019-04-25T21:49:47+02:00"^^xsd:dateTime .

ex:measurementProcess2 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Meas2Patient , ex:role_Meas2Output ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure2 .

ex:role_Meas2Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_Meas2Output a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement2 .

# Process status (completed)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Evaluation (diagnostic) process
ex:evaluation1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient , ex:role_EvalProvider , ex:role_EvalOutput ;
    sulo:atTime ex:time_eval .

ex:time_eval a sulo:TimeInstant ;
    sulo:hasValue "2019-04-25T21:49:47+02:00"^^xsd:dateTime .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_EvalProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Victor .

ex:diagnostic1 a chr:DiagnosticStatement .

ex:role_EvalOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic1 .

# Care plan
ex:careplan1 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure .