@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Daren950 a chr:Person .
ex:physician_Ping698 a chr:Person .

# Care unit
ex:careUnit_CHI a chr:CareUnit .

# Clinical visit
ex:visit_2019_09_21 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_visit ;
    sulo:hasParticipant ex:role_CareProvider_visit ;
    sulo:isIn ex:careUnit_CHI ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Daren950 .

ex:role_CareProvider_visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Ping698 .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-09-21T10:01:15+02:00"^^xsd:dateTime .

# Units
ex:unit_cm          a chr:Unit .
ex:unit_kg          a chr:Unit .
ex:unit_kg_per_m2   a chr:Unit .
ex:unit_percent     a chr:Unit .
ex:unit_per_min     a chr:Unit .
ex:unit_score       a chr:Unit .

# Process status
ex:status_completed a chr:ProcessStatus .

# Body Height measurement
ex:measurement_bodyHeight a chr:Measurement ;
    sulo:hasValue "171.1"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_bodyHeight .

ex:time_bodyHeight a sulo:TimeInstant ;
    sulo:hasValue "2019-09-21T10:01:15+02:00"^^xsd:dateTime .

ex:role_SubjectOfCare_bodyHeight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Daren950 .

ex:role_Output_bodyHeight a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bodyHeight .

ex:proc_bodyHeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_bodyHeight ;
    sulo:hasParticipant ex:role_Output_bodyHeight ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_bodyHeight .

