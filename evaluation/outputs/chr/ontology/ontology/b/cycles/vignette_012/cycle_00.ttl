# Persons
ex:patient_Arturo a chr:Person .
ex:provider_Alan a chr:Person .

# Care unit
ex:careunit_primary_care_north_pc a chr:CareUnit .

# Clinical visit
ex:visit_20180430T023422 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_visit_subject , ex:role_visit_provider ;
    sulo:isIn ex:careunit_primary_care_north_pc ;
    sulo:atTime ex:time_visit .

ex:role_visit_subject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Arturo .

ex:role_visit_provider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Alan .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2018-04-30T02:34:22+02:00"^^xsd:dateTime .

# Units
ex:unit_percent a chr:Unit .
ex:unit_cm a chr:Unit .
ex:unit_kg a chr:Unit .
ex:unit_kg_per_m2 a chr:Unit .
ex:unit_per_min a chr:Unit .
ex:unit_mmol_per_L a chr:Unit .
ex:unit_mg_per_dL a chr:Unit .
ex:unit_score a chr:Unit .

# Process status
ex:status_completed a chr:ProcessStatus .

