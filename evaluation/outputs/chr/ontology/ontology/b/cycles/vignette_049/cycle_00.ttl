@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Daren950 a chr:Person .
ex:person_Ping698 a chr:Person .

# Care unit
ex:careUnit_CHP a chr:CareUnit .

# Clinical visit
ex:visit_2018_09_15 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2018-09-15T10:01:15+02:00"^^xsd:dateTime .

# Common status feature
ex:status_completed a chr:ProcessStatus .

# Common time instant for measurements
ex:time_measure_2018_09_15 a sulo:TimeInstant ;
    sulo:hasValue "2018-09-15T10:01:15+02:00"^^xsd:dateTime .

# Height measurement
ex:measurementProcess_height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_HeightSubject , ex:role_HeightPerformer , ex:role_HeightOutput ;
    sulo:atTime ex:time_measure_2018_09_15 ;
    sulo:hasFeature ex:status_completed .

ex:role_HeightSubject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Daren950 .

ex:role_HeightPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Ping698 .

ex:measurement_height a chr:Measurement ;
    sulo:hasValue "165.3"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_measure_2018_09_15 .

ex:unit_cm a sulo:Unit .

ex:role_HeightOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_height .

# Pain severity measurement
ex:measurementProcess_pain a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_PainSubject , ex:role_PainPerformer , ex:role_PainOutput ;
    sulo:atTime ex:time_measure_2018_09_15 ;
    sulo:hasFeature ex:status_completed .

ex:role_PainSubject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Daren950 .

ex:role_PainPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Ping698 .

ex:measurement_pain a chr:Measurement ;
    sulo:hasValue "2"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_measure_2018_09_15 .

ex:unit_score a sulo:Unit .

ex:role_PainOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_pain .

# Weight measurement
ex:measurementProcess_weight a chr:MeasurementProcess ;
