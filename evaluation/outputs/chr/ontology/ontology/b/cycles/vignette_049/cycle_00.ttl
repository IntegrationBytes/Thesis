# Evaluation (diagnostic) process
ex:evaluation_2018_09_15 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalSubject , ex:role_EvalPerformer , ex:role_DiagnosticOutput ;
    sulo:atTime ex:time_evaluation .

ex:role_EvalSubject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Daren950 .

ex:role_EvalPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Ping698 .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2018-09-15T10:42:47+02:00"^^xsd:dateTime .

ex:diagnostic_gingivitis a chr:DiagnosticStatement .
ex:role_DiagnosticOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_gingivitis .

# Care plan
ex:carePlan_2018_09_15 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure .