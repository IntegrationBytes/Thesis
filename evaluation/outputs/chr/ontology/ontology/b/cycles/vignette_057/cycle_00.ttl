# Persons
ex:patient_Delma583_Adriane398_Huel628 a chr:Person .
ex:physician_Drew592_Simonis280 a chr:Person .

# Care unit
ex:careunit_HARBOR_HEALTH_SERVICES_INC a chr:CareUnit .

# Roles
ex:role_SubjectOfCare_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma583_Adriane398_Huel628 .

ex:role_CareProvider_VisitPhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Drew592_Simonis280 .

# Time instant (shared)
ex:time_2019_10_17_T08_12_57 a sulo:TimeInstant ;
    sulo:hasValue "2019-10-17T08:12:57+02:00"^^xsd:dateTime .

# Clinical visit
ex:visit_2019_10_17_T08_12_57 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_VisitPatient , ex:role_CareProvider_VisitPhysician ;
    sulo:atTime ex:time_2019_10_17_T08_12_57 ;
    sulo:isIn ex:careunit_HARBOR_HEALTH_SERVICES_INC .

# Process status (completed)
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_cm          a chr:Unit .
ex:unit_kg          a chr:Unit .
