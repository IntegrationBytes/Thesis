@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:patient_Estela a chr:Person .
ex:physician_Nickolas a chr:Person .
ex:careunit_ENCOMPASS a chr:CareUnit .

ex:visit_2000_02_13 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_VisitPatient ,
                       ex:role_CareProvider_VisitPhysician ;
    sulo:atTime ex:time_Visit ;
    sulo:isIn ex:careunit_ENCOMPASS .

ex:role_SubjectOfCare_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Estela .

ex:role_CareProvider_VisitPhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Nickolas .

ex:time_Visit sulo:hasValue "2000-02-13T11:35:54+01:00"^^xsd:dateTime .

ex:measurement_body_temp a chr:Measurement ;
    sulo:hasValue "37.436"^^xsd:float ;
    sulo:hasPart ex:unit_celsius ;
    sulo:atTime ex:time_Measure .

ex:unit_celsius a chr:Unit .

ex:measurementProcess_2000_02_13 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_MeasurePatient ,
                       ex:role_Output_Measure ;
    sulo:atTime ex:time_Measure ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_MeasurePatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Estela .

ex:role_Output_Measure a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_body_temp .

ex:time_Measure sulo:hasValue "2000-02-13T11:35:54+01:00"^^xsd:dateTime .

ex:status_completed a chr:ProcessStatus .

ex:evaluation_2000_02_13 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_EvalPatient ,
                       ex:role_Performer_EvalPhysician ,
                       ex:role_Output_EvalDiagnostic ;
    sulo:atTime ex:time_Eval .

ex:role_SubjectOfCare_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Estela .

ex:role_Performer_EvalPhysician a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Nickolas .

ex:role_Output_EvalDiagnostic a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_viral_pharyngitis .

ex:time_Eval sulo:hasValue "2000-02-13T11:35:54+01:00"^^xsd:dateTime .

ex:diag_viral_pharyngitis a chr:DiagnosticStatement .
ex:condition_viral_pharyngitis a chr:ClinicalCondition .

ex:careplan_2000_02_13 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure .