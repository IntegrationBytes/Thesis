# Persons
ex:patient_Aracely_Devon_Collins a chr:Person .
ex:physician_Edmundo_Eichmann a chr:Person .

# Care unit
ex:careunit_FATHER_BILL_PLACE a chr:CareUnit .

# Time instant for the main visit (used for many processes)
ex:time_visit_2021_07_02_15_04_38 a sulo:TimeInstant ;
    sulo:hasValue "2021-07-02T15:04:38+02:00"^^xsd:dateTime .

# Roles for the visit
ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Edmundo_Eichmann .

# Clinical visit
ex:visit_2021_07_02_15_04_38 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_FATHER_BILL_PLACE ;
    sulo:atTime ex:time_visit_2021_07_02_15_04_38 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit .

# Process status (same for all completed processes)
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_mg_per_dL          a chr:Unit .
ex:unit_mmol_per_L        a chr:Unit .
ex:unit_mL_per_min_per_1_73_m2 a chr:Unit .
ex:unit_cm                a chr:Unit .
ex:unit_score             a chr:Unit .
ex:unit_kg                a chr:Unit .
ex:unit_kg_per_m2         a chr:Unit .
ex:unit_per_min           a chr:Unit .

# -----------------------------------------------------------------
# Helper macro (not real Turtle, just for readability)
# -----------------------------------------------------------------
# For each measurement we create:
#   - a Measurement individual with value and unit
#   - an OutputRole linking the Measurement
#   - a MeasurementProcess linking subject, provider and output role,
#     with the same time instant and status.
# -----------------------------------------------------------------

