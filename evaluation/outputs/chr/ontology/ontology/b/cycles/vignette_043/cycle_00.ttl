@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Cory_Heller a chr:Person ;
    rdfs:label "Cory Frank Heller" .

ex:person_Hank_Schneider a chr:Person ;
    rdfs:label "Dr. Hank Schneider" .

# Care unit
ex:careunit_LOWELL a chr:CareUnit ;
    rdfs:label "LOWELL FAMILY MEDICAL CARE PC" .

# Roles (reused across processes)
ex:role_SubjectOfCare_Cory a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Heller .

ex:role_CareProvider_Hank a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Hank_Schneider .

# Process status (completed)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_percent        a chr:Unit ; rdfs:label "%" .
ex:unit_cm             a chr:Unit ; rdfs:label "cm" .
ex:unit_score          a chr:Unit ; rdfs:label "score" .
ex:unit_kg             a chr:Unit ; rdfs:label "kg" .
ex:unit_kg_per_m2      a chr:Unit ; rdfs:label "kg/m2" .
ex:unit_per_min        a chr:Unit ; rdfs:label "/min" .
ex:unit_10_3_per_uL    a chr:Unit ; rdfs:label "10^3/uL" .
ex:unit_10_6_per_uL    a chr:Unit ; rdfs:label "10^6/uL" .
ex:unit_g_per_dL       a chr:Unit ; rdfs:label "g/dL" .
ex:unit_fL             a chr:Unit ; rdfs:label "fL" .
ex:unit_pg             a chr:Unit ; rdfs:label "pg" .

# Time instants
ex:time_2020_04_26T114405 a sulo:TimeInstant ;
    sulo:hasValue "2020-04-26T11:44:05+02:00"^^xsd:dateTime .

ex:time_2020_04_26T125939 a sulo:TimeInstant ;
    sulo:hasValue "2020-04-26T12:29:39+02:00"^^xsd:dateTime .

ex:time_2020_04_26T125254 a sulo:TimeInstant ;
    sulo:hasValue "2020-04-26T12:52:54+02:00"^^xsd:dateTime .

ex:time_2020_04_26T133115 a sulo:TimeInstant ;
    sulo:hasValue "2020-04-26T13:31:15+02:00"^^xsd:dateTime .

ex:time_2020_04_26T140543 a sulo:TimeInstant ;
    sulo:hasValue "2020-04-26T14:05:43+02:00"^^xsd:dateTime .

# Clinical visit
ex:visit_2020_04_26 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Cory , ex:role_CareProvider_Hank ;
    sulo:atTime ex:time_2020_04_26T114405 ;
    sulo:isIn ex:careunit_LOWELL .

# Medical procedure (encounter type)
ex:procedure_general_examination a chr:MedicalProcedure ;
    rdfs:label "General examination of patient" .

# Care plan
ex:careplan_2020_04_26 a chr:CarePlan ;
    sulo:refersTo ex:procedure_general_examination .

