@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Estela_Grant a chr:Person .
ex:person_Nickolas_Schumm a chr:Person .

# Care unit
ex:careunit_ENCOMPASS_HEALTH_BRAINTREE a chr:CareUnit .

# Clinical visit
ex:visit_2007_05_07T03_35_54 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_ENCOMPASS_HEALTH_BRAINTREE ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2007-05-07T03:35:54+02:00"^^xsd:dateTime .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

# Measurement process and result
ex:measurementProcess_2007_05_07T03_35_54 a chr:MeasurementProcess ;
    sulo:atTime ex:time_measurement ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasParticipant ex:role_MeasurementPatient , ex:role_MeasurementOutput .

ex:time_measurement a sulo:TimeInstant ;
    sulo:hasValue "2007-05-07T03:35:54+02:00"^^xsd:dateTime .

ex:status_completed a chr:ProcessStatus .

ex:role_MeasurementPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_MeasurementOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_38_234 .

ex:measurement_38_234 a chr:Measurement ;
    sulo:hasValue "38.234"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_measurement .

ex:unit_Celsius a chr:Unit .

# Evaluation process and diagnostic statement
ex:evaluationProcess_2007_05_07T03_35_54 a chr:EvaluationProcess ;
    sulo:atTime ex:time_evaluation ;
    sulo:hasParticipant ex:role_EvalPerformer , ex:role_EvalPatient , ex:role_EvalOutput .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2007-05-07T03:35:54+02:00"^^xsd:dateTime .

ex:role_EvalPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_EvalOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_StrepSoreThroat .

ex:diagnostic_StrepSoreThroat a chr:DiagnosticStatement ;
    rdfs:label "Streptococcal sore throat" .

# Care plan and referenced procedure
ex:carePlan_2007_05_07 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "Follow-up monitoring and routine review" .