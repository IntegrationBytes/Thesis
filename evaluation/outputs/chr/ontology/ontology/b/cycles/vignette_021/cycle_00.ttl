@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Arturo a chr:Person ;
    rdfs:label "Arturo47 Lauren941 Heidenreich818" .

ex:physician_Alan a chr:Person ;
    rdfs:label "Dr. Alan320 Keeling57" .

# Care unit
ex:careunit_primary a chr:CareUnit ;
    rdfs:label "PRIMARY CARE NORTH PC" .

# Clinical visit
ex:visit_2025-06-09T02:34:22+02:00 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_primary ;
    sulo:hasParticipant ex:role_subject_visit ;
    sulo:hasParticipant ex:role_provider_visit ;
    sulo:atTime ex:time_2025-06-09T02:34:22+02:00 .

ex:role_subject_visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Arturo .

ex:role_provider_visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Alan .

# Status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# TimeInstants
ex:time_2025-06-09T02:34:22+02:00 a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T02:34:22+02:00"^^xsd:dateTime .

ex:time_2025-06-09T03:51:18+02:00 a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T03:51:18+02:00"^^xsd:dateTime .

ex:time_2025-06-09T04:08:22+02:00 a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T04:08:22+02:00"^^xsd:dateTime .

ex:time_2025-06-09T04:43:28+02:00 a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T04:43:28+02:00"^^xsd:dateTime .

# Units
ex:unit_percent a chr:Unit ; rdfs:label "%" .
ex:unit_cm a chr:Unit ; rdfs:label "cm" .
ex:unit_kg a chr:Unit ; rdfs:label "kg" .
ex:unit_kg_per_m2 a chr:Unit ; rdfs:label "kg/m2" .
ex:unit_per_min a chr:Unit ; rdfs:label "/min" .
ex:unit_mg_per_dL a chr:Unit ; rdfs:label "mg/dL" .
ex:unit_mmol_per_L a chr:Unit ; rdfs:label "mmol/L" .
ex:unit_fL a chr:Unit ; rdfs:label "fL" .
ex:unit_pg a chr:Unit ; rdfs:label "pg" .
ex:unit_g_per_dL a chr:Unit ; rdfs:label "g/dL" .
ex:unit_10pow3_per_uL a chr:Unit ; rdfs:label "10*3/uL" .
ex:unit_10pow6_per_uL a chr:Unit ; rdfs:label "10*6/uL" .
ex:unit_mL_per_min_per_m2 a chr:Unit ; rdfs:label "mL/min/{1.73_m2}" .
ex:unit_score a chr:Unit ; rdfs:label "score" .
ex:unit_number a chr:Unit ; rdfs:label "#" .

# Measurement processes and measurements (selected examples; the pattern repeats for each item)

## Hemoglobin A1c
ex:proc_measure_HbA1c a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_HbA1c ;
    sulo:hasParticipant ex:role_provider_HbA1c ;
    sulo:hasParticipant ex:role_output_HbA1c ;
    sulo:atTime ex:time_2025-06-09T02:34:22+02:00 ;
    sulo:hasFeature ex:status_completed .

ex:role_subject_HbA1c a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Arturo .

ex:role_provider_HbA1c a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Alan .

ex:role_output_HbA1c a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_HbA1c .

ex:meas_HbA1c a chr:Measurement ;
    sulo:hasValue "6.87"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_2025-06-09T02:34:22+02:00 .

