# Persons
ex:patient_Estela_Grant a chr:Person .
ex:physician_Ivonne_Turcotte a chr:Person .

# Care unit
ex:careunit_ZION a chr:CareUnit .

# Roles linking persons
ex:role_Subject_Estela a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Estela_Grant .

ex:role_Provider_Ivonne a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Ivonne_Turcotte .

# Time instants
ex:time_2007_01_01T20_35_54 a sulo:TimeInstant ;
    sulo:hasValue "2007-01-01T20:35:54+01:00"^^xsd:dateTime .

ex:time_2007_01_01T21_45_48 a sulo:TimeInstant ;
    sulo:hasValue "2007-01-01T21:45:48+01:00"^^xsd:dateTime .

ex:time_2007_01_01T22_23_14 a sulo:TimeInstant ;
    sulo:hasValue "2007-01-01T22:23:14+01:00"^^xsd:dateTime .

# Process status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_percent        a chr:Unit .
ex:unit_cm            a chr:Unit .
ex:unit_score         a chr:Unit .
ex:unit_kg            a chr:Unit .
ex:unit_kg_per_m2     a chr:Unit .
ex:unit_per_min       a chr:Unit .
ex:unit_mg_per_dL     a chr:Unit .
ex:unit_mmol_per_L    a chr:Unit .

# Clinical visit (entity)
ex:visit_2007_01_01T20_35_54 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Estela ;
    sulo:hasParticipant ex:role_Provider_Ivonne ;
    sulo:isIn ex:careunit_ZION ;
    sulo:atTime ex:time_2007_01_01T20_35_54 .

