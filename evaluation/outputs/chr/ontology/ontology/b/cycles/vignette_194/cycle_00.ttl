@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Grimes a chr:Person ;
    rdfs:label "Bryant814 Clarence5 Grimes165" .

ex:physician_Wilkinson a chr:Person ;
    rdfs:label "Dr. Dana512 Wilkinson796" .

# Care unit
ex:careunit_UrgentCare a chr:CareUnit ;
    rdfs:label "URGENT CARE PHYSICIANS PC" .

# Roles
ex:role_SubjectOfCare_Grimes a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Grimes .

ex:role_CareProvider_Wilkinson a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Wilkinson .

# Time instant (used for all processes)
ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2014-02-26T15:47:23+01:00"^^xsd:dateTime .

# Process status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_mg_per_dL a sulo:Unit ;
    rdfs:label "mg/dL" .

ex:unit_mmol_per_L a sulo:Unit ;
    rdfs:label "mmol/L" .

ex:unit_mL_per_min_per_1_73_m2 a sulo:Unit ;
    rdfs:label "mL/min/1.73 m2" .

ex:unit_nominal a sulo:Unit ;
    rdfs:label "nominal" .

ex:unit_pH a sulo:Unit ;
    rdfs:label "pH" .

ex:unit_percent a sulo:Unit ;
    rdfs:label "%" .

# Clinical visit
ex:visit_2014_02_26T15_47_23 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Grimes ;
    sulo:hasParticipant ex:role_CareProvider_Wilkinson ;
    sulo:atTime ex:time_visit .

