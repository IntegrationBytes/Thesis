@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Angelic_Callie_Schaden a chr:Person ;
    rdfs:label "Angelic427 Callie226 Schaden604" .

ex:person_Willian_Batz a chr:Person ;
    rdfs:label "Dr. Willian804 Batz141" .

# Care unit
ex:careUnit_BostonMedicalCenter a chr:CareUnit ;
    rdfs:label "BOSTON MEDICAL CENTER CORPORATION-" .

# Clinical visit
ex:visit_2016_12_13T23_01_53 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider ;
    sulo:atTime ex:time_Visit ;
    sulo:isIn ex:careUnit_BostonMedicalCenter .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angelic_Callie_Schaden .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Willian_Batz .

ex:time_Visit sulo:hasValue "2016-12-13T23:01:53+01:00"^^xsd:dateTime .

# Pain severity measurement process
ex:measurementProcess_2016_12_13T23_46_57 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasurementSubject , ex:role_MeasurementProvider ;
    sulo:atTime ex:time_Measurement ;
    sulo:hasFeature ex:status_completed .

ex:role_MeasurementSubject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angelic_Callie_Schaden .

ex:role_MeasurementProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Willian_Batz .

ex:time_Measurement sulo:hasValue "2016-12-13T23:46:57+01:00"^^xsd:dateTime .

ex:measurement_2016_12_13 a chr:Measurement ;
    sulo:hasValue "2.8386"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_Measurement ;
    sulo:hasFeature ex:severity_painScore .

ex:unit_score a chr:Unit ;
    rdfs:label "score" .

ex:severity_painScore a chr:Severity ;
    rdfs:label "Pain severity score" .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Evaluation process producing diagnostic statement
ex:evaluationProcess_2017_05_09T18_24_27 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient , ex:role_EvalPerformer ;
    sulo:atTime ex:time_Evaluation .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angelic_Callie_Schaden .

ex:role_EvalPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Willian_Batz .

ex:time_Evaluation sulo:hasValue "2017-05-09T18:24:27+02:00"^^xsd:dateTime .

ex:diagnosticStatement_AcuteInfectiveCystitis a chr:DiagnosticStatement ;
    rdfs:label "Acute infective cystitis (SNOMED: 307426000)" .

# Link diagnostic statement to evaluation (as output role)
ex:output_EvalDiagnostic a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement_AcuteInfectiveCystitis .

ex:evaluationProcess_2017_05_09T18_24_27 sulo:hasParticipant ex:output_EvalDiagnostic .

# Care plan referencing a follow‑up procedure
ex:carePlan_1 a chr:CarePlan ;
    sulo:refersTo ex:medicalProcedure_FollowUpMonitoring .

ex:medicalProcedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "Follow‑up monitoring and routine review" .