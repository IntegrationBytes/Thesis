@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Arturo a chr:Person .
ex:person_Louis a chr:Person .

# Care unit
ex:careunit_WHITTIER a chr:CareUnit .

# Clinical visit
ex:visit_2019_06_05T12_34_22 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_WHITTIER ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Louis .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-06-05T12:34:22+02:00"^^xsd:dateTime .

# Measurement (body temperature)
ex:measurement_bodyTemp a chr:Measurement ;
    sulo:hasValue "37.53"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_measurement .

ex:unit_Celsius a chr:Unit .

ex:proc_measure_bodyTemp a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPatient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measurement .

ex:role_MeasPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:status_completed a chr:ProcessStatus .

ex:time_measurement a sulo:TimeInstant ;
    sulo:hasValue "2019-06-05T12:34:22+02:00"^^xsd:dateTime .

# Evaluation process producing diagnostic statement
ex:evaluation_2019_06_05 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient , ex:role_EvalProvider , ex:role_EvalOutput ;
    sulo:atTime ex:time_evaluation .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_EvalProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Louis .

ex:role_EvalOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_AcuteViralPharyngitis .

ex:diag_AcuteViralPharyngitis a chr:DiagnosticStatement .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2019-06-05T12:34:22+02:00"^^xsd:dateTime .

# Clinical condition (optional)
ex:cond_AcuteViralPharyngitis a chr:ClinicalCondition .

# Care plan referencing a follow‑up procedure
ex:careplan_2019_06_05 a chr:CarePlan ;
    sulo:refersTo ex:proc_followupMonitoring .

ex:proc_followupMonitoring a chr:MedicalProcedure .