@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Dolores_Nevarez a chr:Person .
ex:physician_Cari_Kohler a chr:Person .

# Roles
ex:role_SubjectOfCare_Dolores a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Dolores_Nevarez .

ex:role_CareProvider_CariKohler a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Cari_Kohler .

# Care unit
ex:careunit_DR_HEsPrimaryCare a chr:CareUnit .

# Clinical visit
ex:visit_2024_11_19_T04_20_29 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores , ex:role_CareProvider_CariKohler ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 ;
    sulo:isIn ex:careunit_DR_HEsPrimaryCare .

ex:time_2024_11_19_T04_20_29 a sulo:TimeInstant ;
    sulo:hasValue "2024-11-19T04:20:29+01:00"^^xsd:dateTime .

# Units
ex:unit_cm        a chr:Unit .
ex:unit_kg        a chr:Unit .
ex:unit_kg_per_m2 a chr:Unit .
ex:unit_percent   a chr:Unit .
ex:unit_per_min   a chr:Unit .

# Process status
ex:status_completed a chr:ProcessStatus .

# Height measurement
ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "157.4"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 .

ex:process_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# Pain severity measurement
ex:severity_4 a chr:Severity .

ex:measurement_PainSeverity a chr:Measurement ;
    sulo:hasValue "4"^^xsd:float ;
    sulo:hasFeature ex:severity_4 ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 .

ex:process_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# Weight measurement
ex:measurement_Weight a chr:Measurement ;
    sulo:hasValue "57"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 .

ex:process_Weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# BMI (ratio) measurement
ex:measurement_BMI_Ratio a chr:Measurement ;
    sulo:hasValue "23"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 .

ex:process_BMI_Ratio a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# BMI (percentile) measurement
ex:measurement_BMI_Percentile a chr:Measurement ;
    sulo:hasValue "90.094"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 .

ex:process_BMI_Percentile a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# Heart rate measurement
ex:measurement_HeartRate a chr:Measurement ;
    sulo:hasValue "65"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 .

ex:process_HeartRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# Respiratory rate measurement
ex:measurement_RespiratoryRate a chr:Measurement ;
    sulo:hasValue "13"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_2024_11_19_T04_20_29 .

ex:process_RespiratoryRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# PHQ-9 total score measurement (different timestamp)
ex:time_2024_11_19_T04_59_42 a sulo:TimeInstant ;
    sulo:hasValue "2024-11-19T04:59:42+01:00"^^xsd:dateTime .

ex:measurement_PHQ9 a chr:Measurement ;
    sulo:hasValue "2"^^xsd:float ;
    sulo:atTime ex:time_2024_11_19_T04_59_42 .

ex:process_PHQ9 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Dolores ;
    sulo:hasFeature ex:status_completed .

# Diagnostic statement and evaluation
ex:diagnostic_Gingivitis a chr:DiagnosticStatement .

ex:role_Output_Gingivitis a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_Gingivitis .

ex:evaluation_2024_11_19_T04_59_42 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_CareProvider_CariKohler , ex:role_SubjectOfCare_Dolores , ex:role_Output_Gingivitis ;
    sulo:atTime ex:time_2024_11_19_T04_59_42 .

# Care plan and referenced procedure
ex:procedure_Followup a chr:MedicalProcedure .

ex:careplan_Followup a chr:CarePlan ;
    sulo:refersTo ex:procedure_Followup .