    sulo:hasValue "2024-10-19T11:17:51+02:00"^^xsd:dateTime .

ex:process_totalScore a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_totalScore ;
    sulo:hasParticipant ex:role_output_totalScore ;
