    sulo:hasValue "2024-10-19T10:40:47+02:00"^^xsd:dateTime .

ex:evaluation_2024-10-19T10:40:47 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_subject_evaluation ;
    sulo:hasParticipant ex:role_performer_evaluation ;
    sulo:hasParticipant ex:role_output_employment ;
    sulo:hasParticipant ex:role_output_isolation ;
