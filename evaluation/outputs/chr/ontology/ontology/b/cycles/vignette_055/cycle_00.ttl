@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Daren950 a chr:Person ;
    rdfs:label "Daren950 Ed239 Strosin214" ;
    ex:identifier "P-c101372f" .

ex:physician_Ping a chr:Person ;
    rdfs:label "Dr. Ping698 Weissnat378" .

# Care unit
ex:careUnit_CommunityHealth a chr:CareUnit ;
    rdfs:label "COMMUNITY HEALTH PROGRAMS INC" .

# Clinical visit
ex:visit_2024-10-19T10:01:15 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_subject_visit ;
    sulo:hasParticipant ex:role_provider_visit ;
    sulo:isIn ex:careUnit_CommunityHealth ;
    sulo:atTime ex:time_visit .

ex:role_subject_visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Daren950 .

ex:role_provider_visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Ping .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2024-10-19T10:01:15+02:00"^^xsd:dateTime .

# Shared time instant for measurements performed at 10:01:15
ex:time_measurements a sulo:TimeInstant ;
    sulo:hasValue "2024-10-19T10:01:15+02:00"^^xsd:dateTime .

# Process status
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_cm a chr:Unit ; rdfs:label "cm" .
ex:unit_score a chr:Unit ; rdfs:label "score" .
ex:unit_kg a chr:Unit ; rdfs:label "kg" .
ex:unit_kg_per_m2 a chr:Unit ; rdfs:label "kg/m2" .
ex:unit_per_min a chr:Unit ; rdfs:label "/min" .

# Body Height measurement
ex:process_bodyHeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_bodyHeight ;
    sulo:hasParticipant ex:role_output_bodyHeight ;
    sulo:atTime ex:time_measurements ;
    sulo:hasFeature ex:status_completed .

ex:role_subject_bodyHeight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Daren950 .

ex:role_output_bodyHeight a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bodyHeight .

ex:measurement_bodyHeight a chr:Measurement ;
    sulo:hasValue "177.4"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_measurements .

