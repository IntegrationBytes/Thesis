    sulo:hasParticipant ex:role_Subject_Patient , ex:role_Provider_Physician , ex:role_Output_Diag_MedReview ;
    sulo:atTime ex:time_2013_03_27T15_47_23 ;
    sulo:hasFeature ex:status_completed .

ex:role_Output_Diag_MedReview a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_MedicationReview .

ex:diag_MedicationReview a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" ;
    rdfs:seeAlso <https://clinicalterms.org/SNOMED/314529007> .

# Evaluation 2 – Victim of intimate partner abuse
ex:evaluation_2 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Patient , ex:role_Provider_Physician , ex:role_Output_Diag_Abuse ;
    sulo:atTime ex:time_2013_03_27T16_22_07 ;
    sulo:hasFeature ex:status_completed .

ex:role_Output_Diag_Abuse a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_IntimatePartnerAbuse .

ex:diag_IntimatePartnerAbuse a chr:DiagnosticStatement ;
    rdfs:label "Victim of intimate partner abuse (finding)" ;
    rdfs:seeAlso <https://clinicalterms.org/SNOMED/706893006> .

# -----------------------------------------------------------------
# Care plan
# -----------------------------------------------------------------
ex:careplan_1 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "Follow‑up monitoring and routine review" .