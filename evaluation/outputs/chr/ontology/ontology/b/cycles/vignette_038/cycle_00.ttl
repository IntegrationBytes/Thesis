@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Cory_Heller a chr:Person .
ex:physician_Margene_Schamberger a chr:Person .

# Care unit
ex:careunit_LowellHospital a chr:CareUnit .

# Clinical visit
ex:visit_2016_10_09 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_LowellHospital ;
    sulo:hasParticipant ex:role_VisitSubject_Patient ,
                       ex:role_VisitProvider_Physician ;
    sulo:atTime ex:time_visit_2016_10_09 .

ex:role_VisitSubject_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Cory_Heller .

ex:role_VisitProvider_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Margene_Schamberger .

ex:time_visit_2016_10_09 sulo:hasValue "2016-10-09T11:44:05+02:00"^^xsd:dateTime .

# Process status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_percent      a sulo:Unit ; rdfs:label "%" .
ex:unit_cm           a sulo:Unit ; rdfs:label "cm" .
ex:unit_kg           a sulo:Unit ; rdfs:label "kg" .
ex:unit_kg_per_m2    a sulo:Unit ; rdfs:label "kg/m2" .
ex:unit_per_min      a sulo:Unit ; rdfs:label "/min" .
ex:unit_score        a sulo:Unit ; rdfs:label "score" .

# 1. FEV1/FVC measurement
ex:measurement_FEV1_FVC a chr:Measurement ;
    sulo:hasValue "72.195"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_measure_FEV1_FVC .

ex:proc_measure_FEV1_FVC a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasParticipant ex:role_Subject_FEV1 ,
                       ex:role_Performer_FEV1 ,
                       ex:output_FEV1 ;
    sulo:atTime ex:time_measure_FEV1_FVC .

ex:role_Subject_FEV1 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Cory_Heller .

ex:role_Performer_FEV1 a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Margene_Schamberger .

ex:output_FEV1 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_FEV1_FVC .

ex:time_measure_FEV1_FVC sulo:hasValue "2016-10-09T11:44:05+02:00"^^xsd:dateTime .

