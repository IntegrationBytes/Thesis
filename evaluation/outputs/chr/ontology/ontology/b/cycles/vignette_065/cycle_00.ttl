@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Nevarez a chr:Person .
ex:physician_Kohler a chr:Person .

# Care unit
ex:careunit_DRHE a chr:CareUnit .

# Clinical visit
ex:visit_2016_10_04 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit ;
    sulo:hasParticipant ex:role_Provider_Visit ;
    sulo:atTime ex:time_2016_10_04T05_20_29 .

ex:role_Subject_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Provider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Kohler .

# Time instant (shared)
ex:time_2016_10_04T05_20_29 a sulo:TimeInstant ;
    sulo:hasValue "2016-10-04T05:20:29+02:00"^^xsd:dateTime .

# Process status (shared)
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_cm          a chr:Unit .
ex:unit_kg          a chr:Unit .
ex:unit_percent     a chr:Unit .
ex:unit_kg_per_m2   a chr:Unit .
ex:unit_per_min     a chr:Unit .
ex:unit_score       a chr:Unit .

# Severity (pain)
ex:severity_1 a chr:Severity .

# Measurements and their processes

## Body Height
ex:proc_bodyHeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_bodyHeight ;
    sulo:hasParticipant ex:role_Output_bodyHeight ;
    sulo:atTime ex:time_2016_10_04T05_20_29 ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_bodyHeight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Output_bodyHeight a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bodyHeight .

ex:measurement_bodyHeight a chr:Measurement ;
    sulo:hasValue "104.0"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_2016_10_04T05_20_29 .

## Pain Severity
ex:proc_painSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_painSeverity ;
    sulo:hasParticipant ex:role_Output_painSeverity ;
    sulo:atTime ex:time_2016_10_04T05_20_29 ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_painSeverity a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Output_painSeverity a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_painSeverity .

ex:measurement_painSeverity a chr:Measurement ;
    sulo:hasValue "1.0"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:hasFeature ex:severity_1 ;
    sulo:atTime ex:time_2016_10_04T05_20_29 .

## Body Weight
ex:proc_bodyWeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_bodyWeight ;
    sulo:hasParticipant ex:role_Output_bodyWeight ;
    sulo:atTime ex:time_2016_10_04T05_20_29 ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_bodyWeight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Output_bodyWeight a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bodyWeight .

ex:measurement_bodyWeight a chr:Measurement ;
    sulo:hasValue "19.0"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_2016_10_04T05_20_29 .

## Weight-for-length Percentile
