# Evaluation (diagnostic statement)
ex:evaluation_2016_10_04 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Eval ;
    sulo:hasParticipant ex:role_Performer_Eval ;
    sulo:hasParticipant ex:role_Output_Diagnostic ;
    sulo:atTime ex:time_2016_10_04T05_20_29 ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_Eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Performer_Eval a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Kohler .

ex:role_Output_Diagnostic a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement_medReview .

ex:diagnosticStatement_medReview a chr:DiagnosticStatement .

# Care plan
ex:careplan_2016_10_04 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup_monitoring .

ex:procedure_followup_monitoring a chr:MedicalProcedure .