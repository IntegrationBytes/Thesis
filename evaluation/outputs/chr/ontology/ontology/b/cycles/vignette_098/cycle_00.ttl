@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Harvey a chr:Person .
ex:physician_Victor a chr:Person .

# Care unit
ex:careunit_4499 a chr:CareUnit .

# Clinical visit
ex:visit_2019-07-08T15:30:59+02:00 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_VisitPatient ,
                       ex:role_CareProvider_VisitPhysician ;
    sulo:isIn ex:careunit_4499 ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_CareProvider_VisitPhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Victor .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-07-08T15:30:59+02:00"^^xsd:dateTime .

# Measurement (body temperature)
ex:measurement_body_temp_2019-07-08T15:30:59+02:00 a chr:Measurement ;
    sulo:hasValue "37.063"^^xsd:float ;
    sulo:hasPart ex:unit_celsius ;
    sulo:atTime ex:time_measure .

ex:unit_celsius a chr:Unit .

ex:time_measure a sulo:TimeInstant ;
    sulo:hasValue "2019-07-08T15:30:59+02:00"^^xsd:dateTime .

# Measurement process
ex:process_measure_temp_2019-07-08T15:30:59+02:00 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_MeasurePatient ,
                       ex:role_CareProvider_MeasurePhysician ,
                       ex:role_Output_MeasureResult ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_MeasurePatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_CareProvider_MeasurePhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Victor .

ex:role_Output_MeasureResult a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_body_temp_2019-07-08T15:30:59+02:00 .

ex:status_completed a chr:ProcessStatus .

# Evaluation process (diagnostic)
ex:evaluation_2019-07-08T15:30:59+02:00 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_EvalPatient ,
                       ex:role_CareProvider_EvalPhysician ,
                       ex:role_Output_DiagnosticStatement ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_evaluation .

ex:role_SubjectOfCare_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_CareProvider_EvalPhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Victor .

ex:role_Output_DiagnosticStatement a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_AcuteViralPharyngitis .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2019-07-08T15:30:59+02:00"^^xsd:dateTime .

# Diagnostic statement
ex:diag_AcuteViralPharyngitis a chr:DiagnosticStatement .

# Clinical condition
ex:condition_AcuteViralPharyngitis a chr:ClinicalCondition ;
    sulo:hasFeature ex:diag_AcuteViralPharyngitis .

# Care plan
ex:careplan_followup a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure .