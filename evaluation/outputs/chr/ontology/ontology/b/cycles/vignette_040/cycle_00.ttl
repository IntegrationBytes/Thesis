@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Cory_Frank_Heller a chr:Person .
ex:physician_Margene_Schamberger a chr:Person .

# Care unit
ex:careunit_LowellHospital a chr:CareUnit .

# Clinical visit
ex:visit_2017_04_11 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_visit_patient ,
                       ex:role_visit_physician ,
                       ex:role_visit_careProvider ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_LowellHospital .

ex:role_visit_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Cory_Frank_Heller .
ex:role_visit_physician a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Margene_Schamberger .
ex:role_visit_careProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Margene_Schamberger .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T14:32:19+02:00"^^xsd:dateTime .

# Measurement: Polyp size
ex:measurementProcess_polypSize a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_polypSize_patient ,
                       ex:role_polypSize_physician ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_polypSize .

ex:role_polypSize_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Cory_Frank_Heller .
ex:role_polypSize_physician a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Margene_Schamberger .

ex:measurement_polypSize a chr:Measurement ;
    sulo:hasValue "11.962"^^xsd:float ;
    sulo:hasPart ex:unit_mm ;
    sulo:atTime ex:time_polypSize .

ex:unit_mm a chr:Unit .

ex:time_polypSize a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T15:00:14+02:00"^^xsd:dateTime .

# Measurement: Hemoglobin in stool
ex:measurementProcess_hemoglobin a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_hemoglobin_patient ,
                       ex:role_hemoglobin_physician ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_hemoglobin .

ex:role_hemoglobin_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Cory_Frank_Heller .
ex:role_hemoglobin_physician a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Margene_Schamberger .

ex:measurement_hemoglobin a chr:Measurement ;
    sulo:hasValue "242.07"^^xsd:float ;
    sulo:hasPart ex:unit_ng_per_mL ;
    sulo:atTime ex:time_hemoglobin .

ex:unit_ng_per_mL a chr:Unit .

ex:time_hemoglobin a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T15:00:14+02:00"^^xsd:dateTime .

# Evaluation process producing diagnostic statement
ex:evaluationProcess_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_eval_patient ,
                       ex:role_eval_physician ,
                       ex:output_role_diag ;
    sulo:atTime ex:time_evaluation .

ex:role_eval_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Cory_Frank_Heller .
ex:role_eval_physician a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Margene_Schamberger .

ex:output_role_diag a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement_polypColon .

ex:diagnosticStatement_polypColon a chr:DiagnosticStatement .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T15:00:14+02:00"^^xsd:dateTime .

# Process status (used for measurement processes)
ex:status_completed a chr:ProcessStatus .

# Care plan and referenced procedure
ex:carePlan_1 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure .