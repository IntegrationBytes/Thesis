ex:acute_viral_pharyngitis_event sulo:hasParticipant ex:role_condition .

ex:severity_moderate a chr:Severity ;
  rdfs:label "Moderate" .

ex:role_severity a chr:SeverityRole ;
  sulo:isFeatureOf ex:severity_moderate .

ex:acute_viral_pharyngitis_event sulo:hasParticipant ex:role_severity .

ex:care_plan a chr:CarePlan ;
  sulo:refersTo ex:follow_up_monitoring , ex:routine_review .

ex:follow_up_monitoring a chr:MedicalProcedure .

ex:routine_review a chr:MedicalProcedure .