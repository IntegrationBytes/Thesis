ex:evaluation_2019_03_16 sulo:hasParticipant ex:role_evaluation_result .

ex:acute_viral_pharyngitis_event a sulo:Event ;
  sulo:atTime ex:condition_record_time .

ex:condition_record_time a sulo:TimeInstant ;
  sulo:hasValue "2019-03-16T17:01:00"^^xsd:dateTime .

ex:acute_viral_pharyngitis a chr:ClinicalCondition .

ex:role_condition a chr:FindingRole ;
  sulo:isFeatureOf ex:acute_viral_pharyngitis .

