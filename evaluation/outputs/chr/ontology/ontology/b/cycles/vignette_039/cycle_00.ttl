@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Units
ex:unit_percent      a chr:Unit .
ex:unit_cm           a chr:Unit .
ex:unit_score        a chr:Unit .
ex:unit_kg           a chr:Unit .
ex:unit_kg_per_m2    a chr:Unit .
ex:unit_per_min      a chr:Unit .
ex:unit_number       a chr:Unit .

# Persons
ex:person_Cory a chr:Person .
ex:person_Hank a chr:Person .

# Care unit
ex:careunit_LOWELL a chr:CareUnit .

# Clinical visit
ex:visit_2017_04_09_11_44_05 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_LOWELL ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Hank .

# Common status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Measurement: FEV1/FVC
ex:process_FEV1_FVC a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_FEV1_FVC ,
                       ex:role_Performer_FEV1_FVC ,
                       ex:role_Output_FEV1_FVC ;
    sulo:atTime ex:time_FEV1_FVC ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_FEV1_FVC a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory .

ex:role_Performer_FEV1_FVC a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Hank .

ex:role_Output_FEV1_FVC a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_FEV1_FVC .

ex:measurement_FEV1_FVC a chr:Measurement ;
    sulo:hasValue "69.86"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_FEV1_FVC .

ex:time_FEV1_FVC a sulo:TimeInstant ;
    sulo:hasValue "2017-04-09T11:44:05+02:00"^^xsd:dateTime .

