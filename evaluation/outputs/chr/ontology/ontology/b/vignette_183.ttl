# Clinical visit
ex:visit_2013_02_13 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ,
                       ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_ENCOMPASS .

