ex:person_DrAssunta a chr:Person .

# Care unit
ex:careunit_ChildFamilyServices a chr:CareUnit .

# Visit
ex:visit_20160701T203059 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_20160701T203059 ;
    sulo:isIn ex:careunit_ChildFamilyServices ;
    sulo:hasParticipant ex:role_VisitPatient_Harvey ;
    sulo:hasParticipant ex:role_VisitProvider_DrAssunta .

