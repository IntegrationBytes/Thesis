    sulo:hasValue "2016-07-01T20:30:59+02:00"^^xsd:dateTime .

ex:role_VisitPatient_Harvey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Harvey .

ex:role_VisitProvider_DrAssunta a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_DrAssunta .

