@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Daren950 a chr:Person .
ex:physician_Ping698 a chr:Person .

# Care unit
ex:careunit_COMMUNITY a chr:CareUnit .

# Clinical visit
ex:visit_2022_10_08 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2022_10_08 ;
    sulo:isIn ex:careunit_COMMUNITY ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider .

ex:time_visit_2022_10_08 a sulo:TimeInstant ;
    sulo:hasValue "2022-10-08T10:01:15+02:00"^^xsd:dateTime .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Daren950 .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Ping698 .

# Units
ex:unit_cm          a chr:Unit .
ex:unit_kg          a chr:Unit .
ex:unit_kg_per_m2   a chr:Unit .
ex:unit_percent     a chr:Unit .
ex:unit_per_min     a chr:Unit .
ex:unit_score       a chr:Unit .

# Process status
ex:status_completed a chr:ProcessStatus .

# ---- Measurements ----

## Body Height
ex:measurement_bodyHeight a chr:Measurement ;
    sulo:hasValue "176.8"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_bodyHeight .

ex:time_bodyHeight a sulo:TimeInstant ;
    sulo:hasValue "2022-10-08T10:01:15+02:00"^^xsd:dateTime .

ex:proc_bodyHeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_bodyHeightPatient , ex:role_bodyHeightOutput ;
    sulo:hasFeature ex:status_completed .

ex:role_bodyHeightPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Daren950 .

ex:role_bodyHeightOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bodyHeight .

