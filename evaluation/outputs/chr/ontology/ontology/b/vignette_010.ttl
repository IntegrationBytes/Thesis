@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Arturo47 a chr:Person ;
    rdfs:label "Arturo47 Lauren941 Heidenreich818" .

ex:person_Louis204 a chr:Person ;
    rdfs:label "Louis204 Hauck852" .

# Care unit
ex:careUnit_WHITTIER a chr:CareUnit ;
    rdfs:label "WHITTIER REHABILTATION HOSPITAL" .

# Clinical visit
ex:visit_2016_12_26 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careUnit_WHITTIER ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Arturo ,
                       ex:role_CareProvider_Visit_Louis .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2016-12-26T01:34:22+01:00"^^xsd:dateTime .

ex:role_SubjectOfCare_Visit_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_CareProvider_Visit_Louis a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Louis204 .

# Measurement process (Hemoglobin A1c)
ex:measurementProcess_2016_12_26 a chr:MeasurementProcess ;
    sulo:atTime ex:time_measurement ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasParticipant ex:role_SubjectOfCare_Meas_Arturo ,
                       ex:role_Output_Meas .

ex:time_measurement a sulo:TimeInstant ;
    sulo:hasValue "2016-12-26T01:34:22+01:00"^^xsd:dateTime .

ex:role_SubjectOfCare_Meas_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:measurement_HbA1c a chr:Measurement ;
    sulo:hasValue "6.31"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_measurement .

ex:unit_percent a chr:Unit ;
    rdfs:label "percent" .

ex:role_Output_Meas a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HbA1c .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Evaluation process (Medication review)
ex:evaluation_2016_12_26 a chr:EvaluationProcess ;
    sulo:atTime ex:time_evaluation ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval_Arturo ,
                       ex:role_CareProvider_Eval_Louis ,
                       ex:role_Output_Eval .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2016-12-26T01:34:22+01:00"^^xsd:dateTime .

ex:role_SubjectOfCare_Eval_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_CareProvider_Eval_Louis a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Louis204 .

ex:diag_MedReview a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" .

ex:role_Output_Eval a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_MedReview .

# Care plan referencing a medical procedure
ex:carePlan_001 a chr:CarePlan ;
    sulo:refersTo ex:medicalProcedure_FollowUp .

ex:medicalProcedure_FollowUp a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .