@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Nevarez a chr:Person ;
    rdfs:label "Dolores502 Marisol435 Nevárez403" .

ex:physician_Kohler a chr:Person ;
    rdfs:label "Dr. Cari853 Kohler843" .

# Care unit
ex:careunit_DRHEs a chr:CareUnit ;
    rdfs:label "DR. HE'S PRIMARY CARE FOR ADULTS INC" .

# Clinical visit
ex:visit_2025_11_25 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit ,
                       ex:role_Provider_Visit ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_DRHEs .

ex:role_Subject_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Provider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Kohler .

# Time instants
ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2025-11-25T04:20:29+01:00"^^xsd:dateTime .

ex:time_eval1 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-25T04:20:29+01:00"^^xsd:dateTime .

ex:time_eval2 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-25T04:57:57+01:00"^^xsd:dateTime .

# Process status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_cm a chr:Unit ;
    rdfs:label "cm" .

ex:unit_kg a chr:Unit ;
    rdfs:label "kg" .

ex:unit_kg_per_m2 a chr:Unit ;
    rdfs:label "kg/m2" .

ex:unit_percent a chr:Unit ;
    rdfs:label "%" .

ex:unit_per_min a chr:Unit ;
    rdfs:label "/min" .

ex:unit_score a chr:Unit ;
    rdfs:label "score" .

# Height measurement
ex:proc_height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Height ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_height a chr:Measurement ;
    sulo:hasValue "162.9"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit .

# Weight measurement
ex:proc_weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Weight ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_Weight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_weight a chr:Measurement ;
    sulo:hasValue "65.1"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_visit .

# BMI ratio measurement
ex:proc_bmi_ratio a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_BMI_Ratio ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_BMI_Ratio a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_bmi_ratio a chr:Measurement ;
    sulo:hasValue "24.55"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_visit .

# BMI percentile measurement
ex:proc_bmi_percentile a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_BMI_Percentile ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_BMI_Percentile a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_bmi_percentile a chr:Measurement ;
    sulo:hasValue "91.807"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit .

# Heart rate measurement
ex:proc_heart_rate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_HeartRate ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_HeartRate a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_heart_rate a chr:Measurement ;
    sulo:hasValue "72"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit .

# Respiratory rate measurement
ex:proc_resp_rate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_RespRate ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_RespRate a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_resp_rate a chr:Measurement ;
    sulo:hasValue "13"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit .

# Pain severity measurement
ex:proc_pain_severity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Pain ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_Pain a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_pain_severity a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_visit .

# PHQ‑9 measurement
ex:proc_phq9 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_PHQ9 ;
    sulo:atTime ex:time_eval2 ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_PHQ9 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:measurement_phq9 a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_eval2 .

# Evaluation 1 – Medication review
ex:evaluation1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Eval1 ,
                       ex:role_Provider_Eval1 ,
                       ex:role_Output_Diagnosis1 ;
    sulo:atTime ex:time_eval1 .

ex:role_Subject_Eval1 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Provider_Eval1 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Kohler .

ex:role_Output_Diagnosis1 a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosis_medreview .

ex:diagnosis_medreview a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" .

# Evaluation 2 – Gingivitis
ex:evaluation2 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Eval2 ,
                       ex:role_Provider_Eval2 ,
                       ex:role_Output_Diagnosis2 ;
    sulo:atTime ex:time_eval2 .

ex:role_Subject_Eval2 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Provider_Eval2 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Kohler .

ex:role_Output_Diagnosis2 a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosis_gingivitis .

ex:diagnosis_gingivitis a chr:DiagnosticStatement ;
    rdfs:label "Gingivitis (disorder)" .

# Care plan
ex:careplan_2025_11_25 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup_monitoring .

ex:procedure_followup_monitoring a chr:MedicalProcedure ;
    rdfs:label "follow‑up monitoring and routine review" .