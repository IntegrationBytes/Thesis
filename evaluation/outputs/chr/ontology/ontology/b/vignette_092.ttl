@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Hallie_Tasha_Grant a chr:Person .
ex:physician_Teresa_Tapia a chr:Person .

# Care unit
ex:careunit_CARING_HEALTH_CENTER_INC a chr:CareUnit .

# Time instant for the visit (used for all events)
ex:time_visit_2024_05_08T16_30_02 a sulo:TimeInstant ;
    sulo:hasValue "2024-05-08T16:30:02+02:00"^^xsd:dateTime .

# Clinical visit
ex:visit_2024_05_08T16_30_02 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2024_05_08T16_30_02 ;
    sulo:isIn ex:careunit_CARING_HEALTH_CENTER_INC ;
    sulo:hasParticipant ex:role_VisitSubject_Patient ;
    sulo:hasParticipant ex:role_VisitProvider_Physician .

ex:role_VisitSubject_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie_Tasha_Grant .

ex:role_VisitProvider_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Teresa_Tapia .

# Reusable subject role for measurements
ex:role_MeasSubject_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie_Tasha_Grant .

# Process status (completed)
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_cm        a chr:Unit .
ex:unit_kg        a chr:Unit .
ex:unit_percent   a chr:Unit .
ex:unit_per_min   a chr:Unit .
ex:unit_kg_per_m2 a chr:Unit .

# Height measurement
ex:meas_Height a chr:Measurement ;
    sulo:hasValue "94.1"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2024_05_08T16_30_02 .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Height .

ex:proc_Height a chr:MeasurementProcess ;
    sulo:atTime ex:time_visit_2024_05_08T16_30_02 ;
    sulo:hasParticipant ex:role_MeasSubject_Patient ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:hasFeature ex:status_completed .

# Pain severity measurement
ex:meas_PainSeverity a chr:Measurement ;
