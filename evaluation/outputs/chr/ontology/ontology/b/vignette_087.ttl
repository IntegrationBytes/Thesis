@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Hallie315_Tasha327_Grant908 a chr:Person ;
    rdfs:label "Hallie315 Tasha327 Grant908" .

ex:physician_Teresa94_Tapia475 a chr:Person ;
    rdfs:label "Dr. Teresa94 Tapia475" .

# Care unit
ex:careunit_CARING_HEALTH_CENTER_INC a chr:CareUnit ;
    rdfs:label "CARING HEALTH CENTER, INC" .

# Clinical visit
ex:visit_2022_08_10_T16_30_02 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_CARING_HEALTH_CENTER_INC ;
    sulo:atTime ex:time_visit_2022_08_10_T16_30_02 ;
    sulo:hasParticipant ex:role_SubjectOfCare_patient_visit ,
                       ex:role_CareProvider_physician_visit .

ex:time_visit_2022_08_10_T16_30_02 a sulo:TimeInstant ;
    sulo:hasValue "2022-08-10T16:30:02+02:00"^^xsd:dateTime .

# Roles for the visit
ex:role_SubjectOfCare_patient_visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie315_Tasha327_Grant908 .

ex:role_CareProvider_physician_visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Teresa94_Tapia475 .

# Process status (used for all completed processes)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_cm a chr:Unit ; rdfs:label "centimeter" .
ex:unit_kg a chr:Unit ; rdfs:label "kilogram" .
ex:unit_percent a chr:Unit ; rdfs:label "percent" .
ex:unit_score a chr:Unit ; rdfs:label "score" .
ex:unit_per_min a chr:Unit ; rdfs:label "per minute" .

# ------------------------------
# Height measurement
ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "77.1"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_measure_2022_08_10_T16_30_02 .

ex:process_Height_Measurement a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_patient_height ,
                       ex:role_Output_measurement_Height ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_patient_height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie315_Tasha327_Grant908 .

ex:role_Output_measurement_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Height .

