ex:patient_Estela596_Yetta429_Grant908 a chr:Person .

ex:visit_2000_02_13 a chr:ClinicalVisit ;
  sulo:atTime ex:time_visit_2000_02_13 ;
  sulo:isIn ex:care_unit_braintree .

ex:time_visit_2000_02_13 a sulo:TimeInstant ;
  sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

ex:care_unit_braintree a chr:CareUnit .

ex:role_visit_patient a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Estela596_Yetta429_Grant908 .

ex:visit_2000_02_13 sulo:hasParticipant ex:role_visit_patient .

ex:role_visit_provider a chr:CareProviderRole ;
  sulo:isFeatureOf ex:doctor_Schumm995 .

ex:doctor_Schumm995 a chr:Person .

ex:visit_2000_02_13 sulo:hasParticipant ex:role_visit_provider .

ex:body_temp_measurement a chr:MeasurementProcess ;
  sulo:atTime ex:time_body_temp_measurement ;
  sulo:hasParticipant ex:role_body_temp_patient .

ex:time_body_temp_measurement a sulo:TimeInstant ;
  sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

ex:role_body_temp_patient a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Estela596_Yetta429_Grant908 .

ex:body_temp_result a chr:Measurement ;
  sulo:hasValue "37.436"^^xsd:float .

ex:body_temp_measurement sulo:hasParticipant ex:role_body_temp_result .

ex:role_body_temp_result a chr:OutputRole ;
  sulo:isFeatureOf ex:body_temp_result .

ex:evaluation a chr:EvaluationProcess ;
  sulo:atTime ex:time_evaluation ;
  sulo:hasParticipant ex:role_evaluation_patient ;
  sulo:hasParticipant ex:role_evaluation_performer .

ex:time_evaluation a sulo:TimeInstant ;
  sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

ex:role_evaluation_patient a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Estela596_Yetta429_Grant908 .

ex:role_evaluation_performer a chr:PerformerRole ;
  sulo:isFeatureOf ex:doctor_Schumm995 .

ex:diagnostic_statement a chr:DiagnosticStatement ;
  rdfs:label "Acute viral pharyngitis (disorder)" .

ex:evaluation sulo:hasParticipant ex:role_diagnostic_statement .

ex:role_diagnostic_statement a chr:OutputRole ;
  sulo:isFeatureOf ex:diagnostic_statement .

ex:condition_pharyngitis a chr:ClinicalCondition ;
  sulo:atTime ex:time_condition_recorded ;
  sulo:hasFeature ex:severity_moderate .

ex:time_condition_recorded a sulo:TimeInstant ;
  sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

ex:severity_moderate a chr:Severity .

ex:care_plan a chr:CarePlan ;
  sulo:refersTo ex:follow_up_monitoring ;
  sulo:refersTo ex:routine_review .

ex:follow_up_monitoring a chr:MedicalProcedure .

ex:routine_review a chr:MedicalProcedure .

ex:measurement_status a chr:ProcessStatus ;
  rdfs:label "completed" .

ex:body_temp_measurement sulo:hasFeature ex:measurement_status .