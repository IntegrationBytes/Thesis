@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_P_c101372f a chr:Person .
ex:physician_Carroll471_Eichmann909 a chr:Person .

# Care unit
ex:careunit_BerkshireMedicalCenter a chr:CareUnit .

# Clinical visit
ex:visit_2019_03_16T17_01_15 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2019_03_16T17_01_15 ;
    sulo:isIn ex:careunit_BerkshireMedicalCenter .

ex:time_visit_2019_03_16T17_01_15 a sulo:TimeInstant ;
    sulo:hasValue "2019-03-16T17:01:15+01:00"^^xsd:dateTime .

# Temperature measurement process
ex:measurementProcess_temp_2019_03_16T17_01_15 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_temp_2019_03_16T17_01_15 ,
                       ex:role_Performer_temp_2019_03_16T17_01_15 ,
                       ex:role_Output_tempMeasurement ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_temp_2019_03_16T17_01_15 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_P_c101372f .

ex:role_Performer_temp_2019_03_16T17_01_15 a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Carroll471_Eichmann909 .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Measurement result
ex:measurement_temp_2019_03_16T17_01_15 a chr:Measurement ;
    sulo:hasValue "37.277"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_measurement_temp_2019_03_16T17_01_15 .

ex:unit_Celsius a chr:Unit ;
    rdfs:label "Celsius" .

ex:time_measurement_temp_2019_03_16T17_01_15 a sulo:TimeInstant ;
    sulo:hasValue "2019-03-16T17:01:15+01:00"^^xsd:dateTime .

ex:role_Output_tempMeasurement a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_temp_2019_03_16T17_01_15 .

# Evaluation process producing diagnostic statement
ex:evaluationProcess_2019_03_16T17_01_15 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_eval_2019_03_16T17_01_15 ,
                       ex:role_Performer_eval_2019_03_16T17_01_15 ,
                       ex:role_Output_diagnosticStatement ;
    sulo:atTime ex:time_evaluation_2019_03_16T17_01_15 .

ex:role_SubjectOfCare_eval_2019_03_16T17_01_15 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_P_c101372f .

ex:role_Performer_eval_2019_03_16T17_01_15 a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Carroll471_Eichmann909 .

ex:diagnosticStatement_acuteViralPharyngitis a chr:DiagnosticStatement ;
    rdfs:label "Acute viral pharyngitis" .

ex:role_Output_diagnosticStatement a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement_acuteViralPharyngitis .

ex:time_evaluation_2019_03_16T17_01_15 a sulo:TimeInstant ;
    sulo:hasValue "2019-03-16T17:01:15+01:00"^^xsd:dateTime .

# Care plan referencing a follow‑up procedure
ex:carePlan_2019_03_16T17_01_15 a chr:CarePlan ;
    sulo:refersTo ex:medicalProcedure_followup .

ex:medicalProcedure_followup a chr:MedicalProcedure ;
    rdfs:label "Follow-up monitoring and routine review" .