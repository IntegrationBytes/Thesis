@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Casey401_Elijah719_Parker433 a chr:Person .
ex:person_Rhett759_Padberg411 a chr:Person .

# Care unit
ex:careUnit_VIBRA_HOSPITAL a chr:CareUnit ;
    rdfs:label "VIBRA HOSPITAL OF WESTERN MASSACHUSETTS LLC" .

# Clinical visit
ex:visit_2021_11_12T22_03_18 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Casey ;
    sulo:hasParticipant ex:role_VisitProvider_Rhett ;
    sulo:isIn ex:careUnit_VIBRA_HOSPITAL ;
    sulo:atTime ex:time_visit .

ex:role_VisitPatient_Casey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

ex:role_VisitProvider_Rhett a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Rhett759_Padberg411 .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2021-11-12T22:03:18+01:00"^^xsd:dateTime .

# Measurement 1 – Polyp size
ex:proc_MeasurePolypSize a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPolypPatient ;
    sulo:hasParticipant ex:outputRole_MeasPolyp ;
    sulo:hasFeature ex:status_completed1 ;
    sulo:atTime ex:time_MeasPolyp .

ex:role_MeasPolypPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

ex:status_completed1 a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:time_MeasPolyp a sulo:TimeInstant ;
    sulo:hasValue "2021-11-12T22:48:07+01:00"^^xsd:dateTime .

ex:measurement_PolypSize a chr:Measurement ;
    sulo:hasValue "2.4093"^^xsd:float ;
    sulo:hasPart ex:unit_mm ;
    sulo:atTime ex:time_MeasPolyp .

ex:unit_mm a sulo:Unit ;
    rdfs:label "mm" .

ex:outputRole_MeasPolyp a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_PolypSize .

# Measurement 2 – Hemoglobin in stool
ex:proc_MeasHemoglobin a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasHemoPatient ;
    sulo:hasParticipant ex:outputRole_MeasHemoglobin ;
    sulo:hasFeature ex:status_completed2 ;
    sulo:atTime ex:time_MeasHemoglobin .

ex:role_MeasHemoPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

ex:status_completed2 a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:time_MeasHemoglobin a sulo:TimeInstant ;
    sulo:hasValue "2021-11-12T22:48:07+01:00"^^xsd:dateTime .

ex:measurement_Hemoglobin a chr:Measurement ;
    sulo:hasValue "24.389"^^xsd:float ;
    sulo:hasPart ex:unit_ng_per_mL ;
    sulo:atTime ex:time_MeasHemoglobin .

ex:unit_ng_per_mL a sulo:Unit ;
    rdfs:label "ng/mL" .

ex:outputRole_MeasHemoglobin a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Hemoglobin .

# Evaluation process producing diagnostic statement
ex:evaluation_2021_11_12T22_48_07 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient ;
    sulo:hasParticipant ex:role_EvalProvider ;
    sulo:hasParticipant ex:outputRole_Diagnostic ;
    sulo:atTime ex:time_Eval .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

ex:role_EvalProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Rhett759_Padberg411 .

ex:time_Eval a sulo:TimeInstant ;
    sulo:hasValue "2021-11-12T22:48:07+01:00"^^xsd:dateTime .

ex:diag_PolypColon a chr:DiagnosticStatement ;
    rdfs:label "Polyp of colon (disorder)" .

ex:outputRole_Diagnostic a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_PolypColon .

# Care plan referencing a follow‑up medical procedure
ex:carePlan_2021_11_12 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "follow‑up monitoring and routine review" .