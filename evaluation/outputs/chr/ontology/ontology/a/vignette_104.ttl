@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Aracely_Devon_Collins
    a chr:Person ;
    rdfs:label "Aracely711 Devon268 Collins926" .

ex:person_Margaret_Reinger
    a chr:Person ;
    rdfs:label "Dr. Margaret865 Reinger292" .

# Care unit
ex:careunit_CARNEY_HOSPITAL
    a chr:CareUnit ;
    rdfs:label "CARNEY HOSPITAL" .

# Clinical visit (process)
ex:visit_2019_06_28T15_04_38
    a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient ;
    sulo:hasParticipant ex:role_VisitProvider ;
    sulo:isIn ex:careunit_CARNEY_HOSPITAL ;
    sulo:atTime ex:time_visit .

# Roles for the visit
ex:role_VisitPatient
    a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Aracely_Devon_Collins .

ex:role_VisitProvider
    a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Margaret_Reinger .

# Time instant for the visit
ex:time_visit
    a sulo:TimeInstant ;
    sulo:hasValue "2019-06-28T15:04:38+02:00"^^xsd:dateTime .

# Measurement process (temperature)
ex:process_TempMeasurement_2019_06_28T15_04_38
    a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_TempPatient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measurement .

ex:role_TempPatient
    a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Aracely_Devon_Collins .

ex:status_completed
    a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:time_measurement
    a sulo:TimeInstant ;
    sulo:hasValue "2019-06-28T15:04:38+02:00"^^xsd:dateTime .

# Measurement result
ex:measurement_body_temp_2019_06_28T15_04_38
    a chr:Measurement ;
    sulo:hasValue "37.279"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_measurement .

ex:unit_Celsius
    a chr:Unit ;
    rdfs:label "Cel" .

# Evaluation process
ex:evaluation_2019_06_28T15_04_38
    a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient ;
    sulo:hasParticipant ex:role_EvalProvider ;
    sulo:hasParticipant ex:role_EvalOutput ;
    sulo:atTime ex:time_evaluation .

ex:role_EvalPatient
    a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Aracely_Devon_Collins .

ex:role_EvalProvider
    a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Margaret_Reinger .

ex:role_EvalOutput
    a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_AcuteViralPharyngitis .

ex:time_evaluation
    a sulo:TimeInstant ;
    sulo:hasValue "2019-06-28T15:04:38+02:00"^^xsd:dateTime .

# Diagnostic statement (output)
ex:diag_AcuteViralPharyngitis
    a chr:DiagnosticStatement ;
    rdfs:label "Acute viral pharyngitis (SNOMED: 195662009)" .

# Care plan
ex:careplan_2019_06_28
    a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowupMonitoring .

ex:procedure_FollowupMonitoring
    a chr:MedicalProcedure ;
    rdfs:label "follow‑up monitoring and routine review" .