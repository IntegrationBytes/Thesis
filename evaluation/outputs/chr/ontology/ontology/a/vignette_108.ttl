# Persons
ex:person_Aracely_Devon_Collins a chr:Person .
ex:person_Margaret_Reinger a chr:Person .

# Care unit
ex:careunit_CarneyHospital a chr:CareUnit .

# Clinical visit
ex:visit_2022_04_01T15_04_38p02_00 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit_Patient ,
                       ex:role_Provider_Visit_Physician ;
    sulo:isIn ex:careunit_CarneyHospital ;
    sulo:atTime ex:time_visit_2022_04_01T15_04_38p02_00 .

ex:role_Subject_Visit_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Aracely_Devon_Collins .

ex:role_Provider_Visit_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Margaret_Reinger .

ex:time_visit_2022_04_01T15_04_38p02_00 sulo:hasValue "2022-04-01T15:04:38+02:00"^^xsd:dateTime .

# Process status (shared)
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_mg_per_dL a chr:Unit .
ex:unit_mmol_per_L a chr:Unit .
ex:unit_cm a chr:Unit .
ex:unit_kg a chr:Unit .
ex:unit_kg_per_m2 a chr:Unit .
ex:unit_mL_per_min_per_1_73_m2 a chr:Unit .
ex:unit_score a chr:Unit .
ex:unit_nominal a chr:Unit .
ex:unit_pH a chr:Unit .
ex:unit_percent a chr:Unit .
ex:unit_per_min a chr:Unit .

# Helper role for patient in measurements
ex:role_Subject_Measurement a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Aracely_Devon_Collins .

