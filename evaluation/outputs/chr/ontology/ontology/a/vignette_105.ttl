# Persons
ex:patient_Aracely_Devon_Collins a chr:Person ;
    rdfs:label "Aracely711 Devon268 Collins926" .

ex:physician_Edmundo_Eichmann a chr:Person ;
    rdfs:label "Dr. Edmundo94 Eichmann909" .

# Care unit
ex:careunit_FatherBillsPlace a chr:CareUnit ;
    rdfs:label "FATHER BILL'S PLACE" .

# Time instants
ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2020-06-26T15:04:38+02:00"^^xsd:dateTime .

ex:time_eval1 a sulo:TimeInstant ;
    sulo:hasValue "2020-06-26T15:04:38+02:00"^^xsd:dateTime .

ex:time_eval2 a sulo:TimeInstant ;
    sulo:hasValue "2020-06-26T15:51:12+02:00"^^xsd:dateTime .

# Process status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Roles for the clinical visit
ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Edmundo_Eichmann .

# Clinical visit
ex:visit_2020_06_26T15_04_38 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_FatherBillsPlace .

# Units
