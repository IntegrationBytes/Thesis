@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Estela rdf:type chr:Person .
ex:person_Nickolas rdf:type chr:Person .

# Care unit
ex:careUnit_ENCOMPASS rdf:type chr:CareUnit .

# Clinical visit
ex:visit_2008_10_18 rdf:type chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Estela ,
                        ex:role_VisitProvider_Nickolas ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careUnit_ENCOMPASS .

ex:role_VisitPatient_Estela rdf:type chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela .

ex:role_VisitProvider_Nickolas rdf:type chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas .

ex:time_visit rdf:type sulo:TimeInstant ;
    sulo:hasValue "2008-10-18T21:35:54+02:00"^^xsd:dateTime .

# Measurement 1 (Size.maximum dimension in Tumor)
ex:measurementProcess_1 rdf:type chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Meas1Patient_Estela ,
                        ex:role_Meas1Provider_Nickolas ,
                        ex:role_Meas1Output ;
    sulo:atTime ex:time_measurement1 ;
    sulo:hasFeature ex:status_completed .

ex:role_Meas1Patient_Estela rdf:type chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela .

ex:role_Meas1Provider_Nickolas rdf:type chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas .

ex:role_Meas1Output rdf:type chr:OutputRole ;
    sulo:isFeatureOf ex:measurement1 .

ex:measurement1 rdf:type chr:Measurement ;
    sulo:hasValue "3.5292"^^xsd:float ;
    sulo:hasPart ex:unit_cm .

ex:unit_cm rdf:type chr:Unit .

ex:time_measurement1 rdf:type sulo:TimeInstant ;
    sulo:hasValue "2008-10-18T22:53:33+02:00"^^xsd:dateTime .

# Measurement 2 (Lymph nodes with isolated tumor cells)
ex:measurementProcess_2 rdf:type chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Meas2Patient_Estela ,
                        ex:role_Meas2Provider_Nickolas ,
                        ex:role_Meas2Output ;
    sulo:atTime ex:time_measurement2 ;
    sulo:hasFeature ex:status_completed .

ex:role_Meas2Patient_Estela rdf:type chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela .

ex:role_Meas2Provider_Nickolas rdf:type chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas .

ex:role_Meas2Output rdf:type chr:OutputRole ;
    sulo:isFeatureOf ex:measurement2 .

ex:measurement2 rdf:type chr:Measurement ;
    sulo:hasValue "0"^^xsd:float ;
    sulo:hasPart ex:unit_none .

ex:unit_none rdf:type chr:Unit .

ex:time_measurement2 rdf:type sulo:TimeInstant ;
    sulo:hasValue "2008-10-18T22:53:33+02:00"^^xsd:dateTime .

# Process status
ex:status_completed rdf:type chr:ProcessStatus .

# Evaluation (diagnostic statement)
ex:evaluationProcess_1 rdf:type chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient_Estela ,
                        ex:role_EvalProvider_Nickolas ,
                        ex:role_EvalOutput ;
    sulo:atTime ex:time_visit .

ex:role_EvalPatient_Estela rdf:type chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela .

ex:role_EvalProvider_Nickolas rdf:type chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas .

ex:role_EvalOutput rdf:type chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement1 .

ex:diagnosticStatement1 rdf:type chr:DiagnosticStatement .

# Clinical condition (recorded on same time as evaluation)
ex:condition1 rdf:type chr:ClinicalCondition ;
    sulo:atTime ex:time_visit .

# Care plan
ex:carePlan1 rdf:type chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup rdf:type chr:MedicalProcedure .