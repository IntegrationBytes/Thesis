@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Harvey a chr:Person ;
    rdfs:label "Harvey63 Napoleon578 Homenick806" .

ex:physician_Assunta a chr:Person ;
    rdfs:label "Dr. Assunta351 Haley279" .

# Care unit
ex:careunit_CHFS a chr:CareUnit ;
    rdfs:label "CHILD & FAMILY SERVICES, INC." .

# Clinical visit
ex:visit_2017_07_07 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit ;
    sulo:hasParticipant ex:role_Provider_Visit ;
    sulo:isIn ex:careunit_CHFS ;
    sulo:atTime ex:time_visit .

ex:role_Subject_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_Provider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Assunta .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2017-07-07T20:30:59+02:00"^^xsd:dateTime .

# Process status (shared)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_percent a sulo:Unit ; rdfs:label "%" .
ex:unit_cm a sulo:Unit ; rdfs:label "cm" .
ex:unit_kg a sulo:Unit ; rdfs:label "kg" .
ex:unit_kg_per_m2 a sulo:Unit ; rdfs:label "kg/m2" .
ex:unit_per_min a sulo:Unit ; rdfs:label "/min" .
ex:unit_mg_per_dL a sulo:Unit ; rdfs:label "mg/dL" .
ex:unit_mmol_per_L a sulo:Unit ; rdfs:label "mmol/L" .
ex:unit_score a sulo:Unit ; rdfs:label "score" .

# Helper: shared status role for all processes (optional)
# (Each process will reference ex:status_completed directly.)

# Measurement: Hemoglobin A1c
ex:process_HbA1c a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_HbA1c ;
    sulo:hasParticipant ex:role_Provider_HbA1c ;
    sulo:hasParticipant ex:role_Output_HbA1c ;
    sulo:atTime ex:time_HbA1c ;
    sulo:hasFeature ex:status_completed .

ex:role_Subject_HbA1c a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_Provider_HbA1c a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Assunta .

ex:role_Output_HbA1c a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HbA1c .

ex:measurement_HbA1c a chr:Measurement ;
    sulo:hasValue "6.02"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_HbA1c .

ex:time_HbA1c a sulo:TimeInstant ;
    sulo:hasValue "2017-07-07T20:30:59+02:00"^^xsd:dateTime .

