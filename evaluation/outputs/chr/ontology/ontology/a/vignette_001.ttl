@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Angelic_Callie_Schaden a chr:Person .
ex:physician_Willian_Batz a chr:Person .

# Care unit
ex:careunit_Boston_Medical_Center a chr:CareUnit .

# Clinical visit
ex:visit_2016_08_07 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider ;
    sulo:isIn ex:careunit_Boston_Medical_Center ;
    sulo:atTime ex:time_visit_2016_08_07 .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Angelic_Callie_Schaden .
ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Willian_Batz .

ex:time_visit_2016_08_07 sulo:hasValue "2016-08-07T06:24:27+02:00"^^xsd:dateTime .

# Temperature measurement process
ex:process_measurement_body_temp_2016_08_07 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasureSubject , ex:role_MeasurePerformer , ex:role_MeasureOutput ;
    sulo:atTime ex:time_measurement_2016_08_07 ;
    sulo:hasFeature ex:status_completed .

ex:role_MeasureSubject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Angelic_Callie_Schaden .
ex:role_MeasurePerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Willian_Batz .
ex:role_MeasureOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_body_temp_2016_08_07 .

ex:status_completed a chr:ProcessStatus .

ex:time_measurement_2016_08_07 sulo:hasValue "2016-08-07T06:24:27+02:00"^^xsd:dateTime .

# Measurement result
ex:measurement_body_temp_2016_08_07 a chr:Measurement ;
    sulo:hasValue "37.816"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_measurement_2016_08_07 .

ex:unit_Celsius a chr:Unit .

# Evaluation process
ex:evaluation_2016_08_07 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalSubject , ex:role_EvalPerformer , ex:role_EvalOutput ;
    sulo:atTime ex:time_evaluation_2016_08_07 .

ex:role_EvalSubject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Angelic_Callie_Schaden .
ex:role_EvalPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Willian_Batz .
ex:role_EvalOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_acute_viral_pharyngitis_2016_08_07 .

ex:time_evaluation_2016_08_07 sulo:hasValue "2016-08-07T06:24:27+02:00"^^xsd:dateTime .

# Diagnostic statement
ex:diag_acute_viral_pharyngitis_2016_08_07 a chr:DiagnosticStatement .

# Care plan and referenced procedure
ex:careplan_2016_08_07 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup_monitoring .

ex:procedure_followup_monitoring a chr:MedicalProcedure .