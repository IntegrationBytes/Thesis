ex:evaluation_process
  a chr:EvaluationProcess ;
  sulo:hasParticipant ex:role_patient_evaluation ;
  sulo:hasParticipant ex:role_performer_evaluation ;
  sulo:hasParticipant ex:role_output_evaluation ;
  sulo:atTime ex:time_evaluation ;
  sulo:hasFeature ex:severity_moderate .

ex:role_patient_evaluation
  a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Cory323 .

