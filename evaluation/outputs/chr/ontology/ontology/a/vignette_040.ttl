ex:polyp_size_measurement_process
  a chr:MeasurementProcess ;
  sulo:hasParticipant ex:role_patient_polyp_size_measurement ;
  sulo:hasParticipant ex:role_output_polyp_size_measurement ;
  sulo:atTime ex:time_polyp_size_measurement ;
  sulo:hasFeature ex:process_status_completed_polyp_size .

ex:role_patient_polyp_size_measurement
  a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Cory323 .

ex:role_output_polyp_size_measurement
  a chr:OutputRole ;
  sulo:isFeatureOf ex:polyp_size_measurement .

ex:polyp_size_measurement
  a chr:Measurement ;
  sulo:hasValue "11.962"^^xsd:float ;
  sulo:hasPart ex:unit_mm ;
  sulo:atTime ex:time_polyp_size_measurement .

ex:unit_mm
  a sulo:Unit ;
  rdfs:label "mm" .

ex:time_polyp_size_measurement
  sulo:hasValue "2017-04-11T15:00:00"^^xsd:dateTime .

ex:process_status_completed_polyp_size
  a chr:ProcessStatus ;
  rdfs:label "completed" .

ex:stool_measurement_process
  a chr:MeasurementProcess ;
  sulo:hasParticipant ex:role_patient_stool_measurement ;
  sulo:hasParticipant ex:role_output_stool_measurement ;
  sulo:atTime ex:time_stool_measurement ;
