ex:visit_2017_04_11
  a chr:ClinicalVisit ;
  sulo:atTime ex:time_visit_2017_04_11 ;
  sulo:isIn ex:care_unit_lowell .

ex:time_visit_2017_04_11
  sulo:hasValue "2017-04-11T14:32:00"^^xsd:dateTime .

ex:care_unit_lowell
  a chr:CareUnit ;
  rdfs:label "THE LOWELL GENERAL HOSPITAL" .

ex:patient_Cory323
  a chr:Person ;
  rdfs:label "Cory323 Frank378 Heller342" .

