    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

# Measurement processes (one example shown; analogous processes for each measurement)
ex:process_height_2022_09_22 a chr:MeasurementProcess ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 ;
    sulo:hasFeature ex:status_completed_2022_09_22 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Height ;
    sulo:hasParticipant ex:role_Performer_Height ;
    sulo:hasParticipant ex:role_Output_Height .

ex:role_SubjectOfCare_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma583_Adriane398_Huel628 .

ex:role_Performer_Height a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Drew592_Simonis280 .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_height_2022_09_22 .

# (Similar process, subject, performer, and output roles are defined for each of the other measurements;
# they follow the same pattern, e.g., ex:process_pain_2022_09_22, ex:role_SubjectOfCare_Pain, etc.)

# Evaluation process
ex:evaluation_2022_09_22 a chr:EvaluationProcess ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval ;
    sulo:hasParticipant ex:role_Performer_Eval ;
    sulo:hasParticipant ex:role_Output_Eval .

ex:role_SubjectOfCare_Eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma583_Adriane398_Huel628 .

ex:role_Performer_Eval a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Drew592_Simonis280 .

ex:role_Output_Eval a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_MedicationReview .

ex:diagnostic_MedicationReview a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" .

# Care plan
ex:careplan_2022_09_22 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup_monitoring .

ex:procedure_followup_monitoring a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .