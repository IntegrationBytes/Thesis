@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Delma583_Adriane398_Huel628 a chr:Person .
ex:person_Drew592_Simonis280 a chr:Person .

# Care unit
ex:careunit_HarborHealth a chr:CareUnit .

# Clinical visit
ex:visit_2022_09_22_T08_12_57 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_HarborHealth ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:time_visit_2022_09_22_T08_12_57 a sulo:TimeInstant ;
    sulo:hasValue "2022-09-22T08:12:57+02:00"^^xsd:dateTime .

# Process status (completed)
ex:status_completed_2022_09_22 a chr:ProcessStatus .

# Units
ex:unit_cm          a chr:Unit .
ex:unit_kg          a chr:Unit .
ex:unit_percent     a chr:Unit .
ex:unit_kg_per_m2   a chr:Unit .
ex:unit_per_min     a chr:Unit .
ex:unit_score       a chr:Unit .

# Severity for pain
ex:severity_0 a chr:Severity .

# Measurements
ex:measurement_height_2022_09_22 a chr:Measurement ;
    sulo:hasValue "90.6"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_pain_2022_09_22 a chr:Measurement ;
    sulo:hasValue "0"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 ;
    sulo:hasFeature ex:severity_0 .

ex:measurement_weight_2022_09_22 a chr:Measurement ;
    sulo:hasValue "14"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_wfl_2022_09_22 a chr:Measurement ;
    sulo:hasValue "77.9"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_hc_percentile_2022_09_22 a chr:Measurement ;
    sulo:hasValue "24.46"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_hc_length_2022_09_22 a chr:Measurement ;
    sulo:hasValue "47.51"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_bmi_ratio_2022_09_22 a chr:Measurement ;
    sulo:hasValue "17.03"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_bmi_percentile_2022_09_22 a chr:Measurement ;
    sulo:hasValue "82.118"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_hr_2022_09_22 a chr:Measurement ;
    sulo:hasValue "79"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit_2022_09_22_T08_12_57 .

ex:measurement_rr_2022_09_22 a chr:Measurement ;
