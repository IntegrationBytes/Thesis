@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:patient_Estela596_Yetta429_Grant908 a chr:Person .

ex:visit_2007_05_07 a chr:ClinicalVisit ;
  sulo:atTime ex:time_visit_2007_05_07 ;
  sulo:isIn ex:care_unit_braintree .

ex:time_visit_2007_05_07 a sulo:TimeInstant ;
  sulo:hasValue "2007-05-07T03:35:00"^^xsd:dateTime .

ex:care_unit_braintree a chr:CareUnit .

ex:body_temp_measurement a chr:MeasurementProcess ;
  sulo:hasParticipant ex:role_patient_body_temp ;
  sulo:hasParticipant ex:role_output_body_temp ;
  sulo:atTime ex:time_body_temp_measurement .

ex:role_patient_body_temp a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Estela596_Yetta429_Grant908 .

ex:role_output_body_temp a chr:OutputRole ;
  sulo:isFeatureOf ex:body_temp_result .

ex:body_temp_result a chr:Measurement ;
  sulo:hasValue "38.234"^^xsd:float ;
  sulo:hasPart ex:unit_cel ;
  sulo:atTime ex:time_body_temp_measurement .

ex:unit_cel a sulo:Unit .

ex:time_body_temp_measurement a sulo:TimeInstant ;
  sulo:hasValue "2007-05-07T03:35:00"^^xsd:dateTime .

ex:evaluation_2007_05_07 a chr:EvaluationProcess ;
  sulo:hasParticipant ex:role_patient_evaluation ;
  sulo:hasParticipant ex:role_performer_schumm ;
  sulo:hasParticipant ex:role_output_strep_diagnosis ;
  sulo:atTime ex:time_evaluation .

ex:role_patient_evaluation a chr:SubjectOfCareRole ;
  sulo:isFeatureOf ex:patient_Estela596_Yetta429_Grant908 .

ex:role_performer_schumm a chr:PerformerRole ;
  sulo:isFeatureOf ex:dr_schumm .

ex:dr_schumm a chr:Person .

ex:role_output_strep_diagnosis a chr:OutputRole ;
  sulo:isFeatureOf ex:strep_diagnosis .

ex:strep_diagnosis a chr:DiagnosticStatement ;
  sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity .

ex:time_evaluation a sulo:TimeInstant ;
  sulo:hasValue "2007-05-07T03:35:00"^^xsd:dateTime .

ex:condition_strep_throat a chr:ClinicalCondition ;
  sulo:atTime ex:time_condition_recorded .

ex:time_condition_recorded a sulo:TimeInstant ;
  sulo:hasValue "2007-05-07T03:35:00"^^xsd:dateTime .

ex:care_plan a chr:CarePlan ;
  sulo:refersTo ex:follow_up_monitoring , ex:routine_review .

ex:follow_up_monitoring a chr:MedicalProcedure .

ex:routine_review a chr:MedicalProcedure .