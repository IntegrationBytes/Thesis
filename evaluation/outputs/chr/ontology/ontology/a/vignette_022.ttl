# Measurements (one example shown, others follow the same pattern)
# Activated clotting time (ACT)
ex:measurement_ACT_2025_08_17 a chr:Measurement ;
    sulo:hasValue "111.83"^^xsd:float ;
    sulo:hasPart ex:unit_seconds .

ex:process_ACT_2025_08_17 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_measure_ACT ,
                       ex:output_role_ACT ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2025_08_17 .

ex:role_subject_measure_ACT a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_arturo .

ex:output_role_ACT a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_ACT_2025_08_17 .

