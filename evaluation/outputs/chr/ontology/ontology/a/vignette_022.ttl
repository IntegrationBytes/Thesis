@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_arturo a chr:Person ;
    rdfs:label "Arturo47 Lauren941 Heidenreich818" .

ex:person_manuela a chr:Person ;
    rdfs:label "Dr. Manuela585 Rendón540" .

# Care unit
ex:careunit_fitchburg a chr:CareUnit ;
    rdfs:label "Fitchburg Outpatient Clinic" .

# Clinical visit
ex:visit_2025_08_17 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_subject_visit_arturo ,
                       ex:role_performer_visit_manuela ;
    sulo:atTime ex:time_visit_2025_08_17 ;
    sulo:isIn ex:careunit_fitchburg .

ex:role_subject_visit_arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_arturo .

ex:role_performer_visit_manuela a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_manuela .

ex:time_visit_2025_08_17 a sulo:TimeInstant ;
    sulo:hasValue "2025-08-17T17:39:35+02:00"^^xsd:dateTime .

# Process status (completed)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_seconds a chr:Unit ; rdfs:label "s" .
ex:unit_ph a chr:Unit ; rdfs:label "pH" .
ex:unit_mmHg a chr:Unit ; rdfs:label "mm[Hg]" .
ex:unit_mmol_per_L a chr:Unit ; rdfs:label "mmol/L" .
ex:unit_percent a chr:Unit ; rdfs:label "%" .
ex:unit_mg_per_dL a chr:Unit ; rdfs:label "mg/dL" .
ex:unit_mg a chr:Unit ; rdfs:label "mg" .
ex:unit_ml a chr:Unit ; rdfs:label "mL" .
ex:unit_unt_per_ml a chr:Unit ; rdfs:label "UNT/mL" .

