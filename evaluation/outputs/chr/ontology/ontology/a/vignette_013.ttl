# Persons
ex:patient_Arturo a chr:Person .
ex:physician_AlanKeeling a chr:Person .

# Care unit
ex:careunit_primary_care_north_pc a chr:CareUnit .

# Clinical visit
ex:visit_2019_05_06T02_34_22 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Arturo ,
                       ex:role_VisitProvider_AlanKeeling ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careunit_primary_care_north_pc .

ex:role_VisitPatient_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Arturo .

ex:role_VisitProvider_AlanKeeling a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_AlanKeeling .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-05-06T02:34:22+02:00"^^xsd:dateTime .

# Common status
ex:status_completed a chr:ProcessStatus .

# Units
