@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:patient_Nevarez a chr:Person ;
    rdfs:label "Dolores502 Marisol435 Nevárez403" .

ex:physician_Willms a chr:Person ;
    rdfs:label "Dr. Gregg522 Willms744" .

ex:careunit_Marlborough a chr:CareUnit ;
    rdfs:label "MARLBOROUGH HOSPITAL CORP" .

ex:visit_2017_07_18 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_Marlborough ;
    sulo:atTime ex:time_2017_07_18T05_20_29 .

ex:time_2017_07_18T05_20_29 a sulo:TimeInstant ;
    sulo:hasValue "2017-07-18T05:20:29+02:00"^^xsd:dateTime .

ex:role_Subject_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Nevarez .

ex:role_Provider_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Willms .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:severity_2 a chr:Severity ;
    rdfs:label "2" .

ex:unit_cm a chr:Unit ;
    rdfs:label "cm" .

ex:unit_kg a chr:Unit ;
    rdfs:label "kg" .

ex:unit_kg_per_m2 a chr:Unit ;
