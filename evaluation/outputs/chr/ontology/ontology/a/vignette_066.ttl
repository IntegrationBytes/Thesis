    sulo:atTime ex:time_2017_07_18T05_20_29 .

ex:process_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Patient ;
    sulo:hasParticipant ex:role_Provider_Physician ;
    sulo:atTime ex:time_2017_07_18T05_20_29 ;
    sulo:hasFeature ex:status_completed .

