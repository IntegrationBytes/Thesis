@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Cory_Heller a chr:Person .
ex:person_Hank_Schneider a chr:Person .

# Care unit
ex:careunit_LOWELL a chr:CareUnit .

# Clinical visit
ex:visit_2019_04_21T11_44_05 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Cory ;
    sulo:hasParticipant ex:role_VisitProvider_Hank ;
    sulo:isIn ex:careunit_LOWELL ;
    sulo:atTime ex:time_visit .

ex:role_VisitPatient_Cory a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Heller .

ex:role_VisitProvider_Hank a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Hank_Schneider .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-04-21T11:44:05+02:00"^^xsd:dateTime .

# Common status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_percent      a chr:Unit .
ex:unit_cm           a chr:Unit .
ex:unit_score        a chr:Unit .
ex:unit_kg           a chr:Unit .
ex:unit_kg_per_m2    a chr:Unit .
ex:unit_per_min      a chr:Unit .

# FEV1/FVC measurement
ex:measurement_FEV1 a chr:Measurement ;
    sulo:hasValue "49.314"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_FEV1 .

ex:time_FEV1 a sulo:TimeInstant ;
    sulo:hasValue "2019-04-21T11:44:05+02:00"^^xsd:dateTime .

ex:proc_FEV1 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_FEV1_Patient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_FEV1 .

ex:role_FEV1_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Heller .

