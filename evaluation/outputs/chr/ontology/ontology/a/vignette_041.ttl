@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_CoryFrank a chr:Person .
ex:physician_Hank a chr:Person .

# Roles for the visit
ex:subjectRole_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_CoryFrank .

ex:careProvider_Hank a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Hank .

# Care unit
ex:careUnit_Lowell a chr:CareUnit .

# Clinical visit
ex:visit_2018_04_15 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:subjectRole_patient ;
    sulo:hasParticipant ex:careProvider_Hank ;
    sulo:isIn ex:careUnit_Lowell ;
    sulo:atTime ex:time_visit .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2018-04-15T11:44:05+02:00"^^xsd:dateTime .

# Process status (completed)
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_percent      a chr:Unit .
ex:unit_cm           a chr:Unit .
ex:unit_score        a chr:Unit .
ex:unit_kg           a chr:Unit .
ex:unit_kg_per_m2    a chr:Unit .
ex:unit_per_min      a chr:Unit .
ex:unit_mg_per_dL    a chr:Unit .

# ---- Measurements ----

# 1. FEV1/FVC
ex:measProc_FEV1 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:subjectRole_patient ;
    sulo:hasParticipant ex:careProvider_Hank ;
    sulo:hasParticipant ex:outputRole_FEV1 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_1 .

ex:outputRole_FEV1 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_FEV1 .

ex:measurement_FEV1 a chr:Measurement ;
    sulo:hasValue "60.042"^^xsd:float ;
    sulo:hasPart ex:unit_percent .

ex:time_meas_1 a sulo:TimeInstant ;
    sulo:hasValue "2018-04-15T11:44:05+02:00"^^xsd:dateTime .

# 2. Body Height
ex:measProc_Height a chr:MeasurementProcess ;
