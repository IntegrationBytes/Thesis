# ---- Evaluations (Diagnostic Statements) ----

# Evaluation 1 – Medication review due
ex:evaluation_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:subjectRole_patient ;
    sulo:hasParticipant ex:careProvider_Hank ;
    sulo:hasParticipant ex:outputRole_diag1 ;
    sulo:atTime ex:time_eval_1 .

ex:outputRole_diag1 a chr:OutputRole ;
    sulo:isFeatureOf ex:diagStatement1 .

ex:diagStatement1 a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" .

ex:time_eval_1 a sulo:TimeInstant ;
    sulo:hasValue "2018-04-15T11:44:05+02:00"^^xsd:dateTime .

# Evaluation 2 – Limited social contact
ex:evaluation_2 a chr:EvaluationProcess ;
