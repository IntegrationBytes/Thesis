    sulo:isFeatureOf ex:measurement_Height .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "164"^^xsd:float ;
    sulo:hasPart ex:unit_cm .

ex:time_meas_2 a sulo:TimeInstant ;
    sulo:hasValue "2018-04-15T11:44:05+02:00"^^xsd:dateTime .

