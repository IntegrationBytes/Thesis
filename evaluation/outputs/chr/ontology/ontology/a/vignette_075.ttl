@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Estela_Grant a chr:Person ;
    rdfs:label "Estela596 Yetta429 Grant908" .

ex:person_Nickolas_Schumm a chr:Person ;
    rdfs:label "Dr. Nickolas58 Schumm995" .

# Care unit
ex:careunit_ENCOMPASS a chr:CareUnit ;
    rdfs:label "ENCOMPASS HEALTH BRAINTREE HOSPITAL OF BRAINTREE" .

# Clinical visit
ex:visit_2001_10_18 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider ;
    sulo:atTime ex:time_Visit ;
    sulo:isIn ex:careunit_ENCOMPASS .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2001-10-18T08:35:54+02:00"^^xsd:dateTime .

# Measurement process
ex:measurementProcess_2001_10_18 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPatient , ex:role_MeasProvider , ex:role_MeasOutput ;
    sulo:atTime ex:time_Meas ;
    sulo:hasFeature ex:status_completed .

ex:role_MeasPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_MeasProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

ex:role_MeasOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Temp_2001_10_18 .

ex:time_Meas a sulo:TimeInstant ;
    sulo:hasValue "2001-10-18T08:35:54+02:00"^^xsd:dateTime .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Measurement result
ex:measurement_Temp_2001_10_18 a chr:Measurement ;
    sulo:hasValue "37.393"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_Meas .

ex:unit_Celsius a chr:Unit ;
    rdfs:label "Cel" .

# Evaluation process
ex:evaluation_2001_10_18 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalProvider , ex:role_EvalPatient , ex:role_EvalOutput ;
    sulo:atTime ex:time_Eval .

ex:role_EvalProvider a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_EvalOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_AcuteViralPharyngitis .

ex:time_Eval a sulo:TimeInstant ;
    sulo:hasValue "2001-10-18T08:35:54+02:00"^^xsd:dateTime .

# Diagnostic statement
ex:diag_AcuteViralPharyngitis a chr:DiagnosticStatement ;
    rdfs:label "Acute viral pharyngitis (SNOMED:195662009)" .

# Care plan and referenced procedure
ex:carePlan_2001_10_18 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .