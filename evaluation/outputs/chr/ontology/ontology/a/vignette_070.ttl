# Care unit
ex:careunit_DRHEs a chr:CareUnit ;
    rdfs:label "DR. HE'S PRIMARY CARE FOR ADULTS INC" .

# Clinical visit
ex:visit_2021_11_02 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_visit_patient ;
    sulo:hasParticipant ex:role_visit_provider ;
    sulo:isIn ex:careunit_DRHEs ;
    sulo:atTime ex:time_2021_11_02 .

ex:role_visit_patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_DoloresMarisolNevarez .

ex:role_visit_provider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_CariKohler .

# Common time instant
ex:time_2021_11_02 a sulo:TimeInstant ;
    sulo:hasValue "2021-11-02T04:20:29+01:00"^^xsd:dateTime .

# Process status (completed)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_cm a chr:Unit ;
    rdfs:label "cm" .

ex:unit_kg a chr:Unit ;
    rdfs:label "kg" .

ex:unit_kg_per_m2 a chr:Unit ;
    rdfs:label "kg/m2" .

ex:unit_percent a chr:Unit ;
