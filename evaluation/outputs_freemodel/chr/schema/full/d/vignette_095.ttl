ex:evaluation_2017_07_07_2030 a chr:EvaluationProcess ;
    chr:hasObservation ex:diag_MedicationReview .

ex:evaluation_2017_07_07_2114 a chr:EvaluationProcess ;
    chr:hasObservation ex:diag_Stress .

ex:diag_MedicationReview a chr:DiagnosticStatement .

ex:diag_Stress a chr:DiagnosticStatement .

ex:severity_moderate a chr:Severity .

ex:condition_MedicationReview a chr:ClinicalCondition ;
    chr:hasRecordDate "2017-07-07T20:30:00"^^xsd:dateTime ;
    chr:hasSeverity ex:severity_moderate .

ex:condition_Stress a chr:ClinicalCondition ;
    chr:hasRecordDate "2017-07-07T21:14:00"^^xsd:dateTime ;
    chr:hasSeverity ex:severity_moderate .

