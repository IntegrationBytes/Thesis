ex:patient_Harvey a chr:Person .

ex:careunit_CHILD_FAMILY_SERVICES a chr:CareUnit .

ex:person_Dr_Assunta_Haley a chr:Person .

ex:visit_2017_07_07_2030 a chr:ClinicalVisit ;
    chr:hasCareProvider ex:person_Dr_Assunta_Haley ;
    chr:hasCareUnit ex:careunit_CHILD_FAMILY_SERVICES ;
    chr:hasPatient ex:patient_Harvey .

ex:status_completed a chr:ProcessStatus .

ex:procedure_general_examination a chr:MedicalProcedure ;
    chr:hasPatient ex:patient_Harvey ;
    chr:hasPerformer ex:person_Dr_Assunta_Haley ;
    chr:hasPerformedDate "2017-07-07T20:30:00"^^xsd:dateTime ;
    chr:hasStatus ex:status_completed .

ex:careplan_followup a chr:CarePlan ;
