# Persons
ex:patient_Cory_Heller a chr:Person .
ex:physician_Hank_Schneider a chr:Person .

# Care Unit
ex:careunit_LOWELL a chr:CareUnit .

# Clinical Visit
ex:visit_2020_04_26_1144 a chr:ClinicalVisit ;
    chr:hasCareProvider ex:physician_Hank_Schneider ;
    chr:hasCareUnit ex:careunit_LOWELL ;
    chr:hasPatient ex:patient_Cory_Heller .

# Units
ex:unit_percent a sulo:Unit .
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_per_min a sulo:Unit .
ex:unit_10_3_per_uL a sulo:Unit .
ex:unit_10_6_per_uL a sulo:Unit .
