# Severity
ex:severity_moderate a chr:Severity .

# Diagnostic Statements and Clinical Conditions
ex:diag_fulltime a chr:DiagnosticStatement .
ex:cond_fulltime a chr:ClinicalCondition ;
    chr:hasSeverity ex:severity_moderate ;
    chr:hasRecordDate "2020-04-26T12:29:00"^^xsd:dateTime .

ex:diag_stress a chr:DiagnosticStatement .
ex:cond_stress a chr:ClinicalCondition ;
    chr:hasSeverity ex:severity_moderate ;
    chr:hasRecordDate "2020-04-26T12:29:00"^^xsd:dateTime .

ex:diag_violence a chr:DiagnosticStatement .
ex:cond_violence a chr:ClinicalCondition ;
    chr:hasSeverity ex:severity_moderate ;
    chr:hasRecordDate "2020-04-26T12:29:00"^^xsd:dateTime .

# Evaluation Process
ex:evaluation_2020_04_26_1229 a chr:EvaluationProcess ;
    chr:hasObservation ex:diag_fulltime , ex:diag_stress , ex:diag_violence .

# Care Plan
ex:careplan_2020_04_26 a chr:CarePlan ;
    chr:hasMedicalProcedure ex:procedure_2020_04_26 .

# Medical Procedure
