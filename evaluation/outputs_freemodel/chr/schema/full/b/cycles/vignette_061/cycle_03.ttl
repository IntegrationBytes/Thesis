    chr:hasPatient ex:patient_DelmaHuel ;
    chr:hasResult ex:meas_Height_2021_03_25_07_12 ;
    chr:hasStatus ex:status_completed .

ex:meas_Height_2021_03_25_07_12 a chr:Measurement ;
    chr:hasMeasuredDate "2021-03-25T07:12:00"^^xsd:dateTime ;
    chr:hasQuantityValue "77.3"^^xsd:float ;
    chr:hasUnit sulo:cm .

