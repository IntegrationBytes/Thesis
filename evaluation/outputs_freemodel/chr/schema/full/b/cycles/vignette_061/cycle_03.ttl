@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_DelmaHuel a chr:Person .
ex:physician_DrewSimonis a chr:Person .

# Care unit
ex:unit_HarborHealth a chr:CareUnit .

# Clinical visit
ex:visit_2021_03_25_07_12 a chr:ClinicalVisit ;
    chr:hasCareProvider ex:physician_DrewSimonis ;
    chr:hasCareUnit ex:unit_HarborHealth ;
    chr:hasPatient ex:patient_DelmaHuel .

# Status individuals
ex:status_completed a chr:ProcessStatus .
ex:status_planned   a chr:ProcessStatus .

# Severity
ex:severity_Moderate a chr:Severity .

# Diagnostic statement
ex:diag_MedicationReview a chr:DiagnosticStatement .

# Evaluation process
ex:evaluation_2021_03_25_07_12 a chr:EvaluationProcess ;
    chr:hasCareProvider ex:visit_2021_03_25_07_12 ;
    chr:hasPatient ex:patient_DelmaHuel ;
    chr:hasObservation ex:diag_MedicationReview ;
    chr:hasPerformedDate "2021-03-25T07:12:00"^^xsd:dateTime .

# Clinical condition (medication review)
ex:condition_MedicationReview a chr:ClinicalCondition ;
    chr:hasRecordDate "2021-03-25T07:12:00"^^xsd:dateTime ;
    chr:hasSeverity ex:severity_Moderate .

# Care plan
ex:careplan_2021_03_25 a chr:CarePlan ;
    chr:hasMedicalProcedure ex:proc_FollowUp .

ex:proc_FollowUp a chr:MedicalProcedure ;
    chr:hasStatus ex:status_planned ;
    chr:hasPatient ex:patient_DelmaHuel .

# Measurement processes and results

## Body Height
