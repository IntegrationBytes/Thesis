@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Cory a chr:Person .
ex:person_Schneider a chr:Person .

# Roles
ex:role_SubjectOfCare_Cory a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory .

ex:role_CareProvider_Schneider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Schneider .

# Care unit
ex:careunit_LOWELL a chr:CareUnit .

# Clinical visit
ex:visit_2023_05_14_1144 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Cory ,
                       ex:role_CareProvider_Schneider ;
    sulo:atTime ex:time_visit_2023_05_14_1144 ;
    sulo:isIn ex:careunit_LOWELL .

ex:time_visit_2023_05_14_1144 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-14T11:44:00"^^xsd:dateTime .

# Process status (shared)
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_percent a sulo:Unit .
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_kg_per_m2 a sulo:Unit .
ex:unit_per_min a sulo:Unit .
ex:unit_score a sulo:Unit .

# Measurements and their processes

## FEV1/FVC
ex:proc_FEV1_2023_05_14_1144 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Cory ;
    sulo:hasParticipant ex:role_Output_FEV1 ;
    sulo:atTime ex:time_visit_2023_05_14_1144 ;
    sulo:hasFeature ex:status_completed .

ex:role_Output_FEV1 a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_FEV1 .

ex:meas_FEV1 a chr:Measurement ;
    sulo:hasValue "38.727"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit_2023_05_14_1144 .

