# Evaluation (diagnostic statement)
ex:evaluation_2023_05_14_1234 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_CareProvider_Schneider ,
                       ex:role_SubjectOfCare_Cory ,
                       ex:role_Output_Diagnosis ;
    sulo:atTime ex:time_evaluation_2023_05_14_1234 .

ex:time_evaluation_2023_05_14_1234 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-14T12:34:00"^^xsd:dateTime .

ex:role_Output_Diagnosis a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_FullTimeEmployment .

ex:diag_FullTimeEmployment a chr:DiagnosticStatement .

ex:severity_moderate a chr:Severity .

ex:cond_FullTimeEmployment a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_moderate .

# Care plan
ex:careplan_2023_05_14 a chr:CarePlan ;
    sulo:refersTo ex:proc_FollowUpMonitoring .

ex:proc_FollowUpMonitoring a chr:MedicalProcedure .