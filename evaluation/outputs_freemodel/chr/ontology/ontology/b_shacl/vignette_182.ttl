# Clinical visit
ex:visit_2013_01_30_1547 a chr:ClinicalVisit ;
    sulo:atTime ex:time_2013_01_30_1547 ;
    sulo:hasParticipant ex:role_VisitSubject_Patient ,
                       ex:role_VisitProvider_Physician .

ex:role_VisitSubject_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Bryant_Clarence_Grimes .

ex:role_VisitProvider_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Dana_Wilkinson .

ex:time_2013_01_30_1547 a sulo:TimeInstant ;
