# Persons
ex:person_Dolores_Nevarez a chr:Person ;
    rdfs:label "Dolores502 Marisol435 Nevárez403" .

ex:person_Cari_Kohler a chr:Person ;
    rdfs:label "Dr. Cari853 Kohler843" .

# Care unit
ex:careUnit_DRHE a chr:CareUnit ;
    rdfs:label "DR. HE'S PRIMARY CARE FOR ADULTS INC" .

# Clinical visit
ex:visit_2018_10_16_05_20 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Dolores ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Cari ;
    sulo:atTime ex:time_Visit_2018_10_16_05_20 ;
    sulo:isIn ex:careUnit_DRHE .

ex:role_SubjectOfCare_Visit_Dolores a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_CareProvider_Visit_Cari a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Cari_Kohler .

ex:time_Visit_2018_10_16_05_20 a sulo:TimeInstant ;
    sulo:hasValue "2018-10-16T05:20:00"^^xsd:dateTime .

