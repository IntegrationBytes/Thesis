# Person (patient)
ex:person_Aracely_Devon_Collins
    a chr:Person ;
    rdfs:label "Aracely711 Devon268 Collins926" .

# Person (physician)
ex:person_Margaret_Reinger
    a chr:Person ;
    rdfs:label "Dr. Margaret865 Reinger292" .

# Care unit
ex:careunit_Carney_Hospital
    a chr:CareUnit ;
    rdfs:label "CARNEY HOSPITAL" .

# Clinical visit
ex:visit_2025_11_14_1404
    a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_VisitPatient ;
    sulo:hasParticipant ex:role_CareProvider_AttendingPhysician ;
    sulo:isIn ex:careunit_Carney_Hospital ;
    sulo:atTime ex:time_2025_11_14_1404 .

# Roles for visit
ex:role_SubjectOfCare_VisitPatient
    a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Aracely_Devon_Collins .

ex:role_CareProvider_AttendingPhysician
    a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Margaret_Reinger .

# Time instant for visit and many measurements
ex:time_2025_11_14_1404
    a sulo:TimeInstant ;
    sulo:hasValue "2025-11-14T14:04:00"^^xsd:dateTime .

# Process status (completed)
ex:status_completed
    a chr:ProcessStatus ;
    rdfs:label "completed" .

# Severity (moderate)
ex:severity_moderate
    a chr:Severity ;
    rdfs:label "Moderate" .

# Units
ex:unit_mg_per_dL   a sulo:Unit ; rdfs:label "mg/dL" .
ex:unit_mmol_per_L  a sulo:Unit ; rdfs:label "mmol/L" .
ex:unit_cm          a sulo:Unit ; rdfs:label "cm" .
ex:unit_kg          a sulo:Unit ; rdfs:label "kg" .
ex:unit_kg_per_m2   a sulo:Unit ; rdfs:label "kg/m2" .
ex:unit_mL_per_min_per_m2 a sulo:Unit ; rdfs:label "mL/min/1.73 m2" .
ex:unit_score       a sulo:Unit ; rdfs:label "score" .
ex:unit_nominal     a sulo:Unit ; rdfs:label "nominal" .
ex:unit_pH          a sulo:Unit ; rdfs:label "pH" .
ex:unit_percent     a sulo:Unit ; rdfs:label "%" .
ex:unit_per_min     a sulo:Unit ; rdfs:label "/min" .

