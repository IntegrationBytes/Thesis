@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://wuid.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Arturo47 a chr:Person ;
    rdfs:label "Arturo47 Lauren941 Heidenreich818" .

ex:person_Louis204 a chr:Person ;
    rdfs:label "Dr. Louis204 Hauck852" .

# Care unit
ex:careunit_whittier a chr:CareUnit ;
    rdfs:label "WHITTIER REHABILTATION HOSPITAL" .

# Clinical visit
ex:visit_2019-06-05_12-34 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_whittier ;
    sulo:atTime ex:time_visit .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-06-05T12:34:00"^^xsd:dateTime .

# Roles for the visit (measurement process)
ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Louis204 .

ex:role_MeasOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_001 .

# Measurement process
ex:measurement_process_001 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider , ex:role_MeasOutput ;
    sulo:atTime ex:time_meas ;
    sulo:hasFeature ex:status_completed .

ex:time_meas a sulo:TimeInstant ;
    sulo:hasValue "2019-06-05T12:34:00"^^xsd:dateTime .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Measurement result
ex:measurement_001 a chr:Measurement ;
    sulo:hasValue "37.53"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_meas .

ex:unit_Celsius a sulo:Unit ;
    rdfs:label "Celsius" .

# Evaluation process
ex:evaluation_001 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient , ex:role_EvalProvider , ex:role_EvalOutput ;
    sulo:atTime ex:time_eval ;
    sulo:hasFeature ex:status_moderate .

ex:time_eval a sulo:TimeInstant ;
    sulo:hasValue "2019-06-05T12:34:00"^^xsd:dateTime .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_EvalProvider a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Louis204 .

ex:role_EvalOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_001 .

# Diagnostic statement
ex:diagnostic_001 a chr:DiagnosticStatement ;
    rdfs:label "Acute viral pharyngitis" .

# Clinical condition with severity
ex:condition_001 a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Process status for evaluation (aligned with ProcessStatus class)
ex:status_moderate a chr:ProcessStatus ;
    rdfs:label "moderate" .

# Care plan
ex:careplan_001 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .