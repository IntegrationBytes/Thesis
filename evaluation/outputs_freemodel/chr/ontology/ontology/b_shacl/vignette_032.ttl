    sulo:isFeatureOf ex:diagnostic_PolypColon .

ex:diagnostic_PolypColon a chr:DiagnosticStatement .

ex:time_eval_2021_11_12_22_48 sulo:hasValue "2021-11-12T22:48:00"^^xsd:dateTime .

# Clinical condition with severity
ex:condition_PolypColon a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_Moderate .

ex:severity_Moderate a chr:Severity .

# Care plan and referenced procedure
ex:careplan_2021_11_12 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

