# Persons
ex:person_Casey401_Elijah719_Parker433 a chr:Person .
ex:person_Rhett759_Padberg411 a chr:Person .

# Care unit
ex:careunit_VIBRA a chr:CareUnit .

# Clinical visit
ex:visit_2021_11_12_22_03 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Casey ;
    sulo:hasParticipant ex:role_VisitProvider_Rhett ;
    sulo:isIn ex:careunit_VIBRA ;
    sulo:atTime ex:time_visit_2021_11_12_22_03 .

ex:role_VisitPatient_Casey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

ex:role_VisitProvider_Rhett a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Rhett759_Padberg411 .

ex:time_visit_2021_11_12_22_03 sulo:hasValue "2021-11-12T22:03:00"^^xsd:dateTime .

# Polyp size measurement process
ex:proc_MeasurePolypSize a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPatient_Casey ;
    sulo:hasParticipant ex:role_MeasOutput_PolypSize ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_2021_11_12_22_48 .

ex:role_MeasPatient_Casey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

ex:role_MeasOutput_PolypSize a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_PolypSize .

ex:measurement_PolypSize a chr:Measurement ;
    sulo:hasValue "2.4093"^^xsd:float ;
    sulo:hasPart ex:unit_mm ;
    sulo:atTime ex:time_meas_2021_11_12_22_48 .

ex:unit_mm a sulo:Unit .

ex:time_meas_2021_11_12_22_48 sulo:hasValue "2021-11-12T22:48:00"^^xsd:dateTime .

# Hemoglobin measurement process
ex:proc_MeasureHemoglobin a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_HbPatient_Casey ;
    sulo:hasParticipant ex:role_HbOutput_Hemoglobin ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_2021_11_12_22_48 .

ex:role_HbPatient_Casey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

ex:role_HbOutput_Hemoglobin a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Hemoglobin .

ex:measurement_Hemoglobin a chr:Measurement ;
    sulo:hasValue "24.389"^^xsd:float ;
    sulo:hasPart ex:unit_ng_per_mL ;
    sulo:atTime ex:time_meas_2021_11_12_22_48 .

ex:unit_ng_per_mL a sulo:Unit .

# Evaluation process
ex:evaluation_2021_11_12_22_48 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient_Casey ;
    sulo:hasParticipant ex:role_EvalPerformer_Rhett ;
    sulo:hasParticipant ex:role_EvalOutput_DiagPolyp ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_eval_2021_11_12_22_48 .

ex:role_EvalPatient_Casey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Casey401_Elijah719_Parker433 .

