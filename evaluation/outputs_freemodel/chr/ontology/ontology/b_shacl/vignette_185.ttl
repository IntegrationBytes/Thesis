# Care unit
ex:careunit_UrgentCarePC a chr:CareUnit .

# Time instant (shared)
ex:time_2013_02_27_1547 sulo:hasValue "2013-02-27T15:47:00"^^xsd:dateTime .

# Clinical visit
ex:visit_2013_02_27_1547 a chr:ClinicalVisit ;
    sulo:atTime ex:time_2013_02_27_1547 ;
    sulo:isIn ex:careunit_UrgentCarePC ;
    sulo:hasParticipant ex:role_SubjectOfCare_Bryant , ex:role_CareProvider_Dana .

# Process status
