@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Arturo a chr:Person ;
    rdfs:label "Arturo47 Lauren941 Heidenreich818" .

# Person (physician)
ex:person_Louis a chr:Person ;
    rdfs:label "Dr. Louis204 Hauck852" .

# Care unit
ex:careUnit_Whittier a chr:CareUnit ;
    rdfs:label "WHITTIER REHABILTATION HOSPITAL" .

# Clinical visit
ex:visit_2023_04_26_00_34 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Arturo ,
                       ex:role_CareProvider_Visit_Louis ;
    sulo:atTime ex:time_Visit_2023_04_26_00_34 ;
    sulo:isIn ex:careUnit_Whittier .

ex:role_SubjectOfCare_Visit_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_Visit_Louis a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Louis .

ex:time_Visit_2023_04_26_00_34 a sulo:TimeInstant ;
    sulo:hasValue "2023-04-26T00:34:00"^^xsd:dateTime .

# Measurement process
ex:measurementProcess_2023_04_26_00_34 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Meas_Arturo ,
                       ex:role_Output_Meas_Temp ;
    sulo:atTime ex:time_Meas_2023_04_26_00_34 ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_Meas_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Output_Meas_Temp a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Temp .

ex:measurement_Temp a chr:Measurement ;
    sulo:hasValue "37.632"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_Meas_2023_04_26_00_34 .

ex:unit_Celsius a sulo:Unit ;
    rdfs:label "Cel" .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:time_Meas_2023_04_26_00_34 a sulo:TimeInstant ;
    sulo:hasValue "2023-04-26T00:34:00"^^xsd:dateTime .

# Evaluation process
ex:evaluation_2023_04_26_00_34 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval_Arturo ,
                       ex:role_CareProvider_Eval_Louis ,
                       ex:role_Output_Eval_Dx ;
    sulo:atTime ex:time_Eval_2023_04_26_00_34 .

ex:role_SubjectOfCare_Eval_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_Eval_Louis a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Louis .

ex:role_Output_Eval_Dx a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement_AcuteViralPharyngitis .

ex:diagnosticStatement_AcuteViralPharyngitis a chr:DiagnosticStatement ;
    rdfs:label "Acute viral pharyngitis" .

ex:time_Eval_2023_04_26_00_34 a sulo:TimeInstant ;
    sulo:hasValue "2023-04-26T00:34:00"^^xsd:dateTime .

# Clinical condition
ex:condition_AcuteViralPharyngitis a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_Moderate ;
    sulo:atTime ex:time_ConditionRecorded_2023_04_26_00_34 .

ex:severity_Moderate a chr:Severity ;
    rdfs:label "Moderate" .

ex:time_ConditionRecorded_2023_04_26_00_34 a sulo:TimeInstant ;
    sulo:hasValue "2023-04-26T00:34:00"^^xsd:dateTime .

# Care plan
ex:carePlan_FollowUp a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .