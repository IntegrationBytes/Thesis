@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Arturo a chr:Person .

# Person (provider)
ex:person_Brian a chr:Person .

# Roles
ex:role_Subject_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Provider_Brian a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Brian .

# Clinical visit
ex:visit_20251124_0134 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Arturo , ex:role_Provider_Brian ;
    sulo:atTime ex:time_visit_20251124_0134 .

ex:time_visit_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

# Common status
ex:status_completed a chr:ProcessStatus .

# Units (examples)
ex:unit_percent a sulo:Unit .
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_kg_per_m2 a sulo:Unit .
ex:unit_per_min a sulo:Unit .
ex:unit_mg_per_dL a sulo:Unit .
ex:unit_mmol_per_L a sulo:Unit .
ex:unit_mL_per_min_per_m2 a sulo:Unit .
ex:unit_score a sulo:Unit .

# Measurement processes and measurements (selected examples; pattern repeats for each)

# Hemoglobin A1c
ex:proc_HbA1c_20251124_0134 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_HbA1c_20251124_0134 .

ex:time_meas_HbA1c_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

ex:meas_HbA1c_20251124_0134 a chr:Measurement ;
    sulo:hasValue "6.87"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_meas_HbA1c_20251124_0134 .

# Body Height
ex:proc_Height_20251124_0134 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_Height_20251124_0134 .

ex:time_meas_Height_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

ex:meas_Height_20251124_0134 a chr:Measurement ;
    sulo:hasValue "181.4"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_meas_Height_20251124_0134 .

# Pain severity
ex:proc_Pain_20251124_0134 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_Pain_20251124_0134 .

ex:time_meas_Pain_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

ex:meas_Pain_20251124_0134 a chr:Measurement ;
    sulo:hasValue "3"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_meas_Pain_20251124_0134 .

# Body Weight
ex:proc_Weight_20251124_0134 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_Weight_20251124_0134 .

ex:time_meas_Weight_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

ex:meas_Weight_20251124_0134 a chr:Measurement ;
    sulo:hasValue "90.4"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_meas_Weight_20251124_0134 .

# BMI
ex:proc_BMI_20251124_0134 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_BMI_20251124_0134 .

ex:time_meas_BMI_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

ex:meas_BMI_20251124_0134 a chr:Measurement ;
    sulo:hasValue "27.47"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_meas_BMI_20251124_0134 .

# Heart rate
ex:proc_HR_20251124_0134 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_HR_20251124_0134 .

ex:time_meas_HR_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

ex:meas_HR_20251124_0134 a chr:Measurement ;
    sulo:hasValue "77"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_meas_HR_20251124_0134 .

# Evaluation (diagnostic statement)
ex:severity_moderate a chr:Severity .

ex:cond_Hypertriglyceridemia a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_moderate .

ex:diag_Hypertriglyceridemia a chr:DiagnosticStatement ;
    sulo:isFeatureOf ex:cond_Hypertriglyceridemia .

ex:eval_20251124_0134 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Provider_Brian , ex:role_Subject_Arturo ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasOutcome ex:diag_Hypertriglyceridemia ;
    sulo:atTime ex:time_eval_20251124_0134 .

ex:time_eval_20251124_0134 a sulo:TimeInstant ;
    sulo:hasValue "2025-11-24T01:34:00"^^xsd:dateTime .

# Care plan
ex:careplan_20251124 a chr:CarePlan ;
    sulo:refersTo ex:proc_FollowupMonitoring .

ex:proc_FollowupMonitoring a chr:MedicalProcedure .