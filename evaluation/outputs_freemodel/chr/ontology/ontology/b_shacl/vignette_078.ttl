# Persons
ex:person_Estela_Grant a chr:Person ;
    rdfs:label "Estela596 Yetta429 Grant908" .

ex:person_Ivonne_Turcotte a chr:Person ;
    rdfs:label "Dr. Ivonne773 Turcotte120" .

# Care unit
ex:careUnit_ZION a chr:CareUnit ;
    rdfs:label "ZION HEALTH & WELLNESS LLC" .

# Clinical visit
ex:visit_2004_12_27_2035 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2004_12_27_2035 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Estela ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Ivonne ;
    sulo:isIn ex:careUnit_ZION .

ex:time_visit_2004_12_27_2035 a sulo:TimeInstant ;
    sulo:hasValue "2004-12-27T20:35:00"^^xsd:dateTime .

ex:role_SubjectOfCare_Visit_Estela a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_CareProvider_Visit_Ivonne a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Ivonne_Turcotte .

# Process status (shared)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:status_moderate a chr:ProcessStatus ;
    rdfs:label "moderate" .

