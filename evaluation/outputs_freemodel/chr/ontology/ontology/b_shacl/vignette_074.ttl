@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Estela_Grant a chr:Person .
ex:provider_Nickolas_Schumm a chr:Person .

# Care unit
ex:careUnit_ENCOMPASS a chr:CareUnit .

# Clinical visit
ex:visit_2000_02_13_1135 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare ,
                       ex:role_CareProvider ,
                       ex:role_Performer ;
    sulo:isIn ex:careUnit_ENCOMPASS ;
    sulo:atTime ex:time_visit .

# Roles for the visit
ex:role_SubjectOfCare a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Estela_Grant .

ex:role_CareProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Nickolas_Schumm .

ex:role_Performer a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Nickolas_Schumm .

# Time instant for the visit
ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

# Measurement process and result
ex:measurementProcess_2000_02_13_1135 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasurementOutput ;
    sulo:atTime ex:time_measurement .

ex:role_MeasurementOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_2000_02_13_1135 .

ex:measurement_2000_02_13_1135 a chr:Measurement ;
    sulo:hasValue "37.436"^^xsd:float ;
    sulo:hasPart ex:unit_degC ;
    sulo:atTime ex:time_measurement .

ex:unit_degC a sulo:Unit ;
    rdfs:label "degree Celsius"@en .

ex:time_measurement a sulo:TimeInstant ;
    sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

# Evaluation (diagnostic) process
ex:evaluationProcess_2000_02_13_1135 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_DiagnosticOutput ,
                       ex:role_Performer ;
    sulo:atTime ex:time_evaluation .

ex:role_DiagnosticOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement_2000_02_13_1135 .

ex:diagnosticStatement_2000_02_13_1135 a chr:DiagnosticStatement .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

# Clinical condition and severity
ex:condition_2000_02_13_1135 a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_2000_02_13_1135 ;
    sulo:atTime ex:time_condition .

ex:severity_2000_02_13_1135 a chr:Severity ;
    sulo:hasValue "Moderate"^^xsd:string .

ex:time_condition a sulo:TimeInstant ;
    sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

# Medical procedure to be referenced by the care plan
ex:procedure_2000_02_13_1135 a chr:MedicalProcedure ;
    sulo:isPerformedBy ex:role_Performer ;
    sulo:atTime ex:time_procedure .

ex:time_procedure a sulo:TimeInstant ;
    sulo:hasValue "2000-02-13T11:35:00"^^xsd:dateTime .

# Care plan
ex:carePlan_2000_02_13 a chr:CarePlan ;
    sulo:refersTo ex:procedure_2000_02_13_1135 .