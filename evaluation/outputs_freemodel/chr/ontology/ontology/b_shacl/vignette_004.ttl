@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Angelic_Callie_Schaden a chr:Person ;
    rdfs:label "Angelic427 Callie226 Schaden604" .

# Person (provider)
ex:person_Sherita_Hudson a chr:Person ;
    rdfs:label "Dr. Sherita708 Hudson301" .

# Clinical visit
ex:visit_2017_11_24_1724 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_2017_11_24_1724 .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angelic_Callie_Schaden .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Sherita_Hudson .

ex:time_2017_11_24_1724 a sulo:TimeInstant ;
    sulo:hasValue "2017-11-24T17:24:00"^^xsd:dateTime .

# Process status (completed)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_cm a sulo:Unit ;
    rdfs:label "cm" .
ex:unit_kg a sulo:Unit ;
    rdfs:label "kg" .
ex:unit_kg_per_m2 a sulo:Unit ;
    rdfs:label "kg/m2" .
ex:unit_percent a sulo:Unit ;
    rdfs:label "%" .
ex:unit_per_min a sulo:Unit ;
    rdfs:label "/min" .

# Height measurement
ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "160.9"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_2017_11_24_1724 ;
    sulo:hasFeature ex:status_completed .

# Weight measurement
ex:measurement_Weight a chr:Measurement ;
    sulo:hasValue "48.7"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_2017_11_24_1724 ;
    sulo:hasFeature ex:status_completed .

# BMI (ratio) measurement
ex:measurement_BMI_Ratio a chr:Measurement ;
    sulo:hasValue "18.78"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_2017_11_24_1724 ;
    sulo:hasFeature ex:status_completed .

# BMI (percentile) measurement
ex:measurement_BMI_Percentile a chr:Measurement ;
    sulo:hasValue "13.62"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_2017_11_24_1724 ;
    sulo:hasFeature ex:status_completed .

# Heart rate measurement
ex:measurement_HeartRate a chr:Measurement ;
    sulo:hasValue "70"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_2017_11_24_1724 ;
    sulo:hasFeature ex:status_completed .

# Respiratory rate measurement
ex:measurement_RespRate a chr:Measurement ;
    sulo:hasValue "14"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_2017_11_24_1724 ;
    sulo:hasFeature ex:status_completed .

# Pain severity measurement
ex:measurement_PainSeverity a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_2017_11_24_1724 ;
    sulo:hasFeature ex:status_completed .

# AUDIT-C total score measurement (19:02)
ex:time_2017_11_24_1902 a sulo:TimeInstant ;
    sulo:hasValue "2017-11-24T19:02:00"^^xsd:dateTime .

ex:measurement_AUDITC a chr:Measurement ;
    sulo:hasValue "0"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_2017_11_24_1902 ;
    sulo:hasFeature ex:status_completed .

# Diagnostic statements
ex:diag_MedicationReview a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" ;
    sulo:hasFeature ex:severity_moderate ;
    sulo:atTime ex:time_2017_11_24_1724 .

ex:diag_SocialIsolation a chr:DiagnosticStatement ;
    rdfs:label "Social isolation (finding)" ;
    sulo:hasFeature ex:severity_moderate ;
    sulo:atTime ex:time_2017_11_24_1823 .

ex:time_2017_11_24_1823 a sulo:TimeInstant ;
    sulo:hasValue "2017-11-24T18:23:00"^^xsd:dateTime .

# Severity
ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Roles linking evaluations to diagnostic statements
ex:role_Diagnostic_MedicationReview a chr:DiagnosticStatementRole ;
    sulo:isFeatureOf ex:diag_MedicationReview .

ex:role_Diagnostic_SocialIsolation a chr:DiagnosticStatementRole ;
    sulo:isFeatureOf ex:diag_SocialIsolation .

# Evaluation processes (as separate processes linking provider, patient, and diagnostic statement)
ex:evaluation_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Evaluator_1 ;
    sulo:hasParticipant ex:role_Evaluatee_1 ;
    sulo:hasParticipant ex:role_Diagnostic_MedicationReview ;
    sulo:atTime ex:time_2017_11_24_1724 .

ex:role_Evaluator_1 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Sherita_Hudson .

ex:role_Evaluatee_1 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angelic_Callie_Schaden .

ex:evaluation_2 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Evaluator_2 ;
    sulo:hasParticipant ex:role_Evaluatee_2 ;
    sulo:hasParticipant ex:role_Diagnostic_SocialIsolation ;
    sulo:atTime ex:time_2017_11_24_1823 .

ex:role_Evaluator_2 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Sherita_Hudson .

ex:role_Evaluatee_2 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angelic_Callie_Schaden .

# Care plan
ex:careplan_1 a chr:CarePlan ;
    rdfs:label "Follow‑up monitoring and routine review" ;
    sulo:refersTo ex:procedure_FollowUp .

ex:procedure_FollowUp a chr:MedicalProcedure ;
    rdfs:label "Follow‑up monitoring and routine review" .