## Pain severity (numeric rating)
ex:proc_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Pain ;
    sulo:hasParticipant ex:role_Performer_Pain ;
    sulo:hasParticipant ex:role_Output_Pain ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_Pain a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Performer_Pain a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:role_Output_Pain a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_PainSeverity .

ex:measurement_PainSeverity a chr:Measurement ;
    sulo:hasValue "0"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/score> ;
    sulo:atTime ex:time_visit .

# Evaluation and diagnostic statement
ex:eval_20231108 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval ;
    sulo:hasParticipant ex:role_Performer_Eval ;
    sulo:hasFeature ex:diag_MedReview ;
    sulo:atTime ex:time_eval .

ex:role_SubjectOfCare_Eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Performer_Eval a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:diag_MedReview a chr:DiagnosticStatement , chr:ProcessStatus .

ex:time_eval a sulo:TimeInstant ;
    sulo:hasValue "2023-11-08T15:30:00"^^xsd:dateTime .

# Clinical condition with severity
ex:condition_20231108 a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_Moderate ;
    sulo:atTime ex:time_condition .

ex:severity_Moderate a chr:Severity .

ex:time_condition a sulo:TimeInstant ;
    sulo:hasValue "2023-11-08T15:30:00"^^xsd:dateTime .

# Care plan referencing a follow‑up procedure
ex:careplan_20231108 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure .

# Unit individuals (typed as sulo:Unit)
<https://w3id.org/sulo/unit/cm> a sulo:Unit .
<https://w3id.org/sulo/unit/kg> a sulo:Unit .
<https://w3id.org/sulo/unit/kg_per_m2> a sulo:Unit .
<https://w3id.org/sulo/unit/per_min> a sulo:Unit .
<https://w3id.org/sulo/unit/score> a sulo:Unit .