@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Hallie a chr:Person .
ex:provider_Teresa a chr:Person .

# Care unit
ex:careunit_CARING a chr:CareUnit .

# Clinical visit
ex:visit_20231108_1530 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_visit ;
    sulo:hasParticipant ex:role_CareProvider_visit ;
    sulo:isIn ex:careunit_CARING ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_CareProvider_visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2023-11-08T15:30:00"^^xsd:dateTime .

# Measurement processes and results

## Height
ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Height ;
    sulo:hasParticipant ex:role_Performer_Height ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Performer_Height a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Height .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "90.1"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/cm> ;
    sulo:atTime ex:time_visit .

## Weight
ex:proc_Weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Weight ;
    sulo:hasParticipant ex:role_Performer_Weight ;
    sulo:hasParticipant ex:role_Output_Weight ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_Weight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Performer_Weight a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:role_Output_Weight a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Weight .

ex:measurement_Weight a chr:Measurement ;
    sulo:hasValue "15.1"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/kg> ;
    sulo:atTime ex:time_visit .

## BMI (ratio)
ex:proc_BMI_Ratio a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_BMI_Ratio ;
    sulo:hasParticipant ex:role_Performer_BMI_Ratio ;
    sulo:hasParticipant ex:role_Output_BMI_Ratio ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_BMI_Ratio a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Performer_BMI_Ratio a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:role_Output_BMI_Ratio a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_BMI_Ratio .

ex:measurement_BMI_Ratio a chr:Measurement ;
    sulo:hasValue "18.57"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/kg_per_m2> ;
    sulo:atTime ex:time_visit .

## Heart rate
ex:proc_HeartRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_HeartRate ;
    sulo:hasParticipant ex:role_Performer_HeartRate ;
    sulo:hasParticipant ex:role_Output_HeartRate ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_HeartRate a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Performer_HeartRate a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:role_Output_HeartRate a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HeartRate .

ex:measurement_HeartRate a chr:Measurement ;
    sulo:hasValue "66"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/per_min> ;
    sulo:atTime ex:time_visit .

## Respiratory rate
ex:proc_RespRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_RespRate ;
    sulo:hasParticipant ex:role_Performer_RespRate ;
    sulo:hasParticipant ex:role_Output_RespRate ;
    sulo:atTime ex:time_visit .

ex:role_SubjectOfCare_RespRate a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Performer_RespRate a chr:PerformerRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:role_Output_RespRate a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_RespRate .

ex:measurement_RespRate a chr:Measurement ;
