@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Hallie a chr:Person .
ex:provider_Teresa a chr:Person .

# Clinical visit
ex:visit_2021_11_10_1530 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Hallie ,
                       ex:role_VisitProvider_Teresa ;
    sulo:atTime ex:time_visit .

ex:role_VisitPatient_Hallie a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_VisitProvider_Teresa a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2021-11-10T15:30:00"^^xsd:dateTime .

# Process status (used for all completed processes)
ex:status_completed a chr:ProcessStatus .

# Height measurement
ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_HeightPatient ,
                       ex:role_HeightOutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_HeightPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_HeightOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Height .

ex:meas_Height a chr:Measurement ;
    sulo:hasValue "64.7"^^xsd:float ;
    sulo:hasPart ex:unit_cm .

ex:unit_cm a sulo:Unit .

# Pain severity measurement
ex:proc_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_PainPatient ,
                       ex:role_PainOutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_PainPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_PainOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_PainSeverity .

ex:meas_PainSeverity a chr:Measurement ;
    sulo:hasValue "4"^^xsd:float .

# Weight measurement
ex:proc_Weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_WeightPatient ,
                       ex:role_WeightOutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_WeightPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_WeightOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Weight .

ex:meas_Weight a chr:Measurement ;
    sulo:hasValue "8.1"^^xsd:float ;
    sulo:hasPart ex:unit_kg .

ex:unit_kg a sulo:Unit .

# Weight-for-length measurement
ex:proc_WeightForLength a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_WFLPatient ,
                       ex:role_WFLOutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_WFLPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_WFLOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_WeightForLength .

ex:meas_WeightForLength a chr:Measurement ;
    sulo:hasValue "88.875"^^xsd:float ;
    sulo:hasPart ex:unit_percent .

ex:unit_percent a sulo:Unit .

# Head circumference percentile measurement
ex:proc_HeadCircPercentile a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_HeadCircPctPatient ,
                       ex:role_HeadCircPctOutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_HeadCircPctPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_HeadCircPctOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_HeadCircPercentile .

ex:meas_HeadCircPercentile a chr:Measurement ;
    sulo:hasValue "57.73"^^xsd:float ;
    sulo:hasPart ex:unit_percent .

# Head circumference measurement
ex:proc_HeadCirc a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_HeadCircPatient ,
                       ex:role_HeadCircOutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_HeadCircPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_HeadCircOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_HeadCirc .

ex:meas_HeadCirc a chr:Measurement ;
    sulo:hasValue "42.34"^^xsd:float ;
    sulo:hasPart ex:unit_cm .

# Heart rate measurement
ex:proc_HeartRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_HRPatient ,
                       ex:role_HROutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_HRPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_HROutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_HeartRate .

ex:meas_HeartRate a chr:Measurement ;
    sulo:hasValue "61"^^xsd:float ;
    sulo:hasPart ex:unit_per_min .

ex:unit_per_min a sulo:Unit .

# Respiratory rate measurement
ex:proc_RespRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_RespPatient ,
                       ex:role_RespOutput ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_RespPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_RespOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_RespRate .

ex:meas_RespRate a chr:Measurement ;
    sulo:hasValue "12"^^xsd:float ;
    sulo:hasPart ex:unit_per_min .

# Evaluation (diagnostic statement)
ex:eval_2021_11_10 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalProvider_Teresa ,
                       ex:role_EvalOutput_Diag ;
    sulo:atTime ex:time_visit ;
    sulo:hasFeature ex:status_completed .

ex:role_EvalProvider_Teresa a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Teresa .

ex:role_EvalOutput_Diag a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_MedicationReview .

ex:diag_MedicationReview a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity ;
    sulo:hasValue "Moderate"^^xsd:string .

# Care plan
ex:careplan_2021_11_10 a chr:CarePlan ;
    sulo:refersTo ex:proc_FollowupMonitoring .

ex:proc_FollowupMonitoring a chr:MedicalProcedure .