    sulo:isFeatureOf ex:person_Christeen33_Toy286 .

# Care unit -----------------------------------------------
ex:careunit_JewishFamilyService a chr:CareUnit .

# Clinical visit -------------------------------------------
ex:visit_2021_07_14_1647 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arlen68 ,
                       ex:role_CareProvider_Toy286 ;
    sulo:isIn ex:careunit_JewishFamilyService ;
    sulo:atTime ex:time_visit_2021_07_14_1647 .

ex:time_visit_2021_07_14_1647 a sulo:TimeInstant ;
    sulo:hasValue "2021-07-14T16:47:00"^^xsd:dateTime .

# Common status ------------------------------------------------
ex:status_completed_2021_07_14_1647 a chr:ProcessStatus ;
    sulo:hasValue "completed" .

# Units ----------------------------------------------------
