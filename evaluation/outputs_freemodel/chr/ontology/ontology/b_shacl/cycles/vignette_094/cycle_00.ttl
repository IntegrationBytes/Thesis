@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Harvey a chr:Person .
ex:physician_Haley a chr:Person .

# Care unit
ex:careunit_CHFS a chr:CareUnit .

# Clinical visit
ex:visit_2016_07_01_20_30 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit_Harvey ;
    sulo:hasParticipant ex:role_Provider_Visit_Haley ;
    sulo:isIn ex:careunit_CHFS ;
    sulo:atTime ex:time_Visit_2016_07_01_20_30 .

ex:role_Subject_Visit_Harvey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_Provider_Visit_Haley a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Haley .

ex:time_Visit_2016_07_01_20_30 a sulo:TimeInstant ;
    sulo:hasValue "2016-07-01T20:30:00"^^xsd:dateTime .

# Units (simple placeholders)
ex:unit_percent a sulo:Unit .
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_kg_per_m2 a sulo:Unit .
ex:unit_bpm a sulo:Unit .
ex:unit_per_min a sulo:Unit .
ex:unit_mg_per_dL a sulo:Unit .
ex:unit_mmol_per_L a sulo:Unit .

# Status
ex:status_completed a chr:ProcessStatus .

# Measurement processes and results (all share same time instant as visit)
# Hemoglobin A1c
ex:proc_HbA1c a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Visit_Harvey ;
    sulo:hasParticipant ex:role_Output_HbA1c ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Visit_2016_07_01_20_30 .

ex:role_Output_HbA1c a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_HbA1c .

ex:meas_HbA1c a chr:Measurement ;
    sulo:hasValue "6.24"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_Visit_2016_07_01_20_30 .

