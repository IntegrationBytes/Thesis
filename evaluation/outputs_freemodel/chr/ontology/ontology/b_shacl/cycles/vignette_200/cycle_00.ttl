# Persons
ex:person_Patient a chr:Person .
ex:person_Physician a chr:Person .

# Care unit
ex:careUnit_Encompass a chr:CareUnit .

# Clinical visit
ex:visit_2014_07_23_16_47 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_Visit .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Patient .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Physician .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2014-07-23T16:47:00"^^xsd:dateTime .

# Common status
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Common measurement time instant
ex:time_Measure_2014_07_23_16_47 a sulo:TimeInstant ;
    sulo:hasValue "2014-07-23T16:47:00"^^xsd:dateTime .

# Units
