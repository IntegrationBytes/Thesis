@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Nevares a chr:Person .
ex:person_Kohler a chr:Person .

# Roles for the clinical visit
ex:role_Subject_Patient_Nevares a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Nevares .

ex:role_Provider_Kohler a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Kohler .

# Clinical visit
ex:visit_2021_11_02_0420 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Patient_Nevares ;
    sulo:hasParticipant ex:role_Provider_Kohler ;
    sulo:atTime ex:time_Visit_2021_11_02_0420 .

ex:time_Visit_2021_11_02_0420 a sulo:TimeInstant ;
    sulo:hasValue "2021-11-02T04:20:00"^^xsd:dateTime .

# Process status (shared)
ex:status_completed a chr:ProcessStatus .

# Height measurement
ex:proc_Height_2021_11_02_0420 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Patient_Nevares ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:atTime ex:time_Height_2021_11_02_0420 ;
    sulo:hasFeature ex:status_completed .

ex:time_Height_2021_11_02_0420 a sulo:TimeInstant ;
    sulo:hasValue "2021-11-02T04:20:00"^^xsd:dateTime .

ex:meas_Height_2021_11_02_0420 a chr:Measurement ;
    sulo:hasValue "138.3"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/cm> ;
    sulo:atTime ex:time_Height_2021_11_02_0420 .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Height_2021_11_02_0420 .

# Weight measurement
