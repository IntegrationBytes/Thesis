ex:time_Weight_2021_11_02_0420 a sulo:TimeInstant ;
    sulo:hasValue "2021-11-02T04:20:00"^^xsd:dateTime .

ex:meas_Weight_2021_11_02_0420 a chr:Measurement ;
    sulo:hasValue "37.4"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/kg> ;
    sulo:atTime ex:time_Weight_2021_11_02_0420 .

ex:role_Output_Weight a chr:OutputRole ;
