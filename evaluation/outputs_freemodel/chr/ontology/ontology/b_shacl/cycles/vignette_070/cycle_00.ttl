    sulo:hasParticipant ex:role_Provider_Kohler ;
    sulo:hasParticipant ex:role_Subject_Patient_Nevares ;
    sulo:hasParticipant ex:role_Output_Diag ;
    sulo:atTime ex:time_Eval_2021_11_02_0420 ;
