@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Patient
ex:patient_Arturo a chr:Person ;
    rdfs:label "Arturo47 Lauren941 Heidenreich818" .

# Provider
ex:provider_Alan a chr:Person ;
    rdfs:label "Dr. Alan320 Keeling57" .

# Roles for the clinical visit
ex:role_SubjectOfCare_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Arturo .

ex:role_CareProvider_Alan a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Alan .

# Clinical visit
ex:visit_2025_06_09_0234 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo , ex:role_CareProvider_Alan ;
    sulo:atTime ex:time_Visit_2025_06_09_0234 .

ex:time_Visit_2025_06_09_0234 a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T02:34:00"^^xsd:dateTime .

# -----------------------------------------------------------------
# Measurement processes and results (selected examples)
# -----------------------------------------------------------------

# Hemoglobin A1c
ex:meas_HbA1c a chr:Measurement ;
    sulo:hasValue "6.87"^^xsd:float ;
    sulo:hasPart <https://example.org/unit/percent> ;
    sulo:atTime ex:time_HbA1c .

ex:role_Output_HbA1c a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_HbA1c .

ex:proc_HbA1c a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Output_HbA1c , ex:role_SubjectOfCare_Arturo ;
    sulo:atTime ex:time_HbA1c ;
    sulo:hasFeature ex:status_completed .

ex:time_HbA1c a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T02:34:00"^^xsd:dateTime .

# Body Height
ex:meas_Height a chr:Measurement ;
    sulo:hasValue "181.4"^^xsd:float ;
    sulo:hasPart <https://example.org/unit/centimeter> ;
    sulo:atTime ex:time_Height .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Height .

ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Output_Height , ex:role_SubjectOfCare_Arturo ;
    sulo:atTime ex:time_Height ;
    sulo:hasFeature ex:status_completed .

ex:time_Height a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T02:34:00"^^xsd:dateTime .

# Pain severity
ex:meas_Pain a chr:Measurement ;
    sulo:hasValue "3"^^xsd:float ;
    sulo:hasPart <https://example.org/unit/score> ;
    sulo:atTime ex:time_Pain .

ex:role_Output_Pain a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Pain .

ex:proc_Pain a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Output_Pain , ex:role_SubjectOfCare_Arturo ;
    sulo:atTime ex:time_Pain ;
    sulo:hasFeature ex:status_completed .

ex:time_Pain a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T02:34:00"^^xsd:dateTime .

# (Additional measurements would be modeled analogously; omitted for brevity)

# -----------------------------------------------------------------
# Evaluation processes and diagnostic statements
# -----------------------------------------------------------------

# Evaluation process (shared for three diagnoses)
ex:evaluation_2025_06_09_0234 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_CareProvider_Alan , ex:role_SubjectOfCare_Arturo ;
    sulo:atTime ex:time_Evaluation_2025_06_09_0234 .

ex:time_Evaluation_2025_06_09_0234 a sulo:TimeInstant ;
    sulo:hasValue "2025-06-09T02:34:00"^^xsd:dateTime .

# Diagnostic statement: Medication review due
ex:diag_MedReview a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" ;
    sulo:hasFeature ex:severity_Moderate .

ex:role_Output_MedReview a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_MedReview .

ex:evaluation_2025_06_09_0234 sulo:hasParticipant ex:role_Output_MedReview .

# Diagnostic statement: Diabetes mellitus type 2
ex:diag_Diabetes2 a chr:DiagnosticStatement ;
    rdfs:label "Diabetes mellitus type 2 (disorder)" ;
    sulo:hasFeature ex:severity_Moderate .

ex:role_Output_Diabetes2 a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_Diabetes2 .

ex:evaluation_2025_06_09_0234 sulo:hasParticipant ex:role_Output_Diabetes2 .

# Diagnostic statement: Ischemic heart disease
ex:diag_IHD a chr:DiagnosticStatement ;
    rdfs:label "Ischemic heart disease (disorder)" ;
    sulo:hasFeature ex:severity_Moderate .

ex:role_Output_IHD a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_IHD .

ex:evaluation_2025_06_09_0234 sulo:hasParticipant ex:role_Output_IHD .

# Severity entity
ex:severity_Moderate a chr:Severity ;
    rdfs:label "Moderate" .

# -----------------------------------------------------------------
# Care plan
# -----------------------------------------------------------------

ex:careplan_2025_06_09 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "Follow‑up monitoring and routine review" .

# -----------------------------------------------------------------
# Process status (shared instance)
# -----------------------------------------------------------------

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .