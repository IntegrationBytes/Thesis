@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_AracelyDevonCollins a chr:Person .
ex:person_MargaretReinger a chr:Person .

# Care unit
ex:careunit_CarneyHospital a chr:CareUnit .

# Clinical visit
ex:visit_2019_06_28_1504 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Aracely ;
    sulo:hasParticipant ex:role_VisitProvider_Margaret ;
    sulo:isIn ex:careunit_CarneyHospital ;
    sulo:atTime ex:time_visit_2019_06_28_1504 .

ex:role_VisitPatient_Aracely a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_AracelyDevonCollins .

ex:role_VisitProvider_Margaret a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_MargaretReinger .

ex:time_visit_2019_06_28_1504 a sulo:TimeInstant ;
    sulo:hasValue "2019-06-28T15:04:00"^^xsd:dateTime .

# Measurement process
ex:measurementProcess_2019_06_28_1504 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasPatient ;
    sulo:hasParticipant ex:role_MeasProvider ;
    sulo:hasParticipant ex:role_MeasOutput ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit_2019_06_28_1504 .

ex:role_MeasPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_AracelyDevonCollins .

ex:role_MeasProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_MargaretReinger .

ex:role_MeasOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_bodyTemp .

ex:status_completed a chr:ProcessStatus .

# Measurement (body temperature)
ex:measurement_bodyTemp a chr:Measurement ;
    sulo:hasValue "37.279"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_visit_2019_06_28_1504 .

ex:unit_Celsius a sulo:Unit .

# Evaluation process
ex:evaluation_2019_06_28_1504 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_EvalPatient ;
    sulo:hasParticipant ex:role_EvalPerformer ;
    sulo:hasParticipant ex:role_EvalOutput ;
    sulo:atTime ex:time_visit_2019_06_28_1504 .

ex:role_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_AracelyDevonCollins .

ex:role_EvalPerformer a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_MargaretReinger .

ex:role_EvalOutput a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnosticStatement_acuteViralPharyngitis .

# Diagnostic statement
ex:diagnosticStatement_acuteViralPharyngitis a chr:DiagnosticStatement .

# Clinical condition
ex:condition_acuteViralPharyngitis a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_moderate ;
    sulo:atTime ex:time_visit_2019_06_28_1504 .

ex:severity_moderate a chr:Severity .

# Care plan
ex:carePlan_2020_01_01 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure .