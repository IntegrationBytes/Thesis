@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Delma a chr:Person .
ex:person_Drew  a chr:Person .

# Care unit
ex:careunit_HarborHealth a chr:CareUnit .

# Clinical visit
ex:visit_2020_12_24_07_12 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:isIn ex:careunit_HarborHealth .

# Roles for the visit
ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Drew .

# Time instant for the visit (used for all measurements and evaluation)
ex:time_visit_2020_12_24_07_12 a sulo:TimeInstant ;
    sulo:hasValue "2020-12-24T07:12:00"^^xsd:dateTime .

# Measurements
ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "74.3"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/cm> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

ex:measurement_PainSeverity a chr:Measurement ;
    sulo:hasValue "3"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/score> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

ex:measurement_Weight a chr:Measurement ;
    sulo:hasValue "10.7"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/kg> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

ex:measurement_WeightForLength a chr:Measurement ;
    sulo:hasValue "93.377"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/percent> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

ex:measurement_HeadCircumferencePercentile a chr:Measurement ;
    sulo:hasValue "24.46"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/percent> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

ex:measurement_HeadCircumference a chr:Measurement ;
    sulo:hasValue "44.85"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/cm> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

ex:measurement_HeartRate a chr:Measurement ;
    sulo:hasValue "63"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/per_min> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

ex:measurement_RespiratoryRate a chr:Measurement ;
    sulo:hasValue "12"^^xsd:float ;
    sulo:hasPart <http://example.org/unit/per_min> ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 .

# Severity
ex:severity_Moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Diagnostic statement
ex:diagnostic_MedicationReview a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

# Evaluation process
ex:evaluation_2020_12_24_07_12 a chr:EvaluationProcess ;
    sulo:atTime ex:time_visit_2020_12_24_07_12 ;
    sulo:hasParticipant ex:role_Evaluator ;
    sulo:hasFeature ex:diagnostic_MedicationReview .

ex:role_Evaluator a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Drew .

# Care plan and referenced procedure
ex:careplan_2020_12_24 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure .