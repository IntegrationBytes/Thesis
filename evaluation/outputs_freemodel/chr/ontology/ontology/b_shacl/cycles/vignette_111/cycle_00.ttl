@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# -----------------------------------------------------------------
# Persons
ex:patient_Aracely_Devon_Collins a chr:Person .
ex:physician_Edmundo_Eichmann a chr:Person .

# -----------------------------------------------------------------
# Care unit
ex:careunit_FATHER_BILL a chr:CareUnit .

# -----------------------------------------------------------------
# Clinical visit
ex:visit_2023_07_14_1504 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2023_07_14_1504 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Patient ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Physician ;
    sulo:isIn ex:careunit_FATHER_BILL .

ex:role_SubjectOfCare_Visit_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .

ex:role_CareProvider_Visit_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Edmundo_Eichmann .

ex:time_visit_2023_07_14_1504 a sulo:TimeInstant ;
    sulo:hasValue "2023-07-14T15:04:00"^^xsd:dateTime .

# -----------------------------------------------------------------
# Shared status
ex:status_completed a chr:ProcessStatus .

# -----------------------------------------------------------------
# Units
ex:unit_mg_per_dL      a sulo:Unit .
ex:unit_mmol_per_L     a sulo:Unit .
ex:unit_cm             a sulo:Unit .
ex:unit_kg             a sulo:Unit .
ex:unit_kg_per_m2      a sulo:Unit .
ex:unit_per_min        a sulo:Unit .
ex:unit_score          a sulo:Unit .
ex:unit_percent        a sulo:Unit .
ex:unit_nominal        a sulo:Unit .
ex:unit_pH             a sulo:Unit .
ex:unit_mL_per_min_per_m2 a sulo:Unit .

# -----------------------------------------------------------------
# Measurement processes (all share the same time instant 15:04)
# Helper function to create triples (written out manually for each measurement)

# 1. Glucose (Serum)
ex:proc_Glucose_Serum_2023_07_14_1504 a chr:MeasurementProcess ;
    sulo:atTime ex:time_visit_2023_07_14_1504 ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasParticipant ex:role_SubjectOfCare_Glucose_Serum ;
    sulo:hasParticipant ex:role_Output_Glucose_Serum .

ex:role_SubjectOfCare_Glucose_Serum a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .

ex:measurement_Glucose_Serum a chr:Measurement ;
    sulo:hasValue "76.05"^^xsd:float ;
    sulo:hasPart ex:unit_mg_per_dL ;