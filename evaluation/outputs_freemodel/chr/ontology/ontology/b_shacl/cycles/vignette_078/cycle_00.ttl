@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Estela_Grant a chr:Person ;
    rdfs:label "Estela596 Yetta429 Grant908" .

ex:person_Ivonne_Turcotte a chr:Person ;
    rdfs:label "Dr. Ivonne773 Turcotte120" .

# Care unit
ex:careUnit_ZION a chr:CareUnit ;
    rdfs:label "ZION HEALTH & WELLNESS LLC" .

# Clinical visit
ex:visit_2004_12_27_2035 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2004_12_27_2035 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Estela ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Ivonne ;
    sulo:isIn ex:careUnit_ZION .

ex:time_visit_2004_12_27_2035 a sulo:TimeInstant ;
    sulo:hasValue "2004-12-27T20:35:00"^^xsd:dateTime .

ex:role_SubjectOfCare_Visit_Estela a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_CareProvider_Visit_Ivonne a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Ivonne_Turcotte .

# Process status (shared)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Measurement processes and results (example subset; repeat pattern for each measurement)

# Hemoglobin A1c
ex:proc_HbA1c_2004_12_27_2035 a chr:MeasurementProcess ;
    sulo:atTime ex:time_HbA1c_2004_12_27_2035 ;
    sulo:hasParticipant ex:role_SubjectOfCare_HbA1c ;
    sulo:hasParticipant ex:role_CareProvider_HbA1c ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasParticipant ex:measurement_HbA1c .

ex:time_HbA1c_2004_12_27_2035 a sulo:TimeInstant ;
    sulo:hasValue "2004-12-27T20:35:00"^^xsd:dateTime .

ex:role_SubjectOfCare_HbA1c a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_CareProvider_HbA1c a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Ivonne_Turcotte .

ex:measurement_HbA1c a chr:Measurement ;
    sulo:hasValue "6.26"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/percent> ;
    sulo:atTime ex:time_HbA1c_2004_12_27_2035 .

# Body Height
ex:proc_Height_2004_12_27_2035 a chr:MeasurementProcess ;
    sulo:atTime ex:time_Height_2004_12_27_2035 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Height ;
    sulo:hasParticipant ex:role_CareProvider_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasParticipant ex:measurement_Height .

ex:time_Height_2004_12_27_2035 a sulo:TimeInstant ;
    sulo:hasValue "2004-12-27T20:35:00"^^xsd:dateTime .

ex:role_SubjectOfCare_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_CareProvider_Height a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Ivonne_Turcotte .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "156.6"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/centimetre> ;
    sulo:atTime ex:time_Height_2004_12_27_2035 .

# Pain severity
ex:proc_Pain_2004_12_27_2035 a chr:MeasurementProcess ;
    sulo:atTime ex:time_Pain_2004_12_27_2035 ;
    sulo:hasParticipant ex:role_SubjectOfCare_Pain ;
    sulo:hasParticipant ex:role_CareProvider_Pain ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasParticipant ex:measurement_Pain .

ex:time_Pain_2004_12_27_2035 a sulo:TimeInstant ;
    sulo:hasValue "2004-12-27T20:35:00"^^xsd:dateTime .

ex:role_SubjectOfCare_Pain a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_CareProvider_Pain a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Ivonne_Turcotte .

ex:measurement_Pain a chr:Measurement ;
    sulo:hasValue "3"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/score> ;
    sulo:atTime ex:time_Pain_2004_12_27_2035 .

