@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Nevarez a chr:Person ;
    rdfs:label "Dolores Marisol Nevárez" .

# Care unit
ex:careunit_DRHE a chr:CareUnit ;
    rdfs:label "DR. HE'S PRIMARY CARE FOR ADULTS INC" .

# Clinical visit
ex:visit_2024_11_19_0420 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Nevarez ,
                       ex:role_CareProvider_Kohler ;
    sulo:isIn ex:careunit_DRHE ;
    sulo:atTime ex:time_visit_2024_11_19_0420 .

# Time instant for the visit (and most measurements)
ex:time_visit_2024_11_19_0420 a sulo:TimeInstant ;
    sulo:hasValue "2024-11-19T04:20:00"^^xsd:dateTime .

# Roles
ex:role_SubjectOfCare_Nevarez a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Nevarez .

ex:role_CareProvider_Kohler a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Kohler .

ex:person_Kohler a chr:Person ;
    rdfs:label "Dr. Cari Kohler" .

# ------------------------------
# Measurements (each has its own process)
# ------------------------------

# Height
ex:proc_height a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_height a chr:Measurement ;
    sulo:hasValue "157.4"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2024_11_19_0420 ;
    sulo:isFeatureOf ex:proc_height .

ex:unit_cm a sulo:Unit ;
    rdfs:label "centimeter" .

# Weight
ex:proc_weight a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_weight a chr:Measurement ;
    sulo:hasValue "57.0"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_visit_2024_11_19_0420 ;
    sulo:isFeatureOf ex:proc_weight .

ex:unit_kg a sulo:Unit ;
    rdfs:label "kilogram" .

# BMI (ratio)
ex:proc_bmi_ratio a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_bmi_ratio a chr:Measurement ;
    sulo:hasValue "23.0"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_visit_2024_11_19_0420 ;
    sulo:isFeatureOf ex:proc_bmi_ratio .

ex:unit_kg_per_m2 a sulo:Unit ;
    rdfs:label "kg/m2" .

# BMI (percentile)
ex:proc_bmi_percentile a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_bmi_percentile a chr:Measurement ;
    sulo:hasValue "90.094"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit_2024_11_19_0420 ;
    sulo:isFeatureOf ex:proc_bmi_percentile .

ex:unit_percent a sulo:Unit ;
    rdfs:label "percent" .

# Heart rate
ex:proc_heart_rate a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_heart_rate a chr:Measurement ;
    sulo:hasValue "65.0"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit_2024_11_19_0420 ;
    sulo:isFeatureOf ex:proc_heart_rate .

# Respiratory rate
ex:proc_resp_rate a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_resp_rate a chr:Measurement ;
    sulo:hasValue "13.0"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit_2024_11_19_0420 ;
    sulo:isFeatureOf ex:proc_resp_rate .

ex:unit_per_min a sulo:Unit ;
    rdfs:label "per minute" .

# Pain severity (numeric rating)
ex:proc_pain_severity a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_pain_severity a chr:Measurement ;
    sulo:hasValue "4.0"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_visit_2024_11_19_0420 ;
    sulo:isFeatureOf ex:proc_pain_severity ;
    sulo:hasFeature ex:severity_pain .

ex:unit_score a sulo:Unit ;
    rdfs:label "score (0-10)" .

ex:severity_pain a chr:Severity ;
    rdfs:label "Pain severity 4/10" .

# PHQ-9 total score
ex:proc_phq9 a chr:MeasurementProcess ;
    sulo:hasFeature ex:status_completed .

ex:measure_phq9 a chr:Measurement ;
    sulo:hasValue "2.0"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_phq9_2024_11_19_0459 ;
    sulo:isFeatureOf ex:proc_phq9 .

ex:time_phq9_2024_11_19_0459 a sulo:TimeInstant ;
    sulo:hasValue "2024-11-19T04:59:00"^^xsd:dateTime .

# ------------------------------
# Evaluation and Diagnostic Statement
# ------------------------------

ex:evaluation_2024_11_19_0459 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Nevarez ,
                       ex:role_CareProvider_Kohler ;
    sulo:atTime ex:time_phq9_2024_11_19_0459 ;
    sulo:hasFeature ex:diag_gingivitis .

ex:diag_gingivitis a chr:DiagnosticStatement ;
    rdfs:label "Gingivitis (disorder)" ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

# ------------------------------
# Care Plan
# ------------------------------

ex:careplan_1 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure ;
    rdfs:label "Follow‑up monitoring and routine review" .

# ------------------------------
# Process status (shared)
# ------------------------------

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .