    sulo:hasParticipant ex:role_Evaluator ;
    sulo:hasParticipant ex:role_EvalSubject ;
    sulo:hasFeature ex:status_evaluation ;
    sulo:hasResult ex:diag_med_review ;
    sulo:atTime ex:time_evaluation .

ex:role_Evaluator a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Teresa .

ex:role_EvalSubject a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:status_evaluation a :ProcessStatus ;
    sulo:hasValue "completed"^^xsd:string .

ex:diag_med_review a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity ;
    sulo:hasFeature "Moderate"^^xsd:string .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2022-11-09T15:30:00"^^xsd:dateTime .

# Care plan
ex:careplan_2022_11_09 a chr:CarePlan ;
    sulo:refersTo ex:proc_followup .

ex:proc_followup a chr:MedicalProcedure .

# Units
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_percent a sulo:Unit .
ex:unit_score a sulo:Unit .
ex:unit_per_min a sulo:Unit .