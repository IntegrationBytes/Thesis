@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :     <https://example.org/ontology#> .

# Patient
ex:patient_Hallie a chr:Person .

# Care provider (physician)
ex:physician_Teresa a chr:Person .

# Clinical visit
ex:visit_2022_11_09_1530 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit ;
    sulo:hasParticipant ex:role_Provider_Visit ;
    sulo:hasFeature ex:status_visit ;
    sulo:atTime ex:time_visit .

ex:role_Subject_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Provider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Teresa .

ex:status_visit a :ProcessStatus ;
    sulo:hasValue "completed"^^xsd:string .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2022-11-09T15:30:00"^^xsd:dateTime .

# Height measurement
ex:proc_height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Height ;
    sulo:hasParticipant ex:role_Provider_Height ;
    sulo:hasFeature ex:status_height ;
    sulo:hasResult ex:meas_height ;
    sulo:atTime ex:time_height .

ex:role_Subject_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Hallie .

ex:role_Provider_Height a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Teresa .

ex:status_height a :ProcessStatus ;
    sulo:hasValue "completed"^^xsd:string .

ex:meas_height a chr:Measurement ;
    sulo:hasValue "80.2"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_height .

ex:time_height a sulo:TimeInstant ;
    sulo:hasValue "2022-11-09T15:30:00"^^xsd:dateTime .

