@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Dolores_Nevarez a chr:Person .
ex:person_Cari_Kohler a chr:Person .

# Care unit (as a place entity)
ex:careunit_DRHE a chr:CareUnit .

# Clinical visit
ex:visit_2019_10_22_05_20 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_Visit .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Cari_Kohler .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

# Measurement processes and results

## Height
ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasResult ex:measurement_Height ;
    sulo:atTime ex:time_Height .

ex:role_Subject_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "125.8"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_Height .

ex:time_Height a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

## Weight
ex:proc_Weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Weight ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasResult ex:measurement_Weight ;
    sulo:atTime ex:time_Weight .

ex:role_Subject_Weight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:measurement_Weight a chr:Measurement ;
    sulo:hasValue "30.1"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_Weight .

ex:time_Weight a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

## BMI (ratio)
ex:proc_BMI_Ratio a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_BMI_Ratio ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasResult ex:measurement_BMI_Ratio ;
    sulo:atTime ex:time_BMI_Ratio .

ex:role_Subject_BMI_Ratio a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:measurement_BMI_Ratio a chr:Measurement ;
    sulo:hasValue "19.02"^^xsd:float ;
    sulo:hasPart ex:unit_kg_per_m2 ;
    sulo:atTime ex:time_BMI_Ratio .

ex:time_BMI_Ratio a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

## BMI (percentile)
ex:proc_BMI_Percentile a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_BMI_Percentile ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasResult ex:measurement_BMI_Percentile ;
    sulo:atTime ex:time_BMI_Percentile .

ex:role_Subject_BMI_Percentile a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:measurement_BMI_Percentile a chr:Measurement ;
    sulo:hasValue "93.279"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_BMI_Percentile .

ex:time_BMI_Percentile a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

## Heart rate
ex:proc_HeartRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_HeartRate ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasResult ex:measurement_HeartRate ;
    sulo:atTime ex:time_HeartRate .

ex:role_Subject_HeartRate a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:measurement_HeartRate a chr:Measurement ;
    sulo:hasValue "82"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_HeartRate .

ex:time_HeartRate a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

## Respiratory rate
ex:proc_RespiratoryRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_RespiratoryRate ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasResult ex:measurement_RespiratoryRate ;
    sulo:atTime ex:time_RespiratoryRate .

ex:role_Subject_RespiratoryRate a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:measurement_RespiratoryRate a chr:Measurement ;
    sulo:hasValue "14"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_RespiratoryRate .

ex:time_RespiratoryRate a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

## Pain severity (numeric rating)
ex:proc_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_PainSeverity ;
    sulo:hasFeature ex:status_completed ;
    sulo:hasResult ex:measurement_PainSeverity ;
    sulo:atTime ex:time_PainSeverity .

ex:role_Subject_PainSeverity a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:measurement_PainSeverity a chr:Measurement ;
    sulo:hasValue "4"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_PainSeverity .

ex:time_PainSeverity a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

# Common status
ex:status_completed a chr:ProcessStatus ;
    sulo:hasValue "completed"^^xsd:string .

# Units (simple placeholders)
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_kg_per_m2 a sulo:Unit .
ex:unit_percent a sulo:Unit .
ex:unit_per_min a sulo:Unit .
ex:unit_score a sulo:Unit .

# Evaluation (diagnostic statement) using n‑ary role‑mediated pattern
ex:evaluation_2019_10_22 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Eval ;
    sulo:hasParticipant ex:role_Performer_Eval ;
    sulo:hasParticipant ex:role_Diagnostic_Eval ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Eval .

ex:role_Subject_Eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Dolores_Nevarez .

ex:role_Performer_Eval a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Cari_Kohler .

ex:role_Diagnostic_Eval a chr:DiagnosticStatementRole ;
    sulo:isFeatureOf ex:diag_MedicationReview .

ex:diag_MedicationReview a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity ;
    sulo:hasValue "Moderate"^^xsd:string .

ex:time_Eval a sulo:TimeInstant ;
    sulo:hasValue "2019-10-22T05:20:00"^^xsd:dateTime .

# Care plan and referenced procedure
ex:careplan_FollowUp a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure .