# Evaluation process (diagnostic statement)
ex:evaluation_2022_03_18_1413 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arleen ;
    sulo:hasParticipant ex:role_Performer_DrLynwood ;
    sulo:atTime ex:time_evaluation_2022_03_18_1413 ;
    sulo:hasFeature ex:status_completed .

ex:role_Performer_DrLynwood a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_DrLynwood_Tromp .

ex:diagnostic_med_review a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Condition (the diagnostic statement is also a ClinicalCondition)
ex:condition_med_review a chr:ClinicalCondition ;
    sulo:isFeatureOf ex:diagnostic_med_review ;
    sulo:atTime ex:time_condition_2022_03_18_1413 .

ex:time_condition_2022_03_18_1413 a sulo:TimeInstant ;
    sulo:hasValue "2022-03-18T14:13:00"^^xsd:dateTime .

# Care plan referencing the evaluation (as a MedicalProcedure placeholder)
ex:careplan_2022_03_18 a chr:CarePlan ;
    sulo:refersTo ex:evaluation_2022_03_18_1413 .

# Process status (shared instance)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Time instant shared for all measurements (same timestamp)
ex:time_measure_2022_03_18_1413 a sulo:TimeInstant ;
    sulo:hasValue "2022-03-18T14:13:00"^^xsd:dateTime .

# Time instant for evaluation
ex:time_evaluation_2022_03_18_1413 a sulo:TimeInstant ;
    sulo:hasValue "2022-03-18T14:13:00"^^xsd:dateTime .