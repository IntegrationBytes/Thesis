# Respiratory rate
ex:proc_rr_2022_03_18_1413 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arleen ;
    sulo:hasParticipant ex:role_Output_rr ;
    sulo:atTime ex:time_measure_2022_03_18_1413 ;
