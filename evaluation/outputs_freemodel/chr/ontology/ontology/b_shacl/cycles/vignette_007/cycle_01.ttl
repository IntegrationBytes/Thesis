@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Arleen_Bergstrom a chr:Person ;
    rdfs:label "Arleen939 Marlyn309 Bergstrom287" .

# Care unit
ex:careunit_NashobaValley a chr:CareUnit ;
    rdfs:label "NASHOBA VALLEY MEDICAL CENTER" .

# Clinical visit
ex:visit_2022_03_18_1413 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arleen ;
    sulo:hasParticipant ex:role_CareProvider_DrLynwood ;
    sulo:isIn ex:careunit_NashobaValley ;
    sulo:atTime ex:time_visit_2022_03_18_1413 .

# Roles for visit
ex:role_SubjectOfCare_Arleen a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arleen_Bergstrom .

ex:role_CareProvider_DrLynwood a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_DrLynwood_Tromp .

# Attending physician
ex:person_DrLynwood_Tromp a chr:Person ;
    rdfs:label "Dr. Lynwood354 Tromp100" .

# Time instant for visit
ex:time_visit_2022_03_18_1413 a sulo:TimeInstant ;
    sulo:hasValue "2022-03-18T14:13:00"^^xsd:dateTime .

# ---- Measurements (each as MeasurementProcess with Measurement output) ----

# Body Height
ex:proc_height_2022_03_18_1413 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arleen ;
    sulo:hasParticipant ex:role_Output_height ;
    sulo:atTime ex:time_measure_2022_03_18_1413 ;
    sulo:hasFeature ex:status_completed .

ex:role_Output_height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_height .

ex:meas_height a chr:Measurement ;
    sulo:hasValue "159.0"^^xsd:float ;
    sulo:hasPart ex:unit_cm .

ex:unit_cm a sulo:Unit ;
    rdfs:label "cm" .

# Pain severity
ex:proc_pain_2022_03_18_1413 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arleen ;
    sulo:hasParticipant ex:role_Output_pain ;
    sulo:atTime ex:time_measure_2022_03_18_1413 ;
    sulo:hasFeature ex:status_completed .

ex:role_Output_pain a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_pain .

ex:meas_pain a chr:Measurement ;
    sulo:hasValue "1.0"^^xsd:float ;
    sulo:hasPart ex:unit_score .

ex:unit_score a sulo:Unit ;
    rdfs:label "score" .

# Body Weight
ex:proc_weight_2022_03_18_1413 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arleen ;
    sulo:hasParticipant ex:role_Output_weight ;
    sulo:atTime ex:time_measure_2022_03_18_1413 ;
