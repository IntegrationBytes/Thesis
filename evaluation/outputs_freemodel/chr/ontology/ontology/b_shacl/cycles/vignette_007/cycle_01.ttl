ex:role_Output_weight a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_weight .

ex:meas_weight a chr:Measurement ;
    sulo:hasValue "63.2"^^xsd:float ;
    sulo:hasPart ex:unit_kg .

ex:unit_kg a sulo:Unit ;
    rdfs:label "kg" .

# Body Mass Index
ex:proc_bmi_2022_03_18_1413 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arleen ;
    sulo:hasParticipant ex:role_Output_bmi ;
    sulo:atTime ex:time_measure_2022_03_18_1413 ;
