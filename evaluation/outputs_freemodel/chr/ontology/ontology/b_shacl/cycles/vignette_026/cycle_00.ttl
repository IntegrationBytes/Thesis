# Care unit
ex:careunit_JFCS a chr:CareUnit .

# Clinical visit
ex:visit_2018_10_04_1859 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient_Casey401 ,
                       ex:role_VisitProvider_EldridgeMarquardt ;
    sulo:atTime ex:time_visit_1859 ;
    sulo:isIn ex:careunit_JFCS .

ex:time_visit_1859 a sulo:TimeInstant ;
    sulo:hasValue "2018-10-04T18:59:00"^^xsd:dateTime .

# Roles for visit
