@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Delma a chr:Person .
ex:person_Drew a chr:Person .

# Roles for the visit
ex:role_SubjectOfCare_Delma a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma .

ex:role_CareProvider_Drew a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Drew .

# Clinical visit
ex:visit_2020_09_24_08_12 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_CareProvider_Drew ;
    sulo:atTime ex:time_visit ;
    sulo:isIn ex:careUnit_Harbor .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2020-09-24T08:12:00"^^xsd:dateTime .

ex:careUnit_Harbor a chr:CareUnit .

# Units
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_percent a sulo:Unit .
ex:unit_per_min a sulo:Unit .

# Measurement status
ex:status_completed a chr:ProcessStatus ;
    sulo:hasValue "completed"^^xsd:string .

# Height measurement
ex:heightMeasurement a chr:Measurement ;
    sulo:hasValue "70.9"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:heightMeasurement .

ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Pain severity measurement
ex:painSeverityMeasurement a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit .

ex:role_Output_Pain a chr:OutputRole ;
    sulo:isFeatureOf ex:painSeverityMeasurement .

ex:proc_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_Pain ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Weight measurement
ex:weightMeasurement a chr:Measurement ;
    sulo:hasValue "9.8"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_visit .

ex:role_Output_Weight a chr:OutputRole ;
    sulo:isFeatureOf ex:weightMeasurement .

ex:proc_Weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_Weight ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Weight-for-length measurement
ex:wflMeasurement a chr:Measurement ;
    sulo:hasValue "91.197"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit .

ex:role_Output_WFL a chr:OutputRole ;
    sulo:isFeatureOf ex:wflMeasurement .

ex:proc_WFL a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_WFL ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Head circumference percentile measurement
ex:headCircPercentile a chr:Measurement ;
    sulo:hasValue "24.46"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit .

ex:role_Output_HeadPercentile a chr:OutputRole ;
    sulo:isFeatureOf ex:headCircPercentile .

ex:proc_HeadPercentile a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_HeadPercentile ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Head circumference measurement
ex:headCircMeasurement a chr:Measurement ;
    sulo:hasValue "44.01"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit .

ex:role_Output_HeadCirc a chr:OutputRole ;
    sulo:isFeatureOf ex:headCircMeasurement .

ex:proc_HeadCirc a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_HeadCirc ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Heart rate measurement
ex:heartRateMeasurement a chr:Measurement ;
    sulo:hasValue "88"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit .

ex:role_Output_HeartRate a chr:OutputRole ;
    sulo:isFeatureOf ex:heartRateMeasurement .

ex:proc_HeartRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_HeartRate ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Respiratory rate measurement
ex:respRateMeasurement a chr:Measurement ;
    sulo:hasValue "12"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit .

ex:role_Output_RespRate a chr:OutputRole ;
    sulo:isFeatureOf ex:respRateMeasurement .

ex:proc_RespRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Output_RespRate ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit .

# Diagnostic statement
ex:diag_MedicationReview a chr:DiagnosticStatement .

ex:role_Output_Diag a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_MedicationReview .

# Evaluation process
ex:evaluation_2020_09_24 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Delma ,
                       ex:role_Performer_Drew ,
                       ex:role_Output_Diag ;
    sulo:atTime ex:time_visit .

ex:role_Performer_Drew a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Drew .

# Clinical condition with severity
ex:condition_MedReview a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_Moderate .

ex:severity_Moderate a chr:Severity ;
    sulo:hasValue "Moderate"^^xsd:string .

# Care plan and referenced procedure
ex:followupProcedure a chr:MedicalProcedure .

ex:carePlan_2020_09_24 a chr:CarePlan ;
    sulo:refersTo ex:followupProcedure .