@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# -------------------------------------------------
# Persons
# -------------------------------------------------
ex:patient_Harvey a chr:Person .
ex:physician_Assunta a chr:Person .

# -------------------------------------------------
# Roles for the clinical visit
# -------------------------------------------------
ex:role_SubjectOfCare_Harvey a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_CareProvider_Assunta a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Assunta .

# -------------------------------------------------
# Clinical visit
# -------------------------------------------------
ex:visit_2018_07_13_20_30 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Harvey ,
                       ex:role_CareProvider_Assunta ;
    sulo:atTime ex:time_visit_2018_07_13_20_30 ;
    sulo:isIn ex:careunit_CFS .

ex:time_visit_2018_07_13_20_30 a sulo:TimeInstant ;
    sulo:hasValue "2018-07-13T20:30:00"^^xsd:dateTime .

ex:careunit_CFS a chr:CareUnit .

# -------------------------------------------------
# Process status (shared)
# -------------------------------------------------
ex:status_completed a chr:ProcessStatus .

# -------------------------------------------------
# Example Measurement: Hemoglobin A1c
# -------------------------------------------------
ex:role_Output_HbA1c a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HbA1c .

ex:proc_HbA1c a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Harvey ,
                       ex:role_Output_HbA1c ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_HbA1c .

ex:time_HbA1c a sulo:TimeInstant ;
    sulo:hasValue "2018-07-13T20:30:00"^^xsd:dateTime .

ex:measurement_HbA1c a chr:Measurement ;
    sulo:hasValue "5.81"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_HbA1c .

ex:unit_percent a sulo:Unit .

# -------------------------------------------------
# Example Measurement: Body Height
# -------------------------------------------------
ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Height .

ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Harvey ,
                       ex:role_Output_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Height .

ex:time_Height a sulo:TimeInstant ;
    sulo:hasValue "2018-07-13T20:30:00"^^xsd:dateTime .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "172.9"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_Height .

ex:unit_cm a sulo:Unit .

# -------------------------------------------------
# Example Measurement: Pain severity (score)
# -------------------------------------------------
ex:role_Output_PainSeverity a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_PainSeverity .

ex:proc_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Harvey ,
                       ex:role_Output_PainSeverity ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_PainSeverity .

ex:time_PainSeverity a sulo:TimeInstant ;
    sulo:hasValue "2018-07-13T20:30:00"^^xsd:dateTime .

ex:measurement_PainSeverity a chr:Measurement ;
    sulo:hasValue "2"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_PainSeverity .

ex:unit_score a sulo:Unit .

# -------------------------------------------------
# Evaluation (Diagnostic statement)
# -------------------------------------------------
ex:role_Performer_Assunta a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Assunta .

ex:role_Output_Diagnosis a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_SocialIsolation .

ex:evaluation_2018_07_13_21_10 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Harvey ,
                       ex:role_Performer_Assunta ,
                       ex:role_Output_Diagnosis ;
    sulo:atTime ex:time_evaluation_2018_07_13_21_10 .

ex:time_evaluation_2018_07_13_21_10 a sulo:TimeInstant ;
    sulo:hasValue "2018-07-13T21:10:00"^^xsd:dateTime .

ex:diagnostic_SocialIsolation a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity .

# -------------------------------------------------
# Care Plan
# -------------------------------------------------
ex:careplan_2018_07_13 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure .

# -------------------------------------------------
# Additional measurements (list only identifiers; full details omitted for brevity)
# -------------------------------------------------
# Body Weight
ex:proc_Weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Harvey , ex:role_Output_Weight ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Weight .
ex:role_Output_Weight a chr:OutputRole ; sulo:isFeatureOf ex:measurement_Weight .
ex:measurement_Weight a chr:Measurement ;
    sulo:hasValue "82.3"^^xsd:float ; sulo:hasPart ex:unit_kg ; sulo:atTime ex:time_Weight .
ex:time_Weight a sulo:TimeInstant ; sulo:hasValue "2018-07-13T20:30:00"^^xsd:dateTime .
ex:unit_kg a sulo:Unit .

# (Other laboratory measurements would be modeled analogously.)