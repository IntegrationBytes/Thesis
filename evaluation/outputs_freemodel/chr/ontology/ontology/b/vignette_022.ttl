@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Arturo47 a chr:Person .
ex:person_ManuelaRendon a chr:Person .

# Care unit
ex:careUnit_FitchburgOutpatientClinic a chr:CareUnit .

# Clinical visit
ex:visit_2025_08_17_1739 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit_Arturo47 ,
                       ex:role_CareProvider_Visit_ManuelaRendon ;
    sulo:isIn ex:careUnit_FitchburgOutpatientClinic ;
    sulo:atTime ex:time_Visit_2025_08_17_1739 .

ex:role_Subject_Visit_Arturo47 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_CareProvider_Visit_ManuelaRendon a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_ManuelaRendon .

ex:time_Visit_2025_08_17_1739 a sulo:TimeInstant ;
    sulo:hasValue "2025-08-17T17:39:00"^^xsd:dateTime .

# Common status
ex:status_completed a chr:ProcessStatus .

# Measurement processes and results (example for ACT; similar pattern repeated for each measurement)

## ACT measurement
ex:proc_ACT_2025_08_17_1739 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_ACT_Arturo47 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_ACT_2025_08_17_1739 ;
    sulo:hasParticipant ex:role_Output_ACT .

ex:role_Subject_ACT_Arturo47 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_Output_ACT a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_ACT_2025_08_17_1739 .

ex:measurement_ACT_2025_08_17_1739 a chr:Measurement ;
    sulo:hasValue "111.83"^^xsd:float ;
    sulo:hasPart ex:unit_seconds .

ex:unit_seconds a sulo:Unit .

ex:time_ACT_2025_08_17_1739 a sulo:TimeInstant ;
    sulo:hasValue "2025-08-17T17:39:00"^^xsd:dateTime .

## pH (Arterial) measurement
ex:proc_pH_Arterial_2025_08_17_1739 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_pH_Arterial_Arturo47 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_pH_Arterial_2025_08_17_1739 ;
    sulo:hasParticipant ex:role_Output_pH_Arterial .

ex:role_Subject_pH_Arterial_Arturo47 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_Output_pH_Arterial a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_pH_Arterial_2025_08_17_1739 .

ex:measurement_pH_Arterial_2025_08_17_1739 a chr:Measurement ;
    sulo:hasValue "6.9551"^^xsd:float ;
    sulo:hasPart ex:unit_pH .

ex:unit_pH a sulo:Unit .

ex:time_pH_Arterial_2025_08_17_1739 a sulo:TimeInstant ;
    sulo:hasValue "2025-08-17T17:39:00"^^xsd:dateTime .

## CO₂ (Arterial) measurement
ex:proc_CO2_Arterial_2025_08_17_1739 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_CO2_Arterial_Arturo47 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_CO2_Arterial_2025_08_17_1739 ;
    sulo:hasParticipant ex:role_Output_CO2_Arterial .

ex:role_Subject_CO2_Arterial_Arturo47 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_Output_CO2_Arterial a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_CO2_Arterial_2025_08_17_1739 .

ex:measurement_CO2_Arterial_2025_08_17_1739 a chr:Measurement ;
    sulo:hasValue "39.262"^^xsd:float ;
    sulo:hasPart ex:unit_mmHg .

ex:unit_mmHg a sulo:Unit .

ex:time_CO2_Arterial_2025_08_17_1739 a sulo:TimeInstant ;
    sulo:hasValue "2025-08-17T17:39:00"^^xsd:dateTime .

# Evaluation process and diagnostic statement
ex:evaluation_2025_08_17_2353 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Eval_Arturo47 ,
                       ex:role_Performer_Eval_ManuelaRendon ,
                       ex:role_Output_Eval ;
    sulo:atTime ex:time_Eval_2025_08_17_2353 .

ex:role_Subject_Eval_Arturo47 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_Performer_Eval_ManuelaRendon a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_ManuelaRendon .

ex:role_Output_Eval a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_HistoryCABG .

ex:diagnostic_HistoryCABG a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity .

ex:time_Eval_2025_08_17_2353 a sulo:TimeInstant ;
    sulo:hasValue "2025-08-17T23:53:00"^^xsd:dateTime .

# Treatment plans and medication administrations (example for cefazolin)

## Pharmaceutical product
ex:product_cefazolin a chr:PharmaceuticalProduct .

## Dose form
ex:doseForm_Injection a chr:PharmaceuticalDoseForm .

## Dose
ex:dose_cefazolin_2000MG a chr:PharmaceuticalDose ;
    sulo:hasValue "2000"^^xsd:float ;
    sulo:hasPart ex:unit_MG .

ex:unit_MG a sulo:Unit .

## Medication administration
ex:medAdmin_cefazolin_2025_08_17_1739 a chr:MedicationAdministration ;
    sulo:hasParticipant ex:product_cefazolin ;
    sulo:hasFeature ex:dose_cefazolin_2000MG , ex:doseForm_Injection ;
    sulo:hasParticipant ex:role_Subject_MedAdmin_cefazolin ,
                       ex:role_Performer_MedAdmin_cefazolin ;
    sulo:atTime ex:time_MedAdmin_cefazolin_2025_08_17_1739 .

ex:role_Subject_MedAdmin_cefazolin a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47 .

ex:role_Performer_MedAdmin_cefazolin a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_ManuelaRendon .

ex:time_MedAdmin_cefazolin_2025_08_17_1739 a sulo:TimeInstant ;
    sulo:hasValue "2025-08-17T17:39:00"^^xsd:dateTime .

## Treatment plan linking to the medication administration
ex:tp_cefazolin_2025_08_17 a chr:TreatmentPlan ;
    sulo:hasPart ex:medAdmin_cefazolin_2025_08_17_1739 .

# Care plan referring to follow‑up monitoring
ex:carePlan_FollowUp a chr:CarePlan ;
    sulo:refersTo ex:diagnostic_HistoryCABG .