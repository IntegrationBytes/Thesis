@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Aracely_Devon_Collins a chr:Person .
ex:person_Edmundo_Eichmann a chr:Person .

# Care unit
ex:careunit_father_bill_place a chr:CareUnit .

# Roles
ex:role_subject_Aracely_2022_07_08 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Aracely_Devon_Collins .

ex:role_provider_Edmundo_2022_07_08 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Edmundo_Eichmann .

# Time instants
ex:time_visit_2022_07_08_15_04 a sulo:TimeInstant ;
    sulo:hasValue "2022-07-08T15:04:00"^^xsd:dateTime .

ex:time_measure_2022_07_08_15_04 a sulo:TimeInstant ;
    sulo:hasValue "2022-07-08T15:04:00"^^xsd:dateTime .

ex:time_total_score_2022_07_08_16_18 a sulo:TimeInstant ;
    sulo:hasValue "2022-07-08T16:18:00"^^xsd:dateTime .

ex:time_evaluation_2022_07_08_15_04 a sulo:TimeInstant ;
    sulo:hasValue "2022-07-08T15:04:00"^^xsd:dateTime .

# Process status
ex:status_completed a chr:ProcessStatus .

# Severity
ex:severity_moderate a chr:Severity .

# Units (non‑CHR individuals)
ex:unit_mg_per_dL a sulo:Unit .
ex:unit_mmol_per_L a sulo:Unit .
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_score a sulo:Unit .
ex:unit_percent a sulo:Unit .
ex:unit_mL_per_min_per_m2 a sulo:Unit .
ex:unit_bpm a sulo:Unit .
ex:unit_per_min a sulo:Unit .

# Clinical visit
ex:visit_2022_07_08_15_04 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2022_07_08_15_04 ;
    sulo:isIn ex:careunit_father_bill_place ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:role_provider_Edmundo_2022_07_08 .

# Measurement processes and results (Serum/Plasma)
ex:proc_Glucose_Serum_2022_07_08_15_04 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_Glucose_Serum_2022_07_08_15_04 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:measurement_Glucose_Serum_2022_07_08_15_04 a chr:Measurement ;
    sulo:hasValue "81.22"^^xsd:float ;
    sulo:hasPart ex:unit_mg_per_dL ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:output_Glucose_Serum_2022_07_08_15_04 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Glucose_Serum_2022_07_08_15_04 .

ex:proc_UreaNitrogen_Serum_2022_07_08_15_04 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_UreaNitrogen_Serum_2022_07_08_15_04 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:measurement_UreaNitrogen_Serum_2022_07_08_15_04 a chr:Measurement ;
    sulo:hasValue "16.53"^^xsd:float ;
    sulo:hasPart ex:unit_mg_per_dL ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:output_UreaNitrogen_Serum_2022_07_08_15_04 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_UreaNitrogen_Serum_2022_07_08_15_04 .

ex:proc_Creatinine_Serum_2022_07_08_15_04 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_Creatinine_Serum_2022_07_08_15_04 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:measurement_Creatinine_Serum_2022_07_08_15_04 a chr:Measurement ;
    sulo:hasValue "1.454"^^xsd:float ;
    sulo:hasPart ex:unit_mg_per_dL ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:output_Creatinine_Serum_2022_07_08_15_04 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Creatinine_Serum_2022_07_08_15_04 .

# Urine measurements (example for Glucose)
ex:proc_Glucose_Urine_2022_07_08_15_04 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_Glucose_Urine_2022_07_08_15_04 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:measurement_Glucose_Urine_2022_07_08_15_04 a chr:Measurement ;
    sulo:hasValue "0.71451"^^xsd:float ;
    sulo:hasPart ex:unit_mg_per_dL ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:output_Glucose_Urine_2022_07_08_15_04 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Glucose_Urine_2022_07_08_15_04 .

# Blood measurements (example for Hemoglobin A1c)
ex:proc_HbA1c_Blood_2022_07_08_15_04 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_HbA1c_Blood_2022_07_08_15_04 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:measurement_HbA1c_Blood_2022_07_08_15_04 a chr:Measurement ;
    sulo:hasValue "3.35"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:output_HbA1c_Blood_2022_07_08_15_04 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HbA1c_Blood_2022_07_08_15_04 .

# Vital signs (example for Heart rate)
ex:proc_HeartRate_2022_07_08_15_04 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_HeartRate_2022_07_08_15_04 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:measurement_HeartRate_2022_07_08_15_04 a chr:Measurement ;
    sulo:hasValue "97"^^xsd:float ;
    sulo:hasPart ex:unit_bpm ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:output_HeartRate_2022_07_08_15_04 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HeartRate_2022_07_08_15_04 .

# Pain severity (Score)
ex:proc_PainSeverity_2022_07_08_15_04 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_PainSeverity_2022_07_08_15_04 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:measurement_PainSeverity_2022_07_08_15_04 a chr:Measurement ;
    sulo:hasValue "4"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_measure_2022_07_08_15_04 .

ex:output_PainSeverity_2022_07_08_15_04 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_PainSeverity_2022_07_08_15_04 .

# Total DAST‑10 score
ex:proc_TotalScore_DAST10_2022_07_08_16_18 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_TotalScore_DAST10_2022_07_08_16_18 ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_total_score_2022_07_08_16_18 .

ex:measurement_TotalScore_DAST10_2022_07_08_16_18 a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_total_score_2022_07_08_16_18 .

ex:output_TotalScore_DAST10_2022_07_08_16_18 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_TotalScore_DAST10_2022_07_08_16_18 .

# Evaluation process producing diagnostic statement
ex:diag_med_review_due a chr:DiagnosticStatement .

ex:output_diag_med_review a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_med_review_due .

ex:evaluation_2022_07_08_15_04 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_provider_Edmundo_2022_07_08 ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:output_diag_med_review ;
    sulo:hasFeature ex:severity_moderate ;
    sulo:atTime ex:time_evaluation_2022_07_08_15_04 .

# Clinical condition (linked to severity)
ex:condition_2022_07_08 a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_moderate ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 .

# Care plan (object)
ex:careplan_2022_07_08 a chr:CarePlan .

# Care plan process (role‑mediated)
ex:proc_careplan_2022_07_08 a chr:Process ;
    sulo:hasParticipant ex:role_subject_Aracely_2022_07_08 ;
    sulo:hasParticipant ex:role_provider_Edmundo_2022_07_08 .

# Role linking the care‑plan process to the referenced medical procedure
ex:role_careplan_2022_07_08 a chr:CarePlanRole ;
    sulo:isFeatureOf ex:proc_careplan_2022_07_08 ;
    sulo:isFeatureOf ex:followup_monitoring .

# Medical procedure referenced by the care plan
ex:followup_monitoring a chr:MedicalProcedure .