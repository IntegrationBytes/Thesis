@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Patient
ex:patient_Delma a chr:Person .

# Provider
ex:provider_Drew a chr:Person .

# Care unit
ex:unit_Harbor a chr:CareUnit .

# Visit
ex:visit_2020_01_23_07_12 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_visit_Patient ,
                       ex:role_CareProvider_visit_Provider ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

ex:time_visit_2020_01_23_07_12 a sulo:TimeInstant ;
    sulo:hasValue "2020-01-23T07:12:00"^^xsd:dateTime .

ex:role_SubjectOfCare_visit_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_CareProvider_visit_Provider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Drew .

# Measurement: Body Height
ex:proc_height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_height ,
                       ex:role_Output_height ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_height .

ex:meas_height a chr:Measurement ;
    sulo:hasValue "58.6"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Measurement: Pain Severity
ex:proc_pain_severity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_pain ,
                       ex:role_Output_pain ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_pain a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_pain a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_pain .

ex:meas_pain a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Measurement: Body Weight
ex:proc_weight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_weight ,
                       ex:role_Output_weight ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_weight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_weight a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_weight .

ex:meas_weight a chr:Measurement ;
    sulo:hasValue "6.2"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Measurement: Weight-for-length Percent
ex:proc_wfl_percent a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_wfl ,
                       ex:role_Output_wfl ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_wfl a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_wfl a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_wfl .

ex:meas_wfl a chr:Measurement ;
    sulo:hasValue "81.216"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Measurement: Head Occipital-frontal circumference Percentile
ex:proc_head_percentile a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_head_percentile ,
                       ex:role_Output_head_percentile ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_head_percentile a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_head_percentile a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_head_percentile .

ex:meas_head_percentile a chr:Measurement ;
    sulo:hasValue "24.46"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Measurement: Head Occipital-frontal circumference (cm)
ex:proc_head_cm a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_head_cm ,
                       ex:role_Output_head_cm ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_head_cm a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_head_cm a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_head_cm .

ex:meas_head_cm a chr:Measurement ;
    sulo:hasValue "39.57"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Measurement: Heart Rate
ex:proc_heart_rate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_hr ,
                       ex:role_Output_hr ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_hr a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_hr a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_heart_rate .

ex:meas_heart_rate a chr:Measurement ;
    sulo:hasValue "81"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Measurement: Respiratory Rate
ex:proc_resp_rate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_rr ,
                       ex:role_Output_rr ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_rr a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_Output_rr a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_resp_rate .

ex:meas_resp_rate a chr:Measurement ;
    sulo:hasValue "15"^^xsd:float ;
    sulo:hasPart ex:unit_per_min ;
    sulo:atTime ex:time_visit_2020_01_23_07_12 .

# Status instance
ex:status_completed a chr:ProcessStatus .

# Units
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_percent a sulo:Unit .
ex:unit_score a sulo:Unit .
ex:unit_per_min a sulo:Unit .

# Evaluation (Diagnostic statement)
ex:evaluation_2020_01_23_07_12 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_eval ,
                       ex:role_CareProvider_eval ,
                       ex:role_Output_diag .

ex:role_SubjectOfCare_eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Delma .

ex:role_CareProvider_eval a chr:CareProviderRole ;
    sulo:isFeatureOf ex:provider_Drew .

ex:role_Output_diag a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_med_review ;
    sulo:hasFeature ex:severity_moderate .

ex:diag_med_review a chr:DiagnosticStatement .

ex:severity_moderate a chr:Severity .

# Care Plan
ex:careplan_2020_01_23 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure .