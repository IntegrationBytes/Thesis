ex:time_2026_04_10_15_04 a sulo:TimeInstant ;
    sulo:hasValue "2026-04-10T15:04:00"^^xsd:dateTime .
ex:time_2026_04_10_16_13 a sulo:TimeInstant ;
    sulo:hasValue "2026-04-10T16:13:00"^^xsd:dateTime .
