# Persons
ex:patient_Aracely_Devon_Collins a chr:Person .
ex:physician_Margaret_Reinger a chr:Person .

# Care unit
ex:careunit_CarneyHospital a chr:CareUnit .

# Process status (shared)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Severity (shared)
ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Diagnostic statement (shared)
ex:diagnostic_medication_review a chr:DiagnosticStatement ;
    rdfs:label "Medication review due (situation)" ;
    sulo:hasFeature ex:severity_moderate .

# Evaluation process
ex:evaluation_2026_04_10_15_04 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval ;
    sulo:hasParticipant ex:role_CareProvider_Eval ;
    sulo:hasParticipant ex:role_Output_Eval ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2026_04_10_15_04 .

ex:role_SubjectOfCare_Eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .
ex:role_CareProvider_Eval a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Margaret_Reinger .
ex:role_Output_Eval a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_medication_review .

# Clinical visit
ex:visit_2026_04_10_15_04 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:isIn ex:careunit_CarneyHospital ;
    sulo:atTime ex:time_2026_04_10_15_04 .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .
ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Margaret_Reinger .

