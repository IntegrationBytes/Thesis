# Clinical visit
ex:visit_20130220T1547 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_20130220T1547 ;
    sulo:isIn ex:careunit_UrgentCare ;
    sulo:hasParticipant ex:role_Subject_Visit_20130220T1547 , ex:role_Performer_Visit_20130220T1547 .

ex:time_visit_20130220T1547 a sulo:TimeInstant ;
    sulo:hasValue "2013-02-20T15:47:00"^^xsd:dateTime .

ex:role_Subject_Visit_20130220T1547 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Bryant_Grimes .

ex:role_Performer_Visit_20130220T1547 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Dana_Wilkinson .

