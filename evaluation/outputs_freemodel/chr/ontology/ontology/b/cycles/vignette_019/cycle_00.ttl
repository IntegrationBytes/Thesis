@prefix chr: <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex: <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Arturo a chr:Person .
ex:physician_Alan a chr:Person .

# Care unit
ex:careunit_PRIMARY_CARE_NORTH_PC a chr:CareUnit .

# Clinical visit
ex:visit_2023-05-29T02:34 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_CareProvider_Alan ;
    sulo:isIn ex:careunit_PRIMARY_CARE_NORTH_PC ;
    sulo:atTime ex:time_Visit_2023-05-29T02:34 .

ex:time_Visit_2023-05-29T02:34 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-29T02:34:00"^^xsd:dateTime .

# Roles for visit
ex:role_SubjectOfCare_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_Alan a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Alan .

# Measurement processes and results (example for a few; similar pattern for all)
# Hemoglobin A1c
ex:proc_HbA1c_2023-05-29T02:34 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_CareProvider_Alan ;
    sulo:hasParticipant ex:role_Output_HbA1c ;
    sulo:atTime ex:time_HbA1c_2023-05-29T02:34 ;
    sulo:hasFeature ex:status_completed .

ex:time_HbA1c_2023-05-29T02:34 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-29T02:34:00"^^xsd:dateTime .

ex:role_Output_HbA1c a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_HbA1c .

ex:meas_HbA1c a chr:Measurement ;
    sulo:hasValue "6.11"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/percent> ;
    sulo:atTime ex:time_HbA1c_2023-05-29T02:34 .

# Body Height
ex:proc_Height_2023-05-29T02:34 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_CareProvider_Alan ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:atTime ex:time_Height_2023-05-29T02:34 ;
    sulo:hasFeature ex:status_completed .

ex:time_Height_2023-05-29T02:34 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-29T02:34:00"^^xsd:dateTime .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Height .

ex:meas_Height a chr:Measurement ;
    sulo:hasValue "181.4"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/centimeter> ;
    sulo:atTime ex:time_Height_2023-05-29T02:34 .

# Pain severity
ex:proc_Pain_2023-05-29T02:34 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_CareProvider_Alan ;
    sulo:hasParticipant ex:role_Output_Pain ;
    sulo:atTime ex:time_Pain_2023-05-29T02:34 ;
    sulo:hasFeature ex:status_completed .

ex:time_Pain_2023-05-29T02:34 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-29T02:34:00"^^xsd:dateTime .

ex:role_Output_Pain a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Pain .

ex:meas_Pain a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/score> ;
    sulo:atTime ex:time_Pain_2023-05-29T02:34 .

# (Repeat analogous blocks for Body Weight, BMI, Heart rate, Respiratory rate, Glucose, Urea nitrogen, Creatinine, Calcium, Sodium, Potassium, Chloride, CO2, Cholesterol, Triglyceride, LDL, HDL, GAD-7, Morse Fall Scale, HARK, PHQ-2 – omitted for brevity)

# Evaluation process for Stress
ex:evaluation_Stress_2023-05-29T03:11 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_Performer_Alan ;
    sulo:hasParticipant ex:role_Output_Stress ;
    sulo:atTime ex:time_Eval_Stress_2023-05-29T03:11 .

ex:time_Eval_Stress_2023-05-29T03:11 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-29T03:11:00"^^xsd:dateTime .

ex:role_Performer_Alan a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Alan .

ex:role_Output_Stress a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_Stress .

ex:diag_Stress a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

ex:severity_Moderate a chr:Severity .

# Evaluation process for Victim of intimate partner abuse
ex:evaluation_VIPA_2023-05-29T03:11 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_Performer_Alan ;
    sulo:hasParticipant ex:role_Output_VIPA ;
    sulo:atTime ex:time_Eval_VIPA_2023-05-29T03:11 .

ex:time_Eval_VIPA_2023-05-29T03:11 a sulo:TimeInstant ;
    sulo:hasValue "2023-05-29T03:11:00"^^xsd:dateTime .

ex:role_Output_VIPA a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_VIPA .

ex:diag_VIPA a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

# Care plan
ex:careplan_FollowUp a chr:CarePlan ;
    sulo:refersTo ex:proc_FollowUpMonitoring .

ex:proc_FollowUpMonitoring a chr:MedicalProcedure .