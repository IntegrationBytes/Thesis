@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Hallie_Tasha_Grant a chr:Person .
ex:person_Teresa_Tapia a chr:Person .

# Care unit
ex:careunit_CaringHealthCenter a chr:CareUnit .

# Visit
ex:visit_2022_05_11_1630 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitSubject_Hallie ;
    sulo:hasParticipant ex:role_VisitProvider_Teresa ;
    sulo:atTime ex:time_visit_2022_05_11_1630 ;
    sulo:isIn ex:careunit_CaringHealthCenter .

ex:role_VisitSubject_Hallie a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie_Tasha_Grant .

ex:role_VisitProvider_Teresa a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Teresa_Tapia .

ex:time_visit_2022_05_11_1630 a sulo:TimeInstant ;
    sulo:hasValue "2022-05-11T16:30:00"^^xsd:dateTime .

# Process status (shared)
ex:status_completed a chr:ProcessStatus .

# Height measurement
ex:meas_Height a chr:Measurement ;
    sulo:hasValue "73.5"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2022_05_11_1630 .

ex:proc_Height_2022_05_11_1630 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_MeasSubject_Hallie ;
    sulo:hasParticipant ex:role_MeasOutput_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_visit_2022_05_11_1630 .

