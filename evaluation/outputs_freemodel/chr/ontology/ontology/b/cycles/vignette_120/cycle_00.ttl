# First evaluation – Medication review due (situation)
ex:evaluation_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval1_Patient ,
                       ex:role_CareProvider_Eval1_Physician ;
    sulo:hasParticipant ex:role_Output_Eval1_Diagnostic ;
    sulo:atTime ex:time_evaluation_1 .

ex:role_SubjectOfCare_Eval1_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Arlen68_Olson653 .
ex:role_CareProvider_Eval1_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Christeen33_Toy286 .
ex:role_Output_Eval1_Diagnostic a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_Medication_review .

ex:diag_Medication_review a chr:DiagnosticStatement .
ex:time_evaluation_1 a sulo:TimeInstant ;
    sulo:hasValue "2016-06-15T16:47:00"^^xsd:dateTime .

# Clinical condition linked to the diagnostic statement
ex:cond_Medication_review a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_moderate ;
    sulo:atTime ex:time_cond_Medication_review .

ex:severity_moderate a chr:Severity .
