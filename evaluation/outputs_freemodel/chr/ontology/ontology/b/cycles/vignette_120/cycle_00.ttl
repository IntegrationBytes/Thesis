    sulo:isFeatureOf ex:patient_Arlen68_Olson653 .
ex:role_CareProvider_Visit_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Christeen33_Toy286 .

ex:visit_2016-06-15_16-47 sulo:hasParticipant ex:role_SubjectOfCare_Visit_Patient ,
                                 ex:role_CareProvider_Visit_Physician .

# Process status (completed)
ex:status_completed a chr:ProcessStatus .

