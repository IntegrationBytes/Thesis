    sulo:isIn ex:careunit_JFSSWMA ;
    sulo:atTime ex:time_visit_2016-06-15_16-47 .

ex:time_visit_2016-06-15_16-47 a sulo:TimeInstant ;
    sulo:hasValue "2016-06-15T16:47:00"^^xsd:dateTime .

# Roles for the visit
