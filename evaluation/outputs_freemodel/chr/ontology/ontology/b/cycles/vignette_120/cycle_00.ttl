# Microalbumin/Creatinine, second GFR, GAD‑7, PHQ‑2, DAST‑10.
# For brevity they are omitted here but follow exactly the same structure,
# each with its own process, role, time instant, measurement, value (xsd:float),
# appropriate unit IRI (ex:unit_mg_per_dL, ex:unit_mmol_per_L, ex:unit_cm,
# ex:unit_kg, ex:unit_mL_per_min_per_1_73_m2, ex:unit_score, ex:unit_percent,
# ex:unit_bpm, ex:unit_per_min, ex:unit_kg_per_m2, ex:unit_pH, ex:unit_nominal,
# ex:unit_mg_per_g).)

