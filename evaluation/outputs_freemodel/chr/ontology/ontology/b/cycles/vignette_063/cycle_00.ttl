@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_delma a chr:Person .
ex:physician_drew a chr:Person .

# Care unit
ex:careunit_harbor a chr:CareUnit .

# Time instant (shared)
ex:time_20230323_0712 a sulo:TimeInstant ;
    sulo:hasValue "2023-03-23T07:12:00"^^xsd:dateTime .

# Clinical visit
ex:visit_20230323 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit , ex:role_Provider_Visit ;
    sulo:atTime ex:time_20230323_0712 ;
    sulo:isIn ex:careunit_harbor .

ex:role_Subject_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_delma .
ex:role_Provider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_drew .

# Units
