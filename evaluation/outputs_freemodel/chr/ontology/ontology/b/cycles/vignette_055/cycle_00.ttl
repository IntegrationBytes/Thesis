    sulo:isFeatureOf ex:person_Daren950 .

ex:role_Performer_eval1 a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Ping698 .

ex:role_Output_diag1 a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_FullTimeEmployment .

ex:diag_FullTimeEmployment a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate1 .

ex:severity_Moderate1 a chr:Severity ;
    rdfs:label "Moderate" .

ex:time_eval1 a sulo:TimeInstant ;
    sulo:hasValue "2024-10-19T10:40:00"^^xsd:dateTime .

