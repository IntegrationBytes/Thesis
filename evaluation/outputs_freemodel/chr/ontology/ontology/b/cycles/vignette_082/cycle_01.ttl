    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_meas_2253 .

ex:unit_cm a sulo:Unit .

# Measurement process – Lymph nodes (numeric result 0)
ex:proc_measure_LymphNodes a chr:MeasurementProcess ;
    sulo:atTime ex:time_meas_2253 ;
    sulo:hasParticipant ex:role_MeasProvider_Nickolas ;
    sulo:hasParticipant ex:role_MeasSubject_Estela ;
