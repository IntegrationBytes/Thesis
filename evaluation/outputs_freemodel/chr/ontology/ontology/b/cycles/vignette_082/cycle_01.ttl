# Persons
ex:person_Estela_Grant a chr:Person .
ex:person_Nickolas_Schumm a chr:Person .

# Care unit (place not further detailed)
ex:careUnit_ENCOMPASS a chr:CareUnit .

# Clinical visit
ex:visit_2008_10_18_2135 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2135 ;
    sulo:hasParticipant ex:role_VisitProvider_Nickolas .

ex:time_visit_2135 a sulo:TimeInstant ;
    sulo:hasValue "2008-10-18T21:35:00"^^xsd:dateTime .

ex:role_VisitProvider_Nickolas a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

# Measurement process – Tumor size
ex:proc_measure_TumorSize a chr:MeasurementProcess ;
    sulo:atTime ex:time_meas_2253 ;
    sulo:hasParticipant ex:role_MeasProvider_Nickolas ;
    sulo:hasParticipant ex:role_MeasSubject_Estela ;
    sulo:hasParticipant ex:role_MeasInstrument_Ruler ;
    sulo:hasParticipant ex:role_MeasOutput_TumorSize ;
