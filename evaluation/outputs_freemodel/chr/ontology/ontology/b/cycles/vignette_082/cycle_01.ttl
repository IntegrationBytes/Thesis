    sulo:isFeatureOf ex:measurement_LymphNodes .

ex:measurement_LymphNodes a chr:Measurement ;
    sulo:hasValue "0"^^xsd:float ;
    sulo:hasPart ex:unit_none ;
    sulo:atTime ex:time_meas_2253 .

