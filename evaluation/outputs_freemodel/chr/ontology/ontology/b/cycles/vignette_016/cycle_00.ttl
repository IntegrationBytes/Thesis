## (Other measurements – Body Weight, BMI, Heart rate, Respiratory rate, Glucose, Urea nitrogen, Creatinine, Calcium, Sodium, Potassium, Chloride, Carbon dioxide, Total score – are modeled analogously; omitted for brevity.)

# Process status instance
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Diagnostic statements and severity

ex:evaluation_2021_05_17_0313 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_Performer_AlanKeeling ;
    sulo:atTime ex:time_Eval_2021_05_17_0313 ;
    sulo:hasFeature ex:diagnostic_FullTimeEmployment , ex:diagnostic_SocialIsolation .

ex:time_Eval_2021_05_17_0313 a sulo:TimeInstant ;
    sulo:hasValue "2021-05-17T03:13:00"^^xsd:dateTime .

ex:diagnostic_FullTimeEmployment a chr:DiagnosticStatement ;
    rdfs:label "Full-time employment (finding)" ;
    sulo:hasFeature ex:severity_Moderate .

ex:diagnostic_SocialIsolation a chr:DiagnosticStatement ;
    rdfs:label "Social isolation (finding)" ;
    sulo:hasFeature ex:severity_Moderate .

ex:severity_Moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Care plan
ex:careplan_2021_05_17 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .