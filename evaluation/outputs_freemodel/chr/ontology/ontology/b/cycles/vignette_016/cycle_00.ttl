@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Arturo a chr:Person ;
    rdfs:label "Arturo47 Lauren941 Heidenreich818" .

# Person (physician)
ex:person_AlanKeeling a chr:Person ;
    rdfs:label "Dr. Alan320 Keeling57" .

# Clinical visit
ex:visit_2021_05_17_0234 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_CareProvider_AlanKeeling ;
    sulo:atTime ex:time_Visit_2021_05_17_0234 .

ex:role_SubjectOfCare_Arturo a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_AlanKeeling a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_AlanKeeling .

ex:time_Visit_2021_05_17_0234 a sulo:TimeInstant ;
    sulo:hasValue "2021-05-17T02:34:00"^^xsd:dateTime .

# Measurement processes and results (example for a few; others follow same pattern)

## Hemoglobin A1c
ex:proc_HbA1c_2021_05_17_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_Performer_AlanKeeling ;
    sulo:hasParticipant ex:role_Output_HbA1c ;
    sulo:atTime ex:time_HbA1c_2021_05_17_0234 ;
    sulo:hasFeature ex:status_completed .

ex:role_Performer_AlanKeeling a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_AlanKeeling .

ex:role_Output_HbA1c a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HbA1c_2021_05_17_0234 .

ex:measurement_HbA1c_2021_05_17_0234 a chr:Measurement ;
    sulo:hasValue "5.93"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/percent> ;
    sulo:atTime ex:time_HbA1c_2021_05_17_0234 .

ex:time_HbA1c_2021_05_17_0234 a sulo:TimeInstant ;
    sulo:hasValue "2021-05-17T02:34:00"^^xsd:dateTime .

## Body Height
ex:proc_Height_2021_05_17_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_Performer_AlanKeeling ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:atTime ex:time_Height_2021_05_17_0234 ;
    sulo:hasFeature ex:status_completed .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Height_2021_05_17_0234 .

ex:measurement_Height_2021_05_17_0234 a chr:Measurement ;
    sulo:hasValue "181.4"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/centimetre> ;
    sulo:atTime ex:time_Height_2021_05_17_0234 .

ex:time_Height_2021_05_17_0234 a sulo:TimeInstant ;
    sulo:hasValue "2021-05-17T02:34:00"^^xsd:dateTime .

## Pain severity
ex:proc_Pain_2021_05_17_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo ;
    sulo:hasParticipant ex:role_Performer_AlanKeeling ;
    sulo:hasParticipant ex:role_Output_Pain ;
    sulo:atTime ex:time_Pain_2021_05_17_0234 ;
    sulo:hasFeature ex:status_completed .

ex:role_Output_Pain a chr:OutputRole ;
