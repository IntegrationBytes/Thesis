@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Delma_Adriane_Huel a chr:Person .

# Care unit
ex:careUnit_HarborHealth a chr:CareUnit .

# Clinical visit
ex:visit_2019-10-17_08-12 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Patient ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Physician ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

# Roles for the visit
ex:role_SubjectOfCare_Visit_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma_Adriane_Huel .

ex:role_CareProvider_Visit_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Drew_Simonis .

# Physician person
ex:person_Drew_Simonis a chr:Person .

# Time instant for the visit
ex:time_Visit_2019-10-17T08:12:00 a sulo:TimeInstant ;
    sulo:hasValue "2019-10-17T08:12:00"^^xsd:dateTime .

# Measurement processes and results (example for a few; others follow same pattern)

# Body Height
ex:proc_bodyHeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Height_Patient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

ex:role_SubjectOfCare_Height_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma_Adriane_Huel .

ex:meas_bodyHeight a chr:Measurement ;
    sulo:hasValue "49.9"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/cm> ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

# Pain severity (numeric rating)
ex:proc_painSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Pain_Patient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

ex:role_SubjectOfCare_Pain_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma_Adriane_Huel .

ex:meas_painSeverity a chr:Measurement ;
    sulo:hasValue "4"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/score> ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

# Body Weight
ex:proc_bodyWeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Weight_Patient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

ex:role_SubjectOfCare_Weight_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma_Adriane_Huel .

ex:meas_bodyWeight a chr:Measurement ;
    sulo:hasValue "4"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/kg> ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

# Heart rate
ex:proc_heartRate a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_HR_Patient ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

ex:role_SubjectOfCare_HR_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma_Adriane_Huel .

ex:meas_heartRate a chr:Measurement ;
    sulo:hasValue "74"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/min> ;
    sulo:atTime ex:time_Visit_2019-10-17T08:12:00 .

# (Additional measurements such as Respiratory rate, Leukocytes, etc. would be added similarly,
# each with its own process, role, status, value, unit and time.)

# Evaluation process
ex:evaluation_2019-10-17_08-12 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval_Patient ;
    sulo:hasParticipant ex:role_Performer_Eval_Physician ;
    sulo:hasFeature ex:diagnostic_MedicationReview ;
    sulo:atTime ex:time_Eval_2019-10-17T08:12:00 .

ex:role_SubjectOfCare_Eval_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma_Adriane_Huel .

ex:role_Performer_Eval_Physician a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Drew_Simonis .

ex:diagnostic_MedicationReview a chr:DiagnosticStatement .

# Severity attached to the evaluation (as a feature of the diagnostic statement)
ex:severity_moderate a chr:Severity ;
    sulo:hasValue "Moderate"^^xsd:string .

ex:diagnostic_MedicationReview sulo:hasFeature ex:severity_moderate .

# Time instant for evaluation
ex:time_Eval_2019-10-17T08:12:00 a sulo:TimeInstant ;
    sulo:hasValue "2019-10-17T08:12:00"^^xsd:dateTime .

# Process status entity (shared)
ex:status_completed a chr:ProcessStatus ;
    sulo:hasValue "completed"^^xsd:string .

# Care plan
ex:carePlan_2019-10-17 a chr:CarePlan ;
    sulo:hasParticipant ex:role_SubjectOfCare_CarePlan_Patient ;
    sulo:hasParticipant ex:role_CareProvider_CarePlan_Physician ;
    sulo:refersTo ex:proc_FollowUpMonitoring .

ex:role_SubjectOfCare_CarePlan_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma_Adriane_Huel .

ex:role_CareProvider_CarePlan_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Drew_Simonis .

# Placeholder for the referenced medical procedure (follow‑up monitoring)
ex:proc_FollowUpMonitoring a chr:MedicalProcedure .

# Spatial containment of patient in care unit (optional)
ex:person_Delma_Adriane_Huel sulo:isIn ex:careUnit_HarborHealth .