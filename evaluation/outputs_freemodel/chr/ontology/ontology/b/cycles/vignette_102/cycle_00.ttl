# -----------------------------------------------------------------
# Persons
# -----------------------------------------------------------------
ex:patient_Aracely_Devon_Collins a chr:Person .
ex:physician_Edmundo_Eichmann a chr:Person .

# -----------------------------------------------------------------
# Care unit
# -----------------------------------------------------------------
ex:careunit_FATHER_BILLS_PLACE a chr:CareUnit .

# -----------------------------------------------------------------
# Clinical visit
# -----------------------------------------------------------------
ex:visit_2018_06_15_1504 a chr:ClinicalVisit ;
    sulo:isIn ex:careunit_FATHER_BILLS_PLACE ;
    sulo:atTime ex:time_visit_2018_06_15_1504 .

ex:time_visit_2018_06_15_1504 a sulo:TimeInstant ;
    sulo:hasValue "2018-06-15T15:04:00"^^xsd:dateTime .

# -----------------------------------------------------------------
# Shared role individuals for the visit (re‑used for each measurement)
# -----------------------------------------------------------------
ex:role_Subject_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Aracely_Devon_Collins .

ex:role_Performer_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Edmundo_Eichmann .

# -----------------------------------------------------------------
# Process status and severity (shared)
# -----------------------------------------------------------------
ex:status_completed a chr:ProcessStatus .
ex:severity_moderate a chr:Severity .

# -----------------------------------------------------------------
# Units
# -----------------------------------------------------------------
