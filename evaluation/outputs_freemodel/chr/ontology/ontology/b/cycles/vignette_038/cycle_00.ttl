@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Cory_Heller a chr:Person ;
    rdfs:label "Cory Frank Heller" .

# Person (attending physician)
ex:person_Margene_Schamberger a chr:Person ;
    rdfs:label "Dr. Margene Schamberger" .

# Care unit
ex:careunit_lowell a chr:CareUnit ;
    rdfs:label "THE LOWELL GENERAL HOSPITAL" .

# Roles for the clinical visit
ex:role_SubjectOfCare_visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Heller .

ex:role_CareProvider_visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Margene_Schamberger .

# Clinical visit
ex:visit_2016_10_09_1144 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_visit , ex:role_CareProvider_visit ;
    sulo:isIn ex:careunit_lowell ;
    sulo:atTime ex:time_visit_2016_10_09_1144 .

ex:time_visit_2016_10_09_1144 a sulo:TimeInstant ;
    sulo:hasValue "2016-10-09T11:44:00"^^xsd:dateTime .

# Process status (completed)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_percent a sulo:Unit ;
    rdfs:label "%" .
ex:unit_cm a sulo:Unit ;
    rdfs:label "cm" .
ex:unit_kg a sulo:Unit ;
    rdfs:label "kg" .
ex:unit_kg_per_m2 a sulo:Unit ;
    rdfs:label "kg/m2" .
ex:unit_bpm a sulo:Unit ;
    rdfs:label "/min" .
ex:unit_score a sulo:Unit ;
    rdfs:label "score" .

# ---- Measurements ----

# FEV1/FVC
ex:proc_FEV1_2016_10_09_1144 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_visit , ex:role_CareProvider_visit ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_meas_FEV1_2016_10_09_1144 .

ex:time_meas_FEV1_2016_10_09_1144 a sulo:TimeInstant ;
    sulo:hasValue "2016-10-09T11:44:00"^^xsd:dateTime .

ex:meas_FEV1 a chr:Measurement ;
    sulo:hasValue "72.195"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_meas_FEV1_2016_10_09_1144 .

