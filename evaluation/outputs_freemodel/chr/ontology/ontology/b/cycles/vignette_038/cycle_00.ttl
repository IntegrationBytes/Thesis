# ---- Evaluation processes ----

# Roles for evaluation (reuse same patient/provider roles)
ex:role_SubjectOfCare_eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Heller .

ex:role_CareProvider_eval a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Margene_Schamberger .

ex:evaluation_2016_10_09_1235 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_eval , ex:role_CareProvider_eval ;
    sulo:atTime ex:time_eval_2016_10_09_1235 ;
    sulo:hasFeature ex:diagnostic_FullTimeEmployment , ex:severity_moderate .

ex:time_eval_2016_10_09_1235 a sulo:TimeInstant ;
    sulo:hasValue "2016-10-09T12:35:00"^^xsd:dateTime .

ex:diagnostic_FullTimeEmployment a chr:DiagnosticStatement ;
    rdfs:label "Full-time employment (finding)" .

ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Second diagnostic statement (same evaluation time)
ex:evaluation_2016_10_09_1235_2 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_eval , ex:role_CareProvider_eval ;
    sulo:atTime ex:time_eval_2016_10_09_1235 ;
    sulo:hasFeature ex:diagnostic_LimitedSocialContact , ex:severity_moderate .

ex:diagnostic_LimitedSocialContact a chr:DiagnosticStatement ;
    rdfs:label "Limited social contact (finding)" .

# ---- Care Plan ----
ex:careplan_2016_10_09 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .