@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Hallie a chr:Person .
ex:person_Teresa a chr:Person .

# Care unit
ex:careunit_CARING_HEALTH_CENTER a chr:CareUnit .

# Visit
ex:time_visit_2025_05_07_16_30 a sulo:TimeInstant ;
    sulo:hasValue "2025-05-07T16:30:00"^^xsd:dateTime .

ex:role_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie .

ex:role_VisitProvider a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Teresa .

ex:visit_2025_05_07 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider ;
    sulo:atTime ex:time_visit_2025_05_07_16_30 ;
    sulo:isIn ex:careunit_CARING_HEALTH_CENTER .

# Common status
ex:status_completed a chr:ProcessStatus .

# Height measurement
ex:unit_cm a sulo:Unit .
ex:meas_height a chr:Measurement ;
    sulo:hasValue "101.0"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_visit_2025_05_07_16_30 .

ex:role_output_height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_height .

ex:proc_height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_output_height ;
    sulo:atTime ex:time_visit_2025_05_07_16_30 ;
    sulo:hasFeature ex:status_completed .

# Pain severity measurement
ex:unit_score a sulo:Unit .
ex:meas_pain a chr:Measurement ;
    sulo:hasValue "1.0"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_visit_2025_05_07_16_30 .

ex:role_output_pain a chr:OutputRole ;
