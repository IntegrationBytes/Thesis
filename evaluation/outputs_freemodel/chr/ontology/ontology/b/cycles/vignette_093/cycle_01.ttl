# Evaluation (diagnostic statement)
ex:diag_med_review a chr:DiagnosticStatement .

ex:role_output_diag a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_med_review .

ex:status_moderate a chr:ProcessStatus .

ex:eval_2025_05_07 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_VisitProvider , ex:role_output_diag ;
    sulo:atTime ex:time_visit_2025_05_07_16_30 ;
    sulo:hasFeature ex:status_moderate .

# Care plan (reference to a generic follow‑up procedure)
ex:careplan_2025_05_07 a chr:CarePlan ;
    sulo:refersTo ex:proc_followup .

ex:proc_followup a chr:MedicalProcedure .