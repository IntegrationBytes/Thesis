ex:proc_pain a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_VisitPatient , ex:role_output_pain ;
    sulo:atTime ex:time_visit_2025_05_07_16_30 ;
    sulo:hasFeature ex:status_completed .

# Weight measurement
