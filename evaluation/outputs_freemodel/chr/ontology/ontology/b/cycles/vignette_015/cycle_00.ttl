@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Arturo a chr:Person .

# Person (physician)
ex:person_Alan a chr:Person .

# Care unit
ex:unit_PRIMARY_CARE_NORTH_PC a chr:CareUnit .

# Clinical visit
ex:visit_2020_05_11_0234 a chr:ClinicalVisit ;
    sulo:isIn ex:unit_PRIMARY_CARE_NORTH_PC ;
    sulo:hasParticipant ex:role_Subject_Arturo_Visit ;
    sulo:hasParticipant ex:role_Provider_Alan_Visit ;
    sulo:atTime ex:time_2020_05_11_0234 .

# Roles for the visit
ex:role_Subject_Arturo_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Provider_Alan_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Alan .

# Time instant for the visit
ex:time_2020_05_11_0234 sulo:hasValue "2020-05-11T02:34:00"^^xsd:dateTime .

# Generic device used for measurements
ex:device_BloodAnalyzer a chr:Device .

# ---- Measurement processes and results (example subset) ----

# Hemoglobin A1c measurement process
ex:proc_HbA1c_2020_05_11_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo_HbA1c ;
    sulo:hasParticipant ex:role_Instrument_BloodAnalyzer_HbA1c ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2020_05_11_0234 .

ex:role_Subject_Arturo_HbA1c a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Instrument_BloodAnalyzer_HbA1c a chr:InstrumentRole ;
    sulo:isFeatureOf ex:device_BloodAnalyzer .

ex:measurement_HbA1c a chr:Measurement ;
    sulo:hasValue "6.23"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_2020_05_11_0234 .

# Body Height measurement process
ex:proc_Height_2020_05_11_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo_Height ;
    sulo:hasParticipant ex:role_Instrument_BloodAnalyzer_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2020_05_11_0234 .

ex:role_Subject_Arturo_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Instrument_BloodAnalyzer_Height a chr:InstrumentRole ;
    sulo:isFeatureOf ex:device_BloodAnalyzer .

ex:measurement_Height a chr:Measurement ;
    sulo:hasValue "181.4"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_2020_05_11_0234 .

# Pain severity measurement process
ex:proc_Pain_2020_05_11_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo_Pain ;
    sulo:hasParticipant ex:role_Instrument_BloodAnalyzer_Pain ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2020_05_11_0234 .

ex:role_Subject_Arturo_Pain a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Instrument_BloodAnalyzer_Pain a chr:InstrumentRole ;
    sulo:isFeatureOf ex:device_BloodAnalyzer .

ex:measurement_Pain a chr:Measurement ;
    sulo:hasValue "1"^^xsd:float ;
    sulo:hasPart ex:unit_score ;
    sulo:atTime ex:time_2020_05_11_0234 .

# (Additional measurement processes for the remaining lab values would be created analogously,
# each with its own MeasurementProcess, Subject role, Instrument role, Measurement instance,
# and sharing the same time instant ex:time_2020_05_11_0234.)

# Process status instance
ex:status_completed a chr:ProcessStatus .

# Units (place‑holders)
ex:unit_percent a sulo:Unit .
ex:unit_cm a sulo:Unit .
ex:unit_score a sulo:Unit .

# ---- Evaluation processes and diagnostic statements ----

# Evaluation at 02:34 (Medication review)
ex:evaluation_2020_05_11_0234 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo_Eval1 ;
    sulo:hasParticipant ex:role_Performer_Alan_Eval1 ;
    sulo:hasParticipant ex:role_Output_MedReview ;
    sulo:atTime ex:time_2020_05_11_0234 .

ex:role_Subject_Arturo_Eval1 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Performer_Alan_Eval1 a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Alan .

ex:role_Output_MedReview a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_MedicationReview .

ex:diag_MedicationReview a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

# Evaluation at 03:16 (Part‑time employment)
ex:evaluation_2020_05_11_0316_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo_Eval2 ;
    sulo:hasParticipant ex:role_Performer_Alan_Eval2 ;
    sulo:hasParticipant ex:role_Output_PartTimeEmployment ;
    sulo:atTime ex:time_2020_05_11_0316 .

ex:role_Subject_Arturo_Eval2 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Performer_Alan_Eval2 a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Alan .

ex:role_Output_PartTimeEmployment a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_PartTimeEmployment .

ex:diag_PartTimeEmployment a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

# Evaluation at 03:16 (Limited social contact)
ex:evaluation_2020_05_11_0316_2 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Subject_Arturo_Eval3 ;
    sulo:hasParticipant ex:role_Performer_Alan_Eval3 ;
    sulo:hasParticipant ex:role_Output_SocialContact ;
    sulo:atTime ex:time_2020_05_11_0316 .

ex:role_Subject_Arturo_Eval3 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_Performer_Alan_Eval3 a chr:PerformerRole ;
    sulo:isFeatureOf ex:person_Alan .

ex:role_Output_SocialContact a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_SocialContact .

ex:diag_SocialContact a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_moderate .

# Time instant for the 03:16 evaluations
ex:time_2020_05_11_0316 sulo:hasValue "2020-05-11T03:16:00"^^xsd:dateTime .

# Severity instance
ex:severity_moderate a chr:Severity .

# ---- Care plan ----

ex:careplan_2020_05_11 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure .