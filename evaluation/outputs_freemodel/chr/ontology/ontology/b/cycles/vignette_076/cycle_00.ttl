@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Estela_Grant a chr:Person ;
    rdfs:label "Estela596 Yetta429 Grant908" .

ex:person_Nickolas_Schumm a chr:Person ;
    rdfs:label "Dr. Nickolas58 Schumm995" .

# Clinical Visit
ex:visit_2002_02_11_20_35 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Visit_2002_02_11_20_35 ;
    sulo:hasParticipant ex:role_Provider_Visit_2002_02_11_20_35 ;
    sulo:atTime ex:time_Visit_2002_02_11_20_35 .

ex:role_Subject_Visit_2002_02_11_20_35 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_Provider_Visit_2002_02_11_20_35 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

ex:time_Visit_2002_02_11_20_35 a sulo:TimeInstant ;
    sulo:hasValue "2002-02-11T20:35:00"^^xsd:dateTime .

# Example Measurement: Hemoglobin A1c
ex:measproc_HbA1c_2002_02_11_20_35 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Meas_HbA1c_2002_02_11_20_35 ;
    sulo:hasParticipant ex:role_Output_HbA1c_2002_02_11_20_35 ;
    sulo:hasFeature ex:status_completed_HbA1c ;
    sulo:atTime ex:time_Meas_HbA1c_2002_02_11_20_35 .

ex:role_Subject_Meas_HbA1c_2002_02_11_20_35 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_Output_HbA1c_2002_02_11_20_35 a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_HbA1c_2002_02_11_20_35 .

ex:measurement_HbA1c_2002_02_11_20_35 a chr:Measurement ;
    sulo:hasValue "6.17"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;
    sulo:atTime ex:time_Meas_HbA1c_2002_02_11_20_35 .

ex:unit_percent a sulo:Unit ;
    rdfs:label "%" .

ex:status_completed_HbA1c a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:time_Meas_HbA1c_2002_02_11_20_35 a sulo:TimeInstant ;
    sulo:hasValue "2002-02-11T20:35:00"^^xsd:dateTime .

# Example Evaluation (Diagnostic Statement + Severity)
ex:evaluation_2002_02_11_21_17 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Evaluator_2002_02_11_21_17 ;
    sulo:hasParticipant ex:role_EvaluatedPatient_2002_02_11_21_17 ;
    sulo:hasParticipant ex:role_Output_Diag_FullTimeEmployment ;
    sulo:hasFeature ex:status_completed_Eval ;
    sulo:atTime ex:time_Eval_2002_02_11_21_17 .

ex:role_Evaluator_2002_02_11_21_17 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Nickolas_Schumm .

ex:role_EvaluatedPatient_2002_02_11_21_17 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Estela_Grant .

ex:role_Output_Diag_FullTimeEmployment a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_FullTimeEmployment .

ex:diag_FullTimeEmployment a chr:DiagnosticStatement ;
    rdfs:label "Full-time employment" .

ex:status_completed_Eval a chr:ProcessStatus ;
    rdfs:label "completed" .

ex:time_Eval_2002_02_11_21_17 a sulo:TimeInstant ;
    sulo:hasValue "2002-02-11T21:17:00"^^xsd:dateTime .

# Severity attached to Diagnostic Statement
ex:severity_Moderate a chr:Severity ;
    rdfs:label "Moderate" .

ex:diag_FullTimeEmployment sulo:hasFeature ex:severity_Moderate .

# Care Plan
ex:careplan_2002_02_11 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "follow‑up monitoring and routine review" .