@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Angel_Callie_Schaden a chr:Person .
ex:person_Willian_Batz a chr:Person .

# Care unit
ex:careunit_BostonMedicalCenter a chr:CareUnit .

# Clinical visit
ex:visit_2016_08_07_0624 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_VisitPatient ,
                       ex:role_CareProvider_VisitPhysician ;
    sulo:atTime ex:time_Visit .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2016-08-07T06:24:00"^^xsd:dateTime .

# Roles for visit
ex:role_SubjectOfCare_VisitPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angel_Callie_Schaden .

ex:role_CareProvider_VisitPhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Willian_Batz .

# Measurement process (temperature)
ex:measurementProcess_2016_08_07_0624 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_MeasPatient ,
                       ex:role_CareProvider_MeasPhysician ,
                       ex:role_Output_TempResult ;
    sulo:atTime ex:time_Measurement ;
    sulo:hasFeature ex:status_Completed .

ex:time_Measurement a sulo:TimeInstant ;
    sulo:hasValue "2016-08-07T06:24:00"^^xsd:dateTime .

# Roles for measurement
ex:role_SubjectOfCare_MeasPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angel_Callie_Schaden .

ex:role_CareProvider_MeasPhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Willian_Batz .

ex:role_Output_TempResult a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Temp_2016_08_07_0624 .

# Measurement value
ex:measurement_Temp_2016_08_07_0624 a chr:Measurement ;
    sulo:hasValue "37.816"^^xsd:float ;
    sulo:hasPart ex:unit_Celsius ;
    sulo:atTime ex:time_Measurement .

ex:unit_Celsius a sulo:Unit .

# Process status for measurement
ex:status_Completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Evaluation process (diagnostic)
ex:evaluation_2016_08_07_0624 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_EvalPatient ,
                       ex:role_CareProvider_EvalPhysician ,
                       ex:role_Output_DiagnosticStatement ;
    sulo:atTime ex:time_Evaluation .

ex:time_Evaluation a sulo:TimeInstant ;
    sulo:hasValue "2016-08-07T06:24:00"^^xsd:dateTime .

# Roles for evaluation
ex:role_SubjectOfCare_EvalPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angel_Callie_Schaden .

ex:role_CareProvider_EvalPhysician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Willian_Batz .

ex:role_Output_DiagnosticStatement a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_AcuteViralPharyngitis .

# Diagnostic statement
ex:diagnostic_AcuteViralPharyngitis a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

ex:severity_Moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Condition recording (as ClinicalCondition)
ex:condition_2016_08_07_0624 a chr:ClinicalCondition ;
    sulo:hasParticipant ex:role_SubjectOfCare_CondPatient ,
                       ex:role_Output_DiagnosticStatement ;
    sulo:atTime ex:time_Condition .

ex:time_Condition a sulo:TimeInstant ;
    sulo:hasValue "2016-08-07T06:24:00"^^xsd:dateTime .

ex:role_SubjectOfCare_CondPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angel_Callie_Schaden .

# Care plan
ex:careplan_2016_08_07 a chr:CarePlan ;
    sulo:hasParticipant ex:role_SubjectOfCare_CarePlanPatient ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:role_SubjectOfCare_CarePlanPatient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Angel_Callie_Schaden .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .

# Link visit to care unit
ex:visit_2016_08_07_0624 sulo:isIn ex:careunit_BostonMedicalCenter .