# Person (patient)
ex:person_Cory_Frank_Heller a chr:Person .

# Provider (physician)
ex:person_Hank_Schneider a chr:Person .

# Care unit
ex:careunit_LOWELL a chr:CareUnit .

# Clinical visit
ex:visit_2025_05_25_1144 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_visit_2025_05_25_1144 ,
                       ex:role_CareProvider_visit_2025_05_25_1144 ;
    sulo:atTime ex:time_visit_2025_05_25_1144 ;
    sulo:isIn ex:careunit_LOWELL .

ex:time_visit_2025_05_25_1144 sulo:hasValue "2025-05-25T11:44:00"^^xsd:dateTime .

# Subject role for the visit
ex:role_SubjectOfCare_visit_2025_05_25_1144 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Frank_Heller .

# Provider role for the visit
ex:role_CareProvider_visit_2025_05_25_1144 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Hank_Schneider .

