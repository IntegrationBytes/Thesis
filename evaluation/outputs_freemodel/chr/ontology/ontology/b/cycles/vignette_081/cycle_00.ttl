    sulo:hasValue "2007-05-07T03:35:00"^^xsd:dateTime .

ex:measurement_38_234 a chr:Measurement ;
    sulo:hasValue "38.234"^^xsd:float ;
    sulo:hasPart <unit-iri-of-type-sulo:Unit> ;
    sulo:atTime ex:time_measure_2007_05_07_0335 ;
