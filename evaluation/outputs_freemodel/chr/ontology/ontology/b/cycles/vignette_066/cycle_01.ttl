# Persons
ex:person_Dolores_Nevarez a chr:Person .
ex:person_Gregg_Willms a chr:Person .

# Care Unit
ex:careunit_Marlborough a chr:CareUnit .

# Clinical Visit
ex:visit_2017_07_18_05_20 a chr:ClinicalVisit ;
    sulo:atTime ex:time_visit_2017_07_18_05_20 ;
    sulo:isIn ex:careunit_Marlborough ;
    sulo:hasParticipant ex:role_Subject_Visit_Dolores ;
    sulo:hasParticipant ex:role_Provider_Visit_Willms .

ex:time_visit_2017_07_18_05_20 a sulo:TimeInstant ;
    sulo:hasValue "2017-07-18T05:20:00"^^xsd:dateTime .

# Roles for Visit
