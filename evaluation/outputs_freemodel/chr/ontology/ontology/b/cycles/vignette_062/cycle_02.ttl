ex:role_Subject_RR_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma .

ex:role_Output_RR a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_RespRate_2022_09_22 .

ex:measurement_RespRate_2022_09_22 a chr:Measurement ;
