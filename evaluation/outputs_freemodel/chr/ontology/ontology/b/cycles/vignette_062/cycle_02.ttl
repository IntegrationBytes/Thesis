ex:role_Subject_BMI_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Delma .

ex:role_Output_BMI_Ratio a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_BMI_Ratio_2022_09_22 .

ex:measurement_BMI_Ratio_2022_09_22 a chr:Measurement ;
