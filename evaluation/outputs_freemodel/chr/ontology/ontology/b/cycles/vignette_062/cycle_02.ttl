ex:measurement_Weight_2022_09_22 a chr:Measurement ;
    sulo:hasValue "14"^^xsd:float ;
    sulo:hasPart ex:unit_kg ;
    sulo:atTime ex:time_measure_2022_09_22_08_12 ;
    sulo:hasFeature ex:status_completed .

