# ------------------------------
# Evaluation process and diagnostic statement
ex:evaluation_2022_09_22_08_12 a chr:EvaluationProcess ;
    sulo:atTime ex:time_eval_2022_09_22_08_12 ;
    sulo:hasParticipant ex:role_Evaluator_Drew , 
                       ex:role_Output_Diagnostic .

ex:time_eval_2022_09_22_08_12 a sulo:TimeInstant ;
    sulo:hasValue "2022-09-22T08:12:00"^^xsd:dateTime .

ex:role_Evaluator_Drew a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Drew .

ex:role_Output_Diagnostic a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_MedicationReview .

ex:diagnostic_MedicationReview a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

ex:severity_Moderate a chr:Severity ;
    sulo:hasValue "Moderate"^^xsd:string .

# ------------------------------
# Care plan
ex:careplan_2022_09_22 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure .