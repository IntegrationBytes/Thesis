    sulo:atTime ex:time_Visit_2023_11_14_0420 .

ex:time_Visit_2023_11_14_0420 a sulo:TimeInstant ;
    sulo:hasValue "2023-11-14T04:20:00"^^xsd:dateTime .

# Measurement processes and results (height)
