@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Harvey a chr:Person ;
    rdfs:label "Harvey63 Napoleon578 Homenick806" .

ex:physician_Victor a chr:Person ;
    rdfs:label "Dr. Víctor493 Chávez927" .

# Device
ex:thermometer_1 a chr:Device ;
    rdfs:label "Thermometer" .

# Unit
ex:unit_celsius a sulo:Unit ;
    rdfs:label "Celsius" .

# Measurement
ex:measurement_temp_1 a chr:Measurement ;
    sulo:hasValue "37.063"^^xsd:float ;
    sulo:atTime ex:time_measurement_1 ;
    sulo:hasParticipant ex:role_Unit_Measure .

ex:time_measurement_1 a sulo:TimeInstant ;
    sulo:hasValue "2019-07-08T15:30:00"^^xsd:dateTime .

# Measurement Process
ex:proc_measure_temp_1 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Measure ;
    sulo:hasParticipant ex:role_Performer_Measure ;
    sulo:hasParticipant ex:role_Instrument_Measure ;
    sulo:hasParticipant ex:role_Output_Measure ;
    sulo:hasParticipant ex:role_Unit_Measure ;
    sulo:atTime ex:time_measurement_1 ;
    sulo:hasFeature ex:status_completed .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Roles for measurement
ex:role_SubjectOfCare_Measure a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_Performer_Measure a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Victor .

ex:role_Instrument_Measure a chr:InstrumentRole ;
    sulo:isFeatureOf ex:thermometer_1 .

ex:role_Output_Measure a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_temp_1 .

ex:role_Unit_Measure a chr:UnitRole ;
    sulo:isFeatureOf ex:unit_celsius .

# Clinical Visit
ex:visit_2019_07_08_15_30 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_visit .

ex:time_visit a sulo:TimeInstant ;
    sulo:hasValue "2019-07-08T15:30:00"^^xsd:dateTime .

# Roles for visit
ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Victor .

# Evaluation Process
ex:evaluation_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval ;
    sulo:hasParticipant ex:role_Performer_Eval ;
    sulo:hasParticipant ex:role_Output_Eval ;
    sulo:atTime ex:time_evaluation ;
    sulo:hasFeature ex:status_completed .

ex:time_evaluation a sulo:TimeInstant ;
    sulo:hasValue "2019-07-08T15:30:00"^^xsd:dateTime .

# Roles for evaluation
ex:role_SubjectOfCare_Eval a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Harvey .

ex:role_Performer_Eval a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Victor .

ex:role_Output_Eval a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_acute_pharyngitis .

# Diagnostic Statement
ex:diagnostic_acute_pharyngitis a chr:DiagnosticStatement ;
    rdfs:label "Acute viral pharyngitis" .

# Clinical Condition
ex:condition_acute_pharyngitis a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_moderate ;
    sulo:atTime ex:time_condition .

ex:time_condition a sulo:TimeInstant ;
    sulo:hasValue "2019-07-08T15:30:00"^^xsd:dateTime .

ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Care Plan
ex:careplan_1 a chr:CarePlan ;
    sulo:refersTo ex:procedure_followup .

ex:procedure_followup a chr:MedicalProcedure ;
    rdfs:label "Follow‑up monitoring and routine review" .