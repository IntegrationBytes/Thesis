# Person (patient)
ex:person_Cory_Frank_Heller a chr:Person ;
    rdfs:label "Cory Frank Heller" .

# Care unit
ex:careUnit_LOWELL a chr:CareUnit ;
    rdfs:label "LOWELL FAMILY MEDICAL CARE PC" .

# Attending physician
ex:person_Hank_Schneider a chr:Person ;
    rdfs:label "Dr. Hank Schneider" .

# Clinical visit
ex:visit_2022_05_08_1144 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Cory ;
    sulo:hasParticipant ex:role_CareProvider_Hank ;
    sulo:isIn ex:careUnit_LOWELL ;
    sulo:atTime ex:time_visit_2022_05_08_1144 .

# Roles for visit
ex:role_SubjectOfCare_Cory a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Frank_Heller .

ex:role_CareProvider_Hank a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Hank_Schneider .

# Time instant for visit
ex:time_visit_2022_05_08_1144 a sulo:TimeInstant ;
    sulo:hasValue "2022-05-08T11:44:00"^^xsd:dateTime .

# Measurement processes and results (each measurement is a MeasurementProcess with a Measurement output)

