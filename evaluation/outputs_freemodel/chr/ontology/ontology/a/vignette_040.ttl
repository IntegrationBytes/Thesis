@prefix chr: <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex: <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Clinical visit
ex:visit_2017_04_11 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Patient ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Physician ;
    sulo:atTime ex:time_Visit .

ex:role_SubjectOfCare_Visit_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Frank_Heller .

ex:person_Cory_Frank_Heller a chr:Person ;
    rdfs:label "Cory323 Frank378 Heller342" .

ex:role_CareProvider_Visit_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Margene_Schamberger .

ex:person_Margene_Schamberger a chr:Person ;
    rdfs:label "Dr. Margene509 Schamberger479" .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T14:32:00"^^xsd:dateTime .

# Polyp measurement process
ex:polyp_measurement_process a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_PolypMeasurement ;
    sulo:hasParticipant ex:role_Output_PolypMeasurement ;
    sulo:atTime ex:time_PolypMeasurement ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_PolypMeasurement a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Frank_Heller .

ex:role_Output_PolypMeasurement a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Polyp .

ex:measurement_Polyp a chr:Measurement ;
    sulo:hasValue "11.962"^^xsd:float ;
    sulo:hasPart ex:unit_mm ;
    sulo:atTime ex:time_PolypMeasurement .

ex:unit_mm a sulo:Unit ;
    rdfs:label "mm" .

ex:time_PolypMeasurement a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T15:00:00"^^xsd:dateTime .

ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Hemoglobin measurement process
ex:hgb_measurement_process a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_HgbMeasurement ;
    sulo:hasParticipant ex:role_Output_HgbMeasurement ;
    sulo:atTime ex:time_HgbMeasurement ;
    sulo:hasFeature ex:status_completed .

ex:role_SubjectOfCare_HgbMeasurement a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Frank_Heller .

ex:role_Output_HgbMeasurement a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Hgb .

ex:measurement_Hgb a chr:Measurement ;
    sulo:hasValue "242.07"^^xsd:float ;
    sulo:hasPart ex:unit_ng_per_mL ;
    sulo:atTime ex:time_HgbMeasurement .

ex:unit_ng_per_mL a sulo:Unit ;
    rdfs:label "ng/mL" .

ex:time_HgbMeasurement a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T15:00:00"^^xsd:dateTime .

# Evaluation process producing diagnostic statement
ex:evaluation_process a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_CareProvider_Evaluation ;
    sulo:hasParticipant ex:role_SubjectOfCare_Evaluation ;
    sulo:hasParticipant ex:role_Output_Evaluation ;
    sulo:atTime ex:time_Evaluation ;
    sulo:hasFeature ex:status_completed .

ex:role_CareProvider_Evaluation a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Margene_Schamberger .

ex:role_SubjectOfCare_Evaluation a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Cory_Frank_Heller .

ex:role_Output_Evaluation a chr:OutputRole ;
    sulo:isFeatureOf ex:diagnostic_PolypColon .

ex:diagnostic_PolypColon a chr:DiagnosticStatement ;
    rdfs:label "Polyp of colon (disorder)" ;
    sulo:hasFeature ex:severity_moderate .

ex:severity_moderate a chr:Severity ;
    rdfs:label "Moderate" .

ex:time_Evaluation a sulo:TimeInstant ;
    sulo:hasValue "2017-04-11T15:00:00"^^xsd:dateTime .

# Care plan referencing a (placeholder) medical procedure
ex:care_plan_1 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUpMonitoring .

ex:procedure_FollowUpMonitoring a chr:MedicalProcedure ;
    rdfs:label "follow-up monitoring and routine review" .