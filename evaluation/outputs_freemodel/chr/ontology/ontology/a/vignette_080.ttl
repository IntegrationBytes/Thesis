    sulo:hasParticipant ex:role_SubjectOfCare_Visit_Estela ;
    sulo:hasParticipant ex:role_CareProvider_Visit_Ivonne ;
    sulo:isIn ex:careunit_ZION ;
    sulo:atTime ex:time_visit_2007_01_01_2035 .

