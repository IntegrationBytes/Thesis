# Evaluation process
ex:eval_2024_05_08_1630 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Provider_Teresa ;
    sulo:hasParticipant ex:role_Subject_Hallie ;
    sulo:hasParticipant ex:role_Output_Diagnostic ;
    sulo:atTime ex:time_2024_05_08_1630 .

