@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:person_Hallie_Tasha_Grant a chr:Person .
ex:person_Teresa_Tapia a chr:Person .

# Roles for the visit
ex:role_Subject_Hallie a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie_Tasha_Grant .

ex:role_Provider_Teresa a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Teresa_Tapia .

# Clinical visit
ex:visit_2024_05_08_1630 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Hallie ;
    sulo:hasParticipant ex:role_Provider_Teresa ;
    sulo:atTime ex:time_2024_05_08_1630 .

# Time instant used throughout
ex:time_2024_05_08_1630 a sulo:TimeInstant ;
    sulo:hasValue "2024-05-08T16:30:00"^^xsd:dateTime .

# Units
ex:unit_cm a sulo:Unit .
ex:unit_kg a sulo:Unit .
ex:unit_percent a sulo:Unit .
ex:unit_kg_per_m2 a sulo:Unit .
ex:unit_per_min a sulo:Unit .

# ------------------------------
# Measurement: Body Height
ex:proc_Height a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Hallie ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:atTime ex:time_2024_05_08_1630 .

ex:meas_Height a chr:Measurement ;
    sulo:hasValue "94.1"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_2024_05_08_1630 .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_Height .

# Measurement: Pain severity (0‑10)
ex:proc_PainSeverity a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_Subject_Hallie ;
    sulo:hasParticipant ex:role_Output_PainSeverity ;
    sulo:atTime ex:time_2024_05_08_1630 .

ex:meas_PainSeverity a chr:Measurement ;
    sulo:hasValue "4"^^xsd:float ;
    sulo:hasPart ex:unit_percent ;   # using percent as placeholder for score unit
    sulo:atTime ex:time_2024_05_08_1630 .

ex:role_Output_PainSeverity a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_PainSeverity .

