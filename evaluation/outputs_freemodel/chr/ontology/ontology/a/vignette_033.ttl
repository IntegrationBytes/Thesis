@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Casey401_Elijah719_Parker433 a chr:Person .
ex:physician_Jacque_Streich a chr:Person .

# Care unit
ex:careUnit_Acclaim a chr:CareUnit .

# Clinical visit
ex:visit_2022_07_21_19_21 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_Visit ;
    sulo:isIn ex:careUnit_Acclaim .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Casey401_Elijah719_Parker433 .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Jacque_Streich .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2022-07-21T19:21:00"^^xsd:dateTime .

# DXA measurement process
ex:measurementProcess_2022_07_21_20_00 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Measurement ;
    sulo:hasParticipant ex:role_Instrument_Measurement ;
    sulo:hasParticipant ex:role_Output_Measurement ;
    sulo:atTime ex:time_Measurement .

ex:role_SubjectOfCare_Measurement a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Casey401_Elijah719_Parker433 .

ex:device_DXA a chr:Device .

ex:role_Instrument_Measurement a chr:InstrumentRole ;
    sulo:isFeatureOf ex:device_DXA .

ex:role_Output_Measurement a chr:OutputRole ;
    sulo:isFeatureOf ex:measurement_Tscore .

ex:measurement_Tscore a chr:Measurement ;
    sulo:hasValue "0.086642"^^xsd:float ;
    sulo:hasPart <unit-iri-of-type-sulo:Unit> ;
    sulo:atTime ex:time_Measurement .

ex:time_Measurement a sulo:TimeInstant ;
    sulo:hasValue "2022-07-21T20:00:00"^^xsd:dateTime .

# First evaluation – Fracture of bone
ex:evaluation_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval1 ;
    sulo:hasParticipant ex:role_Performer_Eval1 ;
    sulo:hasParticipant ex:role_Output_Diag1 ;
    sulo:atTime ex:time_Eval .

ex:role_SubjectOfCare_Eval1 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Casey401_Elijah719_Parker433 .

ex:role_Performer_Eval1 a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Jacque_Streich .

ex:role_Output_Diag1 a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_FractureBone .

ex:diag_FractureBone a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

# Second evaluation – Fracture subluxation of wrist
ex:evaluation_2 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Eval2 ;
    sulo:hasParticipant ex:role_Performer_Eval2 ;
    sulo:hasParticipant ex:role_Output_Diag2 ;
    sulo:atTime ex:time_Eval .

ex:role_SubjectOfCare_Eval2 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Casey401_Elijah719_Parker433 .

ex:role_Performer_Eval2 a chr:PerformerRole ;
    sulo:isFeatureOf ex:physician_Jacque_Streich .

ex:role_Output_Diag2 a chr:OutputRole ;
    sulo:isFeatureOf ex:diag_FractureWrist .

ex:diag_FractureWrist a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

# Shared time for evaluations
ex:time_Eval a sulo:TimeInstant ;
    sulo:hasValue "2022-07-21T19:21:00"^^xsd:dateTime .

# Severity
ex:severity_Moderate a chr:Severity .

# Care plan and referenced procedure
ex:carePlan_1 a chr:CarePlan ;
    sulo:refersTo ex:procedure_FollowUp .

ex:procedure_FollowUp a chr:MedicalProcedure .