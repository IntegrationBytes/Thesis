@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Arturo a chr:Person .

# Person (provider)
ex:person_Alan a chr:Person .

# Clinical visit
ex:visit_2024_06_03_0234 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_Visit ,
                       ex:role_CareProvider_Alan_Visit ;
    sulo:atTime ex:time_2024_06_03_0234 .

ex:role_SubjectOfCare_Arturo_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_Alan_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Alan .

ex:time_2024_06_03_0234 a sulo:TimeInstant ;
    sulo:hasValue "2024-06-03T02:34:00"^^xsd:dateTime .

# Measurement processes and results (example for a few; similar pattern for all)

## Hemoglobin A1c
ex:proc_HbA1c_2024_06_03_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_HbA1c ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2024_06_03_0234 .

ex:role_SubjectOfCare_Arturo_HbA1c a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:meas_HbA1c_2024_06_03_0234 a chr:Measurement ;
    sulo:hasValue "5.99"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/percent> ;
    sulo:atTime ex:time_2024_06_03_0234 .

## Body Height
ex:proc_Height_2024_06_03_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_Height ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2024_06_03_0234 .

ex:role_SubjectOfCare_Arturo_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:meas_Height_2024_06_03_0234 a chr:Measurement ;
    sulo:hasValue "181.4"^^xsd:float ;
