## Body Weight
ex:proc_Weight_2024_06_03_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_Weight ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2024_06_03_0234 .

ex:role_SubjectOfCare_Arturo_Weight a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:meas_Weight_2024_06_03_0234 a chr:Measurement ;
