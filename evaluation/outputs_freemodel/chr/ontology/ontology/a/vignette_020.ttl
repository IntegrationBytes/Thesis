    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_Alan_Eval2 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Alan .

ex:diag_Violence_Finding a chr:DiagnosticStatement ;
    sulo:hasFeature ex:cond_Violence_Finding .

ex:cond_Violence_Finding a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_Moderate .

## Gingivitis (disorder)
ex:eval_2024_06_03_0424 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_Eval3 ,
                       ex:role_CareProvider_Alan_Eval3 ;
    sulo:hasFeature ex:diag_Gingivitis_Disorder ;
    sulo:atTime ex:time_2024_06_03_0424 .

ex:role_SubjectOfCare_Arturo_Eval3 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_Alan_Eval3 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Alan .

ex:diag_Gingivitis_Disorder a chr:DiagnosticStatement ;
    sulo:hasFeature ex:cond_Gingivitis_Disorder .

ex:cond_Gingivitis_Disorder a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_Moderate .

# Time instants for evaluations
ex:time_2024_06_03_0328 a sulo:TimeInstant ;
    sulo:hasValue "2024-06-03T03:28:00"^^xsd:dateTime .

ex:time_2024_06_03_0424 a sulo:TimeInstant ;
    sulo:hasValue "2024-06-03T04:24:00"^^xsd:dateTime .

# Care plan
ex:careplan_2024_06_03 a chr:CarePlan ;
    sulo:refersTo ex:proc_FollowUpMonitoring .

ex:proc_FollowUpMonitoring a chr:MedicalProcedure .