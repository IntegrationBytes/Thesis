## (Other measurements follow the same pattern; omitted for brevity)

# Process status (shared)
ex:status_completed a chr:ProcessStatus .

# Evaluation processes and diagnostic statements

## Medication review (situation)
ex:eval_2024_06_03_0234 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_Eval1 ,
                       ex:role_CareProvider_Alan_Eval1 ;
    sulo:hasFeature ex:diag_MedReview_Situation ;
    sulo:atTime ex:time_2024_06_03_0234 .

ex:role_SubjectOfCare_Arturo_Eval1 a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:role_CareProvider_Alan_Eval1 a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Alan .

ex:diag_MedReview_Situation a chr:DiagnosticStatement ;
    sulo:hasFeature ex:cond_MedReview_Situation .

ex:cond_MedReview_Situation a chr:ClinicalCondition ;
    sulo:hasFeature ex:severity_Moderate .

ex:severity_Moderate a chr:Severity .

## Reports of violence (finding)
ex:eval_2024_06_03_0328 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_Eval2 ,
                       ex:role_CareProvider_Alan_Eval2 ;
    sulo:hasFeature ex:diag_Violence_Finding ;
    sulo:atTime ex:time_2024_06_03_0328 .

