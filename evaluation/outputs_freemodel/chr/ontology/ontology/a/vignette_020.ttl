## Pain severity
ex:proc_Pain_2024_06_03_0234 a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Arturo_Pain ;
    sulo:hasFeature ex:status_completed ;
    sulo:atTime ex:time_2024_06_03_0234 .

ex:role_SubjectOfCare_Arturo_Pain a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo .

ex:meas_Pain_2024_06_03_0234 a chr:Measurement ;
