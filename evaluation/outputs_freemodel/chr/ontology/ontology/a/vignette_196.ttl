@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Persons
ex:patient_Grimes a chr:Person ;
    rdfs:label "Bryant814 Clarence5 Grimes165" .

ex:physician_Wilkinson a chr:Person ;
    rdfs:label "Dr. Dana512 Wilkinson796" .

# Care unit
ex:careunit_UrgentCare a chr:CareUnit ;
    rdfs:label "URGENT CARE PHYSICIANS PC" .

# Time instant (shared)
ex:time_2014_03_26_1547 a sulo:TimeInstant ;
    sulo:hasValue "2014-03-26T15:47:00"^^xsd:dateTime .

# Roles
ex:role_SubjectOfCare_Grimes a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:patient_Grimes .

ex:role_CareProvider_Wilkinson a chr:CareProviderRole ;
    sulo:isFeatureOf ex:physician_Wilkinson .

# Clinical visit
ex:visit_2014_03_26_1547 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Grimes ,
                       ex:role_CareProvider_Wilkinson ;
    sulo:atTime ex:time_2014_03_26_1547 ;
    sulo:isIn ex:careunit_UrgentCare .

# Process status (completed)
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Units
ex:unit_mg_per_dL a sulo:Unit ;
    rdfs:label "mg/dL" .

ex:unit_mmol_per_L a sulo:Unit ;
    rdfs:label "mmol/L" .

ex:unit_mL_per_min_per_1_73_m2 a sulo:Unit ;
    rdfs:label "mL/min/1.73 m²" .

ex:unit_nominal a sulo:Unit ;
    rdfs:label "nominal" .

ex:unit_pH a sulo:Unit ;
    rdfs:label "pH" .

ex:unit_percent a sulo:Unit ;
    rdfs:label "%" .

