# Person (patient)
ex:person_Hallie_Tasha_Grant a chr:Person .

# Person (provider)
ex:person_Teresa_Tapia a chr:Person .

# Care unit
ex:unit_CaringHealthCenter a chr:CareUnit .

# Clinical visit
ex:visit_2022_08_10_1630 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_SubjectOfCare_Visit ;
    sulo:hasParticipant ex:role_CareProvider_Visit ;
    sulo:atTime ex:time_Visit ;
    sulo:isIn ex:unit_CaringHealthCenter .

ex:role_SubjectOfCare_Visit a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie_Tasha_Grant .

ex:role_CareProvider_Visit a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Teresa_Tapia .

ex:time_Visit a sulo:TimeInstant ;
    sulo:hasValue "2022-08-10T16:30:00"^^xsd:dateTime .

# Measurement: Body Height
ex:proc_BodyHeight a chr:MeasurementProcess ;
    sulo:hasParticipant ex:role_SubjectOfCare_Height ;
    sulo:hasParticipant ex:role_Output_Height ;
    sulo:hasFeature ex:status_Completed ;
    sulo:atTime ex:time_Visit .

ex:role_SubjectOfCare_Height a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Hallie_Tasha_Grant .

ex:role_Output_Height a chr:OutputRole ;
    sulo:isFeatureOf ex:meas_BodyHeight .

ex:meas_BodyHeight a chr:Measurement ;
    sulo:hasValue "77.1"^^xsd:float ;
    sulo:hasPart ex:unit_cm ;
    sulo:atTime ex:time_Visit .

