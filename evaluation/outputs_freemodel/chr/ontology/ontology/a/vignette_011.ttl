@prefix chr:  <https://w3id.org/shexmap/resource/ontology-schema/d285f599-dc2e-4bd0-83f3-df21defa8821/> .
@prefix ex:   <http://example.org/clinical/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Person (patient)
ex:person_Arturo47_Lauren941_Heidenreich818 a chr:Person .

# Person (physician)
ex:person_Dr_Alan320_Keeling57 a chr:Person .

# Roles for the clinical visit
ex:role_Subject_Patient a chr:SubjectOfCareRole ;
    sulo:isFeatureOf ex:person_Arturo47_Lauren941_Heidenreich818 .

ex:role_Provider_Physician a chr:CareProviderRole ;
    sulo:isFeatureOf ex:person_Dr_Alan320_Keeling57 .

# Time instant for the main visit (shared by many processes)
ex:time_visit_2017_04_24_02_34 a sulo:TimeInstant ;
    sulo:hasValue "2017-04-24T02:34:00"^^xsd:dateTime .

# Clinical visit
ex:visit_2017_04_24_02_34 a chr:ClinicalVisit ;
    sulo:hasParticipant ex:role_Subject_Patient ;
    sulo:hasParticipant ex:role_Provider_Physician ;
    sulo:atTime ex:time_visit_2017_04_24_02_34 .

# Process status (completed) – reused
ex:status_completed a chr:ProcessStatus ;
    rdfs:label "completed" .

# Helper function to create measurement individuals
# (each measurement is a chr:Measurement with value, unit, time, and status)

# Hemoglobin A1c
