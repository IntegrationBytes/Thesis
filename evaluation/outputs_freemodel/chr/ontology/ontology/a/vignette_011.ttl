    sulo:hasValue "5.89"^^xsd:float ;
    sulo:hasPart <https://w3id.org/sulo/unit/percent> ;
    sulo:atTime ex:time_visit_2017_04_24_02_34 ;
    sulo:hasFeature ex:status_completed .

