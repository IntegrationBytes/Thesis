# Evaluation processes (diagnostic statements)

# Time instant for evaluations at 02:34
ex:time_eval_2017_04_24_02_34 a sulo:TimeInstant ;
    sulo:hasValue "2017-04-24T02:34:00"^^xsd:dateTime .

# Time instant for evaluations at 03:07
ex:time_eval_2017_04_24_03_07 a sulo:TimeInstant ;
    sulo:hasValue "2017-04-24T03:07:00"^^xsd:dateTime .

# Severity moderate (reused)
ex:severity_Moderate a chr:Severity ;
    rdfs:label "Moderate" .

# Diagnostic statement: Medication review due
ex:diag_MedicationReview a chr:DiagnosticStatement ;
    sulo:hasFeature ex:severity_Moderate .

ex:evaluation_1 a chr:EvaluationProcess ;
    sulo:hasParticipant ex:role_Provider_Physician ;
    sulo:hasParticipant ex:role_Subject_Patient ;
    sulo:atTime ex:time_eval_2017_04_24_02_34 ;
    sulo:hasFeature ex:diag_MedicationReview .

# Diagnostic statement: Full-time employment
ex:diag_FullTimeEmployment a chr:DiagnosticStatement ;
