digraph CHR_Schema {
  bgcolor="#0E1B30";
  rankdir=LR;
  node [fontname="Helvetica", fontsize=22, shape=box, style="rounded,filled", fontcolor=white, color="#3B5998"];
  edge [fontname="Helvetica", fontsize=20, color="#9C7BD0", fontcolor="#C9B8E8", arrowsize=1.0, penwidth=1.5];
  graph [splines=true, overlap=false, nodesep=0.4, ranksep=1.5];
  "AnatomicalStructure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>AnatomicalStructure</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "CarePlan" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>CarePlan</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "CareProviderRole" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>CareProviderRole</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E4A93B"];
  "CareUnit" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>CareUnit</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "ClinicalCondition" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD COLSPAN="2"><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>ClinicalCondition</B></FONT></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#FFFFFF">+ hasConditionEndDate</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="17" COLOR="#A8B8D8">dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#FFFFFF">+ hasRecordDate</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="17" COLOR="#A8B8D8">dateTime</FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "ClinicalVisit" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>ClinicalVisit</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>Device</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "DiagnosticStatement" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>DiagnosticStatement</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "EvaluationProcess" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>EvaluationProcess</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "InstrumentRole" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>InstrumentRole</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E4A93B"];
  "Measurement" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD COLSPAN="2"><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>Measurement</B></FONT></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#FFFFFF">+ hasMeasuredDate</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="17" COLOR="#A8B8D8">dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#FFFFFF">+ hasQuantityValue</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="17" COLOR="#A8B8D8">float</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#FFFFFF">+ hasUnit</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="17" COLOR="#A8B8D8">Unit</FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "MeasurementProcess" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>MeasurementProcess</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "MedicalProcedure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD COLSPAN="2"><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>MedicalProcedure</B></FONT></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#FFFFFF">+ hasPerformedDate</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="17" COLOR="#A8B8D8">dateTime</FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "MedicationAdministration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>MedicationAdministration</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "Occupation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>Occupation</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "OutputRole" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>OutputRole</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E4A93B"];
  "PerformerRole" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>PerformerRole</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E4A93B"];
  "Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>Person</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "PharmaceuticalDose" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>PharmaceuticalDose</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E48BB1"];
  "PharmaceuticalDoseForm" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>PharmaceuticalDoseForm</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E48BB1"];
  "PharmaceuticalProduct" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>PharmaceuticalProduct</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "ProcessStatus" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>ProcessStatus</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E48BB1"];
  "Severity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>Severity</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E48BB1"];
  "SubjectOfCareRole" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>SubjectOfCareRole</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#E4A93B"];
  "TreatmentPlan" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT POINT-SIZE="28" COLOR="#FFFFFF"><B>TreatmentPlan</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="17" COLOR="#C9B8E8"><I>«chr:Class»</I></FONT></TD></TR></TABLE>>, fillcolor="#3B5998"];
  "ClinicalVisit" -> "Person" [label="hasCareProvider"];
  "ClinicalVisit" -> "CareUnit" [label="hasCareUnit"];
  "MeasurementProcess" -> "Device" [label="hasDevice"];
  "PharmaceuticalProduct" -> "PharmaceuticalDoseForm" [label="hasDoseForm"];
  "PharmaceuticalProduct" -> "PharmaceuticalDose" [label="hasDoseQuantity"];
  "ClinicalCondition" -> "AnatomicalStructure" [label="hasLocatedIn"];
  "CarePlan" -> "MedicalProcedure" [label="hasMedicalProcedure"];
  "EvaluationProcess" -> "DiagnosticStatement" [label="hasObservation"];
  "ClinicalVisit" -> "Person" [label="hasPatient"];
  "MedicalProcedure" -> "Person" [label="hasPatient"];
  "MedicalProcedure" -> "Person" [label="hasPerformer"];
  "MedicationAdministration" -> "PharmaceuticalProduct" [label="hasPharmaceuticalProduct"];
  "MeasurementProcess" -> "Measurement" [label="hasResult"];
  "ClinicalCondition" -> "Severity" [label="hasSeverity"];
  "MedicalProcedure" -> "ProcessStatus" [label="hasStatus"];
}