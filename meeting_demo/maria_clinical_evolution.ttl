@prefix : <http://example.org/maria#> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:maria a sulo:Object .
:primaryFinding a sulo:Process ;
    sulo:atTime :time_Diagnosis ;
    sulo:hasParticipant :maria ;
    sulo:isIn :site_RightBreast .
:initialBiopsy a sulo:Process ;
    sulo:hasPart :primaryFinding .
:time_Diagnosis a sulo:TimeInstant ;
    sulo:hasValue "9999-01-01"^^xsd:date .
:site_RightBreast a sulo:SpatialObject .
:tumorGrade a sulo:Quality ;
    sulo:hasValue "Grade 2"^^xsd:string .
:hormoneReceptorStatus a sulo:Quality ;
    sulo:hasValue "ER+, PR+, HER2−"^^xsd:string .
:cancerCondition a sulo:Process ;
    sulo:hasParticipant :maria .
:imagingReport1 a sulo:InformationObject ;
    sulo:refersTo :primaryFinding .
:localizedDisease a sulo:Process ;
    sulo:atTime :time_LocalizedAssessment ;
    sulo:hasParticipant :maria .
:time_LocalizedAssessment a sulo:TimeInstant ;
    sulo:hasValue "9999-01-01"^^xsd:date .
:tumorBoard a sulo:Process ;
    sulo:hasParticipant :maria .
:treatmentPlan1 a sulo:Process ;
    sulo:hasPart :proc_Lumpectomy ;
    sulo:hasPart :proc_Radiotherapy ;
    sulo:hasPart :proc_EndocrineTherapy .
:proc_Lumpectomy a sulo:Process ;
    sulo:hasParticipant :maria .
:proc_Radiotherapy a sulo:Process ;
    sulo:hasParticipant :maria .
:proc_EndocrineTherapy a sulo:Process ;
    sulo:hasParticipant :maria .
:pathologyReport1 a sulo:InformationObject ;
    sulo:refersTo :cancerCondition .
:treatmentResponse1 a sulo:Process ;
    sulo:atTime :time_ResponseAssessment .
:time_ResponseAssessment a sulo:TimeInstant ;
    sulo:hasValue "9999-01-01"^^xsd:date .
:metastaticBreastCancer a sulo:Process ;
    sulo:hasPart :primaryFinding ;
    sulo:atTime :time_MetastasisDiagnosis ;
    sulo:hasParticipant :maria ;
    sulo:isIn :site_Liver .
:time_MetastasisDiagnosis a sulo:TimeInstant ;
    sulo:hasValue "9999-01-01"^^xsd:date .
:site_Liver a sulo:SpatialObject .